<h1 class="text-3xl font-bold text-white mb-8">Dashboard</h1>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-6">
    <p class="text-gray-400 text-sm font-medium uppercase tracking-wide">Total Position Value</p>
    <p class="text-3xl font-bold text-white mt-2"><%= format_usd(@total_value) %></p>
  </div>
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-6">
    <p class="text-gray-400 text-sm font-medium uppercase tracking-wide">Active Positions</p>
    <p class="text-3xl font-bold text-white mt-2"><%= @positions.size %></p>
  </div>
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-6">
    <p class="text-gray-400 text-sm font-medium uppercase tracking-wide">Active Hedges</p>
    <p class="text-3xl font-bold text-white mt-2"><%= @active_hedges %></p>
  </div>
</div>

<% if @positions.any? %>
  <section class="mb-8">
    <h2 class="text-xl font-semibold text-white mb-4">Active production position</h2>
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
      <% @positions.each do |position| %>
        <% valuation = PositionValuation.current(position) %>
        <% dashboard_snapshot = position.position_dashboard_snapshot %>
        <% hedge_venue = HedgeVenues.normalize(position.hedge&.execution_venue) %>
        <% health = if dashboard_snapshot&.inside_tolerance == true
          "In tolerance"
        elsif dashboard_snapshot&.inside_tolerance == false
          "Out of tolerance"
        elsif dashboard_snapshot
          "Snapshot #{dashboard_snapshot.refresh_status}"
        else
          "Not refreshed"
        end %>
        <% next_action = dashboard_snapshot&.planned_auto_action.presence || (dashboard_snapshot&.inside_tolerance == true ? "no-op" : "refresh preview") %>
        <article class="rounded-xl border border-green-800 bg-green-950/20 p-5 shadow-lg shadow-black/10">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <p class="text-xs uppercase tracking-wide text-green-300">Current production</p>
              <h3 class="mt-1 text-lg font-semibold text-white"><%= operator_position_label(position) %></h3>
              <p class="mt-1 text-sm text-gray-400"><%= position_source_detail(position) %></p>
            </div>
            <span class="rounded-full border border-green-700 bg-green-950 px-3 py-1 text-xs font-semibold text-green-200">Active</span>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-3 text-sm md:grid-cols-4">
            <div><p class="text-xs text-gray-500">Value</p><p class="text-white"><%= valuation_value_display(valuation.current_value_usd) %></p></div>
            <div><p class="text-xs text-gray-500">Venue</p><p class="text-white"><%= hedge_venue_status_label(position) %></p></div>
            <div><p class="text-xs text-gray-500">Health</p><p class="text-white"><%= health %></p></div>
            <div><p class="text-xs text-gray-500">Next action</p><p class="text-white"><%= next_action.to_s.humanize %></p></div>
          </div>
          <div class="mt-4">
            <%= link_to "Manage hedge", position_path(position, hedge_venue: hedge_venue, tab: "hedge"), class: "inline-flex rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500" %>
          </div>
        </article>
      <% end %>
    </div>
  </section>
<% end %>

<% if @inactive_positions_exist %>
  <details class="mb-8 rounded-xl border border-gray-800 bg-gray-900/80 p-5">
    <summary class="cursor-pointer text-lg font-semibold text-white">Inactive / historical positions</summary>
    <div class="mt-4 space-y-3">
      <% @inactive_positions.each do |position| %>
        <div class="rounded-lg border <%= position_role_class(position, @duplicate_position_ids) %> p-4 opacity-85">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <p class="text-sm font-medium text-white"><%= operator_position_label(position) %></p>
              <p class="mt-1 text-xs text-gray-400"><%= position_source_detail(position) %> · <%= hedge_venue_status_label(position) %></p>
            </div>
            <span class="rounded-full border border-gray-700 bg-gray-950 px-2 py-1 text-xs text-gray-300"><%= position_role_label(position, @duplicate_position_ids) %></span>
          </div>
          <div class="mt-3 flex flex-wrap gap-2">
            <%= link_to "Open record", position_path(position), class: "text-xs text-blue-300 hover:text-blue-200" %>
            <%= button_to "Activate", activate_position_path(position), method: :post, class: "rounded bg-blue-600 px-3 py-1 text-xs font-medium text-white hover:bg-blue-500" %>
          </div>
        </div>
      <% end %>
    </div>
  </details>
<% end %>

<h2 class="text-xl font-semibold text-white mb-4">Positions</h2>
<div class="bg-gray-900 rounded-xl border border-gray-800 overflow-hidden">
  <table class="w-full">
    <thead>
      <tr class="border-b border-gray-800">
        <th class="text-left text-gray-400 text-xs uppercase tracking-wide p-4">Pair</th>
        <th class="text-right text-gray-400 text-xs uppercase tracking-wide p-4">Value</th>
        <th class="text-right text-gray-400 text-xs uppercase tracking-wide p-4">Pool PnL</th>
        <th class="text-right text-gray-400 text-xs uppercase tracking-wide p-4">Hedge PnL</th>
        <th class="text-right text-gray-400 text-xs uppercase tracking-wide p-4">Fees</th>
        <th class="text-center text-gray-400 text-xs uppercase tracking-wide p-4">Hedge Venue</th>
        <th class="text-center text-gray-400 text-xs uppercase tracking-wide p-4">Health</th>
      </tr>
    </thead>
    <tbody>
      <% @positions.each do |position| %>
        <% valuation = PositionValuation.current(position) %>
        <% snapshot = position.pnl_snapshots.max_by(&:captured_at) %>
        <% dashboard_snapshot = position.position_dashboard_snapshot %>
        <% accounting_snapshot = position.position_hedge_accounting_snapshot %>
        <% rewards_snapshot = position.position_rewards_fees_snapshot %>
        <% hedge_venue = HedgeVenues.normalize(position.hedge&.execution_venue) %>
        <tr class="border-b border-gray-800/50 hover:bg-gray-800/30">
          <td class="p-4">
            <%= link_to position_path(position, hedge_venue: hedge_venue), class: "text-blue-400 hover:text-blue-300" do %>
              <span class="font-medium text-white"><%= position.asset0 %>/<%= position.asset1 %></span>
              <span class="text-gray-500 text-xs ml-2"><%= dex_display_name(position) %></span>
            <% end %>
            <% if aerodrome_position?(position) %>
              <div class="mt-2 flex flex-wrap gap-1">
                <% if position.mellow_autopilot? %>
                  <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-indigo-900/40 text-indigo-300 border border-indigo-800">Mellow</span>
                <% end %>
                <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-gray-800 text-gray-300 border border-gray-700">Base</span>
                <% if position.hedge&.active? %>
                  <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-green-900/40 text-green-300 border border-green-800"><%= HedgeVenues.label(hedge_venue) %></span>
                <% else %>
                  <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-900/40 text-yellow-300 border border-yellow-800">Monitor-only</span>
                  <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-gray-800 text-gray-300 border border-gray-700">No orders</span>
                <% end %>
              </div>
            <% end %>
          </td>
          <td class="p-4 text-right text-white"><%= valuation_value_display(valuation.current_value_usd) %></td>
          <% if snapshot || valuation.pool_delta_usd %>
            <td class="p-4 text-right <%= (valuation.pool_delta_usd || 0) >= 0 ? 'text-green-400' : 'text-red-400' %>">
              <%= valuation.pool_delta_usd ? format_usd(valuation.pool_delta_usd) : "Unavailable" %>
            </td>
            <% hedge_pnl = accounting_snapshot&.net_hedge_pnl_usd || dashboard_snapshot&.extended_unrealized_pnl_usd || ((snapshot&.hedge_unrealized || 0) + (snapshot&.hedge_realized || 0) if snapshot) %>
            <td class="p-4 text-right <%= (hedge_pnl || 0) >= 0 ? 'text-green-400' : 'text-red-400' %>">
              <%= hedge_pnl ? format_usd(hedge_pnl) : "Unavailable" %>
            </td>
            <td class="p-4 text-right text-green-400">
              <%= rewards_snapshot&.lp_fee_total_usd ? format_usd(rewards_snapshot.lp_fee_total_usd) : (snapshot ? format_usd(snapshot.total_fees_usd) : "Unavailable") %>
            </td>
          <% else %>
            <td class="p-4 text-right text-gray-500">-</td>
            <td class="p-4 text-right text-gray-500">-</td>
            <td class="p-4 text-right text-gray-500">-</td>
          <% end %>
          <td class="p-4 text-center">
            <% if position.hedge&.active? %>
              <span class="inline-block px-2 py-1 rounded-full text-xs font-medium bg-green-900/50 text-green-400 border border-green-800">Active</span>
            <% elsif aerodrome_position?(position) %>
              <span class="inline-block px-2 py-1 rounded-full text-xs font-medium bg-yellow-900/50 text-yellow-300 border border-yellow-800">Hedge disabled</span>
            <% else %>
              <span class="inline-block px-2 py-1 rounded-full text-xs font-medium bg-gray-800 text-gray-500 border border-gray-700">None</span>
            <% end %>
          </td>
          <td class="p-4 text-center">
            <% if dashboard_snapshot&.inside_tolerance == true %>
              <span class="inline-block px-2 py-1 rounded-full text-xs font-medium bg-green-900/50 text-green-300 border border-green-800">In tolerance</span>
            <% elsif dashboard_snapshot&.inside_tolerance == false %>
              <span class="inline-block px-2 py-1 rounded-full text-xs font-medium bg-yellow-900/50 text-yellow-300 border border-yellow-800">Out of tolerance</span>
            <% elsif dashboard_snapshot %>
              <span class="inline-block px-2 py-1 rounded-full text-xs font-medium bg-gray-800 text-gray-300 border border-gray-700">Snapshot <%= dashboard_snapshot.refresh_status %></span>
            <% else %>
              <span class="inline-block px-2 py-1 rounded-full text-xs font-medium bg-gray-800 text-gray-500 border border-gray-700">Not refreshed</span>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @positions.empty? %>
        <tr>
          <td colspan="7" class="p-8 text-center text-gray-500">
            <% if @inactive_positions_exist %>
              <p>No active production position selected. Activate one from Positions.</p>
              <div class="mt-4 space-y-2">
                <% @inactive_positions.each do |position| %>
                  <div class="flex items-center justify-center gap-3 text-sm">
                    <%= link_to operator_position_label(position), position_path(position), class: "text-blue-400 hover:text-blue-300" %>
                    <span class="rounded-full border border-gray-700 bg-gray-950 px-2 py-0.5 text-xs text-gray-300"><%= position_role_label(position, @duplicate_position_ids) %></span>
                    <%= button_to "Activate", activate_position_path(position), method: :post, class: "rounded bg-blue-600 px-3 py-1 text-xs font-medium text-white hover:bg-blue-500" %>
                  </div>
                <% end %>
              </div>
            <% else %>
              No active positions. <%= link_to "Add a wallet", new_wallet_path, class: "text-blue-400 hover:text-blue-300" %> or <%= link_to "import an Aerodrome LP", new_position_path, class: "text-blue-400 hover:text-blue-300" %> to get started.
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
