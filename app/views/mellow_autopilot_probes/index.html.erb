<div class="flex flex-wrap items-center justify-between gap-4 mb-8">
  <div>
    <h1 class="text-3xl font-bold text-white">Mellow Autopilot Probe</h1>
    <p class="text-gray-400 mt-1">Read-only research probe. No Position or Hedge records are created, and no exchange orders are submitted.</p>
  </div>
  <%= link_to "Back to Positions", positions_path, class: "bg-gray-800 hover:bg-gray-700 text-gray-100 px-4 py-2 rounded-lg text-sm font-medium transition" %>
</div>

<div class="bg-gray-900 rounded-xl border border-gray-800 p-5 mb-8">
  <%= form_with url: mellow_autopilot_probe_path, method: :get, local: true, class: "grid grid-cols-1 md:grid-cols-4 gap-4" do |form| %>
    <div class="md:col-span-2">
      <%= form.label :wallet_address, "Wallet address", class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= form.text_field :wallet_address, value: @wallet_address, placeholder: "0x...", class: "w-full bg-gray-950 border border-gray-700 rounded-lg px-3 py-2 text-white placeholder-gray-600" %>
    </div>
    <div>
      <%= form.label :vault_address, "Vault address (optional)", class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= form.text_field :vault_address, value: @vault_address, placeholder: "0x...", class: "w-full bg-gray-950 border border-gray-700 rounded-lg px-3 py-2 text-white placeholder-gray-600" %>
    </div>
    <div>
      <%= form.label :network, "Network", class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= form.text_field :network, value: @network, class: "w-full bg-gray-950 border border-gray-700 rounded-lg px-3 py-2 text-white" %>
    </div>
    <div class="md:col-span-4">
      <%= form.submit "Run Read-only Probe", class: "bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-lg text-sm font-medium transition" %>
    </div>
  <% end %>
</div>

<% if @probe_report %>
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-5">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="text-gray-400 text-xs uppercase tracking-wide">Probe Result</p>
        <p class="text-gray-500 text-sm mt-1">Source: <%= @probe_report[:source] %> &middot; Network: <%= @probe_report[:network] %></p>
      </div>
      <% if @probe_report[:hedge_target_computable] %>
        <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-green-950/50 text-green-300 border border-green-800">hedge target computable</span>
      <% else %>
        <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-red-950/50 text-red-200 border border-red-800">blocked</span>
      <% end %>
    </div>

    <% if @probe_report[:blockers].present? %>
      <div class="mt-4 bg-red-950/30 border border-red-900 rounded-lg p-3">
        <p class="text-red-200 text-sm font-semibold">Blockers</p>
        <ul class="mt-2 list-disc list-inside text-red-100/90 text-sm space-y-1">
          <% @probe_report[:blockers].each do |blocker| %>
            <li><%= blocker %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if @probe_report[:warnings].present? %>
      <div class="mt-4 bg-yellow-950/30 border border-yellow-900 rounded-lg p-3">
        <p class="text-yellow-200 text-sm font-semibold">Warnings</p>
        <ul class="mt-2 list-disc list-inside text-yellow-100/90 text-sm space-y-1">
          <% @probe_report[:warnings].uniq.each do |warning| %>
            <li><%= warning %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mt-5 overflow-x-auto rounded-lg border border-gray-800">
      <table class="w-full min-w-[860px] text-sm">
        <thead class="bg-gray-950">
          <tr class="border-b border-gray-800 text-left text-gray-400">
            <th class="px-3 py-3 font-medium">Vault</th>
            <th class="px-3 py-3 font-medium">Address</th>
            <th class="px-3 py-3 font-medium text-right">Shares</th>
            <th class="px-3 py-3 font-medium text-right">WETH</th>
            <th class="px-3 py-3 font-medium text-right">USDC</th>
            <th class="px-3 py-3 font-medium text-right">Total value</th>
            <th class="px-3 py-3 font-medium">Hedge target</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-900">
          <% @probe_report[:positions].each do |position| %>
            <tr class="hover:bg-gray-800/30">
              <td class="px-3 py-3 text-white"><%= position[:vault_name].presence || position[:vault_identifier].presence || "unknown" %></td>
              <td class="px-3 py-3 text-gray-300 break-all"><%= position[:vault_address].presence || "unknown" %></td>
              <td class="px-3 py-3 text-right text-gray-300"><%= position[:receipt_share_amount].presence || "unavailable" %></td>
              <td class="px-3 py-3 text-right text-white"><%= position[:weth_amount].presence || "unavailable" %></td>
              <td class="px-3 py-3 text-right text-white"><%= position[:usdc_amount].presence || "unavailable" %></td>
              <td class="px-3 py-3 text-right text-white"><%= position[:total_value_usd].present? ? format_usd(BigDecimal(position[:total_value_usd])) : "unavailable" %></td>
              <td class="px-3 py-3 <%= position[:weth_amount].present? ? 'text-green-300' : 'text-red-300' %>"><%= position[:weth_amount].present? ? "computable from WETH" : "not computable" %></td>
            </tr>
          <% end %>
          <% if @probe_report[:positions].empty? %>
            <tr>
              <td colspan="7" class="px-3 py-8 text-center text-gray-500">No Mellow/Autopilot positions detected.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
