<div class="flex flex-wrap items-center justify-between gap-4 mb-8">
  <div>
    <h1 class="text-3xl font-bold text-white">Mellow Autopilot Probe</h1>
    <p class="text-gray-400 mt-1">Read-only research probe. No Position or Hedge records are created, and no exchange orders are submitted.</p>
  </div>
  <%= link_to "Back to Positions", positions_path, class: "bg-gray-800 hover:bg-gray-700 text-gray-100 px-4 py-2 rounded-lg text-sm font-medium transition" %>
</div>

<div class="bg-gray-900 rounded-xl border border-gray-800 p-5 mb-8">
  <div class="mb-4 bg-yellow-950/30 border border-yellow-900 rounded-lg p-3 text-sm">
    <p class="text-yellow-100 font-medium">Model note</p>
    <p class="text-yellow-100/80 mt-1">Direct LP token IDs can be hedged from the token WETH amount. Autopilot/Mellow shared strategy token IDs require user share accounting; a shared strategy NFT is not treated as fully owned by the user.</p>
  </div>
  <%= form_with url: mellow_autopilot_probe_path, method: :get, local: true, class: "grid grid-cols-1 md:grid-cols-4 gap-4" do |form| %>
    <div class="md:col-span-2">
      <%= form.label :wallet_address, "Wallet address", class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= form.text_field :wallet_address, value: @wallet_address, placeholder: "0x...", class: "w-full bg-gray-950 border border-gray-700 rounded-lg px-3 py-2 text-white placeholder-gray-600" %>
    </div>
    <div>
      <%= form.label :vault_address, "Vault address (optional)", class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= form.text_field :vault_address, value: @vault_address, placeholder: "0x...", class: "w-full bg-gray-950 border border-gray-700 rounded-lg px-3 py-2 text-white placeholder-gray-600" %>
    </div>
    <div>
      <%= form.label :network, "Network", class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= form.text_field :network, value: @network, class: "w-full bg-gray-950 border border-gray-700 rounded-lg px-3 py-2 text-white" %>
    </div>
    <div class="md:col-span-4">
      <%= form.submit "Run Read-only Probe", class: "bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-lg text-sm font-medium transition" %>
    </div>
  <% end %>
</div>

<div class="bg-gray-900 rounded-xl border border-gray-800 p-5 mb-8">
  <div class="mb-4 bg-gray-950/50 border border-gray-800 rounded-lg p-3 text-sm">
    <p class="text-gray-100 font-medium">Aerodrome Autopilot Transaction Probe</p>
    <p class="text-gray-400 mt-1">Read-only Base receipt/log parser. It labels user deposits as transaction inputs, not current exposure, and does not create positions or hedges.</p>
  </div>
  <%= form_with url: mellow_autopilot_probe_path, method: :get, local: true, class: "grid grid-cols-1 md:grid-cols-4 gap-4" do |form| %>
    <div class="md:col-span-3">
      <%= form.label :tx_hash, "Base transaction hash", class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= form.text_field :tx_hash, value: @tx_hash, placeholder: "0x35512ec38b2b7320ab143727daaefa314b52896cb5137ac2410b40f90505d85f", class: "w-full bg-gray-950 border border-gray-700 rounded-lg px-3 py-2 text-white placeholder-gray-600" %>
    </div>
    <div>
      <%= form.label :network, "Network", class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= form.text_field :network, value: @network, class: "w-full bg-gray-950 border border-gray-700 rounded-lg px-3 py-2 text-white" %>
    </div>
    <div class="md:col-span-4">
      <%= form.submit "Analyze Transaction", class: "bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-lg text-sm font-medium transition" %>
    </div>
  <% end %>
</div>

<% if @transaction_probe_report %>
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-5 mb-8">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="text-gray-400 text-xs uppercase tracking-wide">Transaction Probe Result</p>
        <p class="text-gray-500 text-sm mt-1">Network: <%= @transaction_probe_report[:network] %> &middot; Tx: <%= @transaction_probe_report[:tx_hash] %></p>
      </div>
      <% if @transaction_probe_report[:hedgeable] %>
        <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-green-950/50 text-green-300 border border-green-800">hedgeable</span>
      <% else %>
        <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-red-950/50 text-red-200 border border-red-800">not hedgeable</span>
      <% end %>
    </div>

    <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
      <div class="flex justify-between gap-4"><span class="text-gray-500">Classification</span><span class="text-white"><%= @transaction_probe_report[:classification] %></span></div>
      <div class="flex justify-between gap-4"><span class="text-gray-500">Submitted wallet</span><span class="text-white text-right break-all"><%= @transaction_probe_report[:submitted_wallet].presence || "not provided" %></span></div>
      <div class="flex justify-between gap-4"><span class="text-gray-500">Detected depositor wallet</span><span class="text-white text-right break-all"><%= @transaction_probe_report[:detected_depositor_wallet].presence || "unknown" %></span></div>
      <div class="flex justify-between gap-4"><span class="text-gray-500">Pool / most common recipient</span><span class="text-white text-right break-all"><%= @transaction_probe_report[:pool_address].presence || "unknown" %></span></div>
      <div class="flex justify-between gap-4"><span class="text-gray-500">Strategy token IDs</span><span class="text-white"><%= @transaction_probe_report[:strategy_token_ids].presence&.join(", ") || "none" %></span></div>
      <div class="flex justify-between gap-4"><span class="text-gray-500">Router/manager contracts</span><span class="text-white text-right break-all"><%= @transaction_probe_report[:router_or_manager_contracts].presence&.join(", ") || "unknown" %></span></div>
      <div class="flex justify-between gap-4"><span class="text-gray-500">Intermediate contracts</span><span class="text-white text-right break-all"><%= @transaction_probe_report[:intermediate_contracts].presence&.join(", ") || "none" %></span></div>
    </div>

    <% if @transaction_probe_report[:user_deposit_amounts].present? %>
      <div class="mt-4 bg-gray-950/50 border border-gray-800 rounded-lg p-3">
        <p class="text-gray-400 text-xs uppercase tracking-wide">Detected user deposit amounts</p>
        <p class="text-yellow-200/80 text-xs mt-1">These are transaction inputs, not current exposure.</p>
        <dl class="mt-2 space-y-1 text-sm">
          <% @transaction_probe_report[:user_deposit_amounts].each do |symbol, amount| %>
            <div class="flex justify-between gap-4"><dt class="text-gray-500"><%= symbol %></dt><dd class="text-white"><%= amount %></dd></div>
          <% end %>
        </dl>
      </div>
    <% end %>

    <div class="mt-4 bg-gray-950/50 border border-gray-800 rounded-lg p-3">
      <p class="text-gray-400 text-xs uppercase tracking-wide">Pro-rata exposure check</p>
      <% exposure = @transaction_probe_report[:pro_rata_exposure] || {} %>
      <div class="mt-2 grid grid-cols-1 md:grid-cols-3 gap-3 text-sm">
        <div class="flex justify-between gap-4"><span class="text-gray-500">Confidence</span><span class="text-white"><%= exposure[:confidence].presence || "unavailable" %></span></div>
        <div class="flex justify-between gap-4"><span class="text-gray-500">User WETH exposure</span><span class="text-white"><%= exposure[:user_weth_exposure].presence || "unavailable" %></span></div>
        <div class="flex justify-between gap-4"><span class="text-gray-500">User USDC exposure</span><span class="text-white"><%= exposure[:user_usdc_exposure].presence || "unavailable" %></span></div>
      </div>
    </div>

    <% if @transaction_probe_report[:candidate_share_tokens].present? %>
      <div class="mt-5 overflow-x-auto rounded-lg border border-gray-800">
        <table class="w-full min-w-[920px] text-sm">
          <thead class="bg-gray-950">
            <tr class="border-b border-gray-800 text-left text-gray-400">
              <th class="px-3 py-3 font-medium">Candidate share token</th>
              <th class="px-3 py-3 font-medium">Symbol</th>
              <th class="px-3 py-3 font-medium">Name</th>
              <th class="px-3 py-3 font-medium text-right">Transfer amount</th>
              <th class="px-3 py-3 font-medium text-right">User balance</th>
              <th class="px-3 py-3 font-medium text-right">Total shares</th>
              <th class="px-3 py-3 font-medium">Looks like receipt/share</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-900">
            <% @transaction_probe_report[:candidate_share_tokens].each do |token| %>
              <tr>
                <td class="px-3 py-3 text-gray-300 break-all"><%= token[:token_address] %></td>
                <td class="px-3 py-3 text-white"><%= token[:symbol].presence || "unknown" %></td>
                <td class="px-3 py-3 text-gray-300"><%= token[:name].presence || "unknown" %></td>
                <td class="px-3 py-3 text-right text-white"><%= token[:transfer_amount] %></td>
                <td class="px-3 py-3 text-right text-white"><%= token[:user_balance].presence || "unavailable" %></td>
                <td class="px-3 py-3 text-right text-white"><%= token[:total_supply].presence || "unavailable" %></td>
                <td class="px-3 py-3 <%= token[:looks_like_share_token] ? 'text-green-300' : 'text-yellow-300' %>"><%= token[:looks_like_share_token] ? "yes" : "unknown" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <% if @transaction_probe_report[:strategy_contract_reads].present? %>
      <div class="mt-5 overflow-x-auto rounded-lg border border-gray-800">
        <table class="w-full min-w-[980px] text-sm">
          <thead class="bg-gray-950">
            <tr class="border-b border-gray-800 text-left text-gray-400">
              <th class="px-3 py-3 font-medium">Strategy/intermediate</th>
              <th class="px-3 py-3 font-medium">Total supply</th>
              <th class="px-3 py-3 font-medium">token0</th>
              <th class="px-3 py-3 font-medium">token1</th>
              <th class="px-3 py-3 font-medium">pool</th>
              <th class="px-3 py-3 font-medium">getTotalAmounts</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-900">
            <% @transaction_probe_report[:strategy_contract_reads].each do |read| %>
              <tr>
                <td class="px-3 py-3 text-gray-300 break-all"><%= read[:address] %></td>
                <td class="px-3 py-3 text-white"><%= read[:total_supply].presence || "unavailable" %></td>
                <td class="px-3 py-3 text-gray-300 break-all"><%= read[:token0].presence || "unavailable" %></td>
                <td class="px-3 py-3 text-gray-300 break-all"><%= read[:token1].presence || "unavailable" %></td>
                <td class="px-3 py-3 text-gray-300 break-all"><%= read[:pool].presence || "unavailable" %></td>
                <td class="px-3 py-3 text-white"><%= read[:get_total_amounts].present? ? read[:get_total_amounts].values.join(" / ") : "unavailable" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <% if @transaction_probe_report[:blockers].present? %>
      <div class="mt-4 bg-red-950/30 border border-red-900 rounded-lg p-3">
        <p class="text-red-200 text-sm font-semibold">Blockers</p>
        <ul class="mt-2 list-disc list-inside text-red-100/90 text-sm space-y-1">
          <% @transaction_probe_report[:blockers].each do |blocker| %>
            <li><%= blocker %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if @transaction_probe_report[:warnings].present? %>
      <div class="mt-4 bg-yellow-950/30 border border-yellow-900 rounded-lg p-3">
        <p class="text-yellow-200 text-sm font-semibold">Warnings</p>
        <ul class="mt-2 list-disc list-inside text-yellow-100/90 text-sm space-y-1">
          <% @transaction_probe_report[:warnings].each do |warning| %>
            <li><%= warning %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mt-5 grid grid-cols-1 lg:grid-cols-2 gap-4">
      <div class="overflow-x-auto rounded-lg border border-gray-800">
        <table class="w-full min-w-[620px] text-sm">
          <thead class="bg-gray-950">
            <tr class="border-b border-gray-800 text-left text-gray-400">
              <th class="px-3 py-3 font-medium">Token</th>
              <th class="px-3 py-3 font-medium">From</th>
              <th class="px-3 py-3 font-medium">To</th>
              <th class="px-3 py-3 font-medium text-right">Amount</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-900">
            <% @transaction_probe_report[:erc20_transfers].each do |transfer| %>
              <tr>
                <td class="px-3 py-3 text-white"><%= transfer[:symbol] %></td>
                <td class="px-3 py-3 text-gray-300 break-all"><%= transfer[:from] %></td>
                <td class="px-3 py-3 text-gray-300 break-all"><%= transfer[:to] %></td>
                <td class="px-3 py-3 text-right text-white"><%= transfer[:amount] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="overflow-x-auto rounded-lg border border-gray-800">
        <table class="w-full min-w-[620px] text-sm">
          <thead class="bg-gray-950">
            <tr class="border-b border-gray-800 text-left text-gray-400">
              <th class="px-3 py-3 font-medium">Token ID</th>
              <th class="px-3 py-3 font-medium">From</th>
              <th class="px-3 py-3 font-medium">To</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-900">
            <% @transaction_probe_report[:slipstream_nft_transfers].each do |transfer| %>
              <tr>
                <td class="px-3 py-3 text-white"><%= transfer[:token_id] %></td>
                <td class="px-3 py-3 text-gray-300 break-all"><%= transfer[:from] %></td>
                <td class="px-3 py-3 text-gray-300 break-all"><%= transfer[:to] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% end %>

<% if @probe_report %>
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-5">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="text-gray-400 text-xs uppercase tracking-wide">Probe Result</p>
        <p class="text-gray-500 text-sm mt-1">Source: <%= @probe_report[:source] %> &middot; Network: <%= @probe_report[:network] %></p>
      </div>
      <% if @probe_report[:hedge_target_computable] %>
        <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-green-950/50 text-green-300 border border-green-800">hedge target computable</span>
      <% else %>
        <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-red-950/50 text-red-200 border border-red-800">blocked</span>
      <% end %>
    </div>

    <% if @probe_report[:blockers].present? %>
      <div class="mt-4 bg-red-950/30 border border-red-900 rounded-lg p-3">
        <p class="text-red-200 text-sm font-semibold">Blockers</p>
        <ul class="mt-2 list-disc list-inside text-red-100/90 text-sm space-y-1">
          <% @probe_report[:blockers].each do |blocker| %>
            <li><%= blocker %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if @probe_report[:warnings].present? %>
      <div class="mt-4 bg-yellow-950/30 border border-yellow-900 rounded-lg p-3">
        <p class="text-yellow-200 text-sm font-semibold">Warnings</p>
        <ul class="mt-2 list-disc list-inside text-yellow-100/90 text-sm space-y-1">
          <% @probe_report[:warnings].uniq.each do |warning| %>
            <li><%= warning %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mt-5 overflow-x-auto rounded-lg border border-gray-800">
      <table class="w-full min-w-[860px] text-sm">
        <thead class="bg-gray-950">
          <tr class="border-b border-gray-800 text-left text-gray-400">
            <th class="px-3 py-3 font-medium">Vault</th>
            <th class="px-3 py-3 font-medium">Type</th>
            <th class="px-3 py-3 font-medium">Strategy token ID</th>
            <th class="px-3 py-3 font-medium">Address</th>
            <th class="px-3 py-3 font-medium text-right">Shares</th>
            <th class="px-3 py-3 font-medium text-right">Total shares</th>
            <th class="px-3 py-3 font-medium text-right">WETH</th>
            <th class="px-3 py-3 font-medium text-right">USDC</th>
            <th class="px-3 py-3 font-medium text-right">Total value</th>
            <th class="px-3 py-3 font-medium">Hedge target</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-900">
          <% @probe_report[:positions].each do |position| %>
            <tr class="hover:bg-gray-800/30">
              <td class="px-3 py-3 text-white"><%= position[:vault_name].presence || position[:vault_identifier].presence || "unknown" %></td>
              <td class="px-3 py-3 text-gray-300"><%= position[:position_type].presence || "unknown" %></td>
              <td class="px-3 py-3 text-gray-300"><%= position[:strategy_token_id].presence || "—" %></td>
              <td class="px-3 py-3 text-gray-300 break-all"><%= position[:vault_address].presence || "unknown" %></td>
              <td class="px-3 py-3 text-right text-gray-300"><%= position[:receipt_share_amount].presence || "unavailable" %></td>
              <td class="px-3 py-3 text-right text-gray-300"><%= position[:total_shares].presence || "unavailable" %></td>
              <td class="px-3 py-3 text-right text-white"><%= position[:weth_amount].presence || "unavailable" %></td>
              <td class="px-3 py-3 text-right text-white"><%= position[:usdc_amount].presence || "unavailable" %></td>
              <td class="px-3 py-3 text-right text-white"><%= position[:total_value_usd].present? ? format_usd(BigDecimal(position[:total_value_usd])) : "unavailable" %></td>
              <td class="px-3 py-3 <%= position[:hedgeable] ? 'text-green-300' : 'text-red-300' %>"><%= position[:hedgeable] ? "computable from user WETH" : "not computable" %></td>
            </tr>
          <% end %>
          <% if @probe_report[:positions].empty? %>
            <tr>
              <td colspan="10" class="px-3 py-8 text-center text-gray-500">No Mellow/Autopilot positions detected.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
