<h1 class="text-2xl font-bold text-white mb-6">Settings</h1>

<% venue_runtime_summary = @venue_runtime_summary || {} %>

<div class="bg-gray-900 rounded-xl border border-gray-800 p-6 max-w-3xl mb-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h2 class="text-lg font-semibold text-gray-200">Current Production Hedge</h2>
      <p class="mt-1 text-sm text-gray-400">Read-only operational summary. Secrets and auth headers are never shown here.</p>
    </div>
    <span class="inline-flex rounded-full border border-indigo-800 bg-indigo-900/40 px-3 py-1 text-sm font-medium text-indigo-200">
      <%= venue_runtime_summary[:production_venue] || "Unknown" %>
    </span>
  </div>

  <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
    <div class="rounded-lg border border-gray-800 bg-gray-950/60 p-3">
      <p class="text-xs uppercase tracking-wide text-gray-500">Extended live</p>
      <p class="mt-1 text-sm font-semibold <%= venue_runtime_summary[:extended_live_enabled] ? 'text-green-300' : 'text-gray-300' %>"><%= venue_runtime_summary[:extended_live_enabled] ? "Enabled" : "Disabled" %></p>
    </div>
    <div class="rounded-lg border border-gray-800 bg-gray-950/60 p-3">
      <p class="text-xs uppercase tracking-wide text-gray-500">Extended auto</p>
      <p class="mt-1 text-sm font-semibold <%= venue_runtime_summary[:extended_auto_enabled] ? 'text-green-300' : 'text-gray-300' %>"><%= venue_runtime_summary[:extended_auto_enabled] ? "Enabled" : "Disabled" %></p>
    </div>
    <div class="rounded-lg border border-gray-800 bg-gray-950/60 p-3">
      <p class="text-xs uppercase tracking-wide text-gray-500">Signer</p>
      <p class="mt-1 text-sm font-semibold <%= venue_runtime_summary[:signer_status].to_s == 'ok' ? 'text-green-300' : 'text-gray-300' %>"><%= (venue_runtime_summary[:signer_status] || "unknown").to_s.titleize %></p>
    </div>
    <div class="rounded-lg border border-gray-800 bg-gray-950/60 p-3">
      <p class="text-xs uppercase tracking-wide text-gray-500">Ethereal auto</p>
      <p class="mt-1 text-sm font-semibold <%= venue_runtime_summary[:ethereal_auto_enabled] ? 'text-yellow-300' : 'text-gray-300' %>"><%= venue_runtime_summary[:ethereal_auto_enabled] ? "Enabled" : "Disabled" %></p>
    </div>
    <div class="rounded-lg border border-gray-800 bg-gray-950/60 p-3">
      <p class="text-xs uppercase tracking-wide text-gray-500">Nado auto</p>
      <p class="mt-1 text-sm font-semibold <%= venue_runtime_summary[:nado_auto_enabled] ? 'text-yellow-300' : 'text-gray-300' %>"><%= venue_runtime_summary[:nado_auto_enabled] ? "Enabled" : "Disabled" %></p>
    </div>
    <div class="rounded-lg border border-gray-800 bg-gray-950/60 p-3">
      <p class="text-xs uppercase tracking-wide text-gray-500">Snapshot</p>
      <p class="mt-1 text-sm font-semibold text-gray-300"><%= @production_snapshot&.refresh_status || "not refreshed" %></p>
    </div>
  </div>
</div>

<% if @auto_control_status.present? %>
  <% auto_status = @auto_control_status %>
  <% auto_enabled = auto_status[:selected_auto_enabled] %>
  <% auto_phrase = auto_enabled ? auto_status[:disable_confirmation] : auto_status[:enable_confirmation] %>
  <div id="auto-settings" class="mb-6 max-w-5xl rounded-xl border border-gray-800 bg-gray-900 p-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h2 class="text-lg font-semibold text-gray-200">Auto-Rebalance Controls</h2>
        <p class="mt-1 text-sm text-gray-400">Controls the selected active production venue only. Toggling auto does not submit orders, create signatures, or cancel orders.</p>
      </div>
      <span class="rounded-full border <%= auto_enabled ? 'border-green-800 bg-green-950/50 text-green-300' : 'border-gray-700 bg-gray-950 text-gray-300' %> px-3 py-1 text-xs font-semibold"><%= auto_enabled ? "Auto On" : "Auto Off" %></span>
    </div>
    <div class="mt-4 grid gap-3 text-sm md:grid-cols-4">
      <div class="rounded-lg border border-gray-800 bg-gray-950/60 p-3"><p class="text-xs text-gray-500">Active position</p><p class="text-white">#<%= auto_status[:position_id] %></p></div>
      <div class="rounded-lg border border-gray-800 bg-gray-950/60 p-3"><p class="text-xs text-gray-500">Selected active venue</p><p class="text-white"><%= auto_status[:selected_venue_name] %></p></div>
      <div class="rounded-lg border border-gray-800 bg-gray-950/60 p-3"><p class="text-xs text-gray-500">Live</p><p class="<%= auto_status[:selected_live_enabled] ? 'text-green-300' : 'text-gray-300' %>"><%= auto_status[:selected_live_enabled] ? "Enabled" : "Disabled" %></p></div>
      <div class="rounded-lg border border-gray-800 bg-gray-950/60 p-3"><p class="text-xs text-gray-500">Signer</p><p class="<%= auto_status[:signer_ok] ? 'text-green-300' : 'text-gray-300' %>"><%= auto_status[:signer_ok] ? "OK" : "Needs review" %></p></div>
    </div>
    <% if @auto_setting_errors.present? %>
      <div class="mt-4 rounded-lg border border-red-800 bg-red-950/40 p-3 text-sm text-red-200">
        <% @auto_setting_errors.each do |error| %><p><%= error %></p><% end %>
      </div>
    <% elsif auto_status[:blockers].present? && !auto_enabled %>
      <ul class="mt-4 list-disc space-y-1 pl-5 text-sm text-yellow-100">
        <% auto_status[:blockers].each do |blocker| %><li><%= blocker %></li><% end %>
      </ul>
    <% end %>
    <%= form_with url: auto_settings_path, method: :patch, class: "mt-5 grid gap-3 lg:grid-cols-[minmax(12rem,1fr)_minmax(16rem,1fr)_auto]" do |form| %>
      <%= form.hidden_field :position_id, value: auto_status[:position_id] %>
      <%= form.hidden_field :venue, value: auto_status[:selected_venue] %>
      <%= form.hidden_field :enabled, value: (!auto_enabled).to_s %>
      <%= form.text_field :auto_confirmation, placeholder: auto_phrase, autocomplete: "off", class: "rounded border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white placeholder:text-gray-600" %>
      <%= form.submit(auto_enabled ? "Disable #{auto_status[:selected_venue_name]} Auto" : "Enable #{auto_status[:selected_venue_name]} Auto", disabled: auto_status[:blockers].present? && !auto_enabled, class: "rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500 disabled:bg-gray-900 disabled:text-gray-600") %>
      <button name="disable_all" value="1" class="rounded border border-gray-700 px-4 py-2 text-sm text-gray-200 hover:bg-gray-800">Disable all auto</button>
      <p class="lg:col-span-3 text-xs text-gray-500">Enable/disable phrase: <%= auto_phrase %>. Disable all phrase: <%= OperationalSettings::DISABLE_ALL_CONFIRMATION %>.</p>
    <% end %>
  </div>
<% end %>

<div id="risk-settings" class="mb-6 max-w-5xl rounded-xl border border-gray-800 bg-gray-900 p-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h2 class="text-lg font-semibold text-gray-200">Risk Limits</h2>
      <p class="mt-1 text-sm text-gray-400">DB settings override env values. Venue-specific caps win over generic Aerodrome caps. Changes apply immediately and do not submit orders.</p>
    </div>
    <span class="rounded-full border border-green-800 bg-green-950/50 px-3 py-1 text-xs font-semibold text-green-300">No restart required</span>
  </div>

  <% if @risk_setting_errors.present? %>
    <div class="mt-4 rounded-lg border border-red-800 bg-red-950/40 p-3 text-sm text-red-200">
      <% @risk_setting_errors.each do |error| %><p><%= error %></p><% end %>
    </div>
  <% end %>

  <%= form_with url: risk_settings_path, method: :patch, class: "mt-5 space-y-5" do %>
    <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4">
      <label for="risk-confirmation" class="block text-xs uppercase tracking-wide text-gray-500">Shared confirmation</label>
      <input id="risk-confirmation" name="confirmation" placeholder="<%= RiskSettings::HARD_INCREASE_CONFIRMATION %>" class="mt-2 w-full rounded border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white">
      <div class="mt-3 grid gap-2 text-xs text-gray-400 md:grid-cols-3">
        <p>Hard ceiling increases: <code class="rounded bg-gray-900 px-1 text-gray-200"><%= RiskSettings::HARD_INCREASE_CONFIRMATION %></code></p>
        <p>Runtime increases: <code class="rounded bg-gray-900 px-1 text-gray-200"><%= RiskSettings::INCREASE_CONFIRMATION %></code></p>
        <p>Decreases/other changes: <code class="rounded bg-gray-900 px-1 text-gray-200"><%= RiskSettings::DECREASE_CONFIRMATION %></code></p>
      </div>
    </div>

    <% if @risk_recommendation %>
      <% rec = @risk_recommendation %>
    <div class="mt-5 rounded-xl border <%= rec[:required_changes].present? ? 'border-yellow-800 bg-yellow-950/20' : 'border-green-800 bg-green-950/20' %> p-4">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
        <div>
          <p class="text-xs uppercase tracking-wide text-gray-500">Current active position</p>
          <h3 class="mt-1 text-base font-semibold text-white">Position #<%= rec[:position_id] %> · <%= rec[:venue].to_s.titleize %></h3>
          <p class="mt-1 text-sm text-gray-300">
            Required hedge: <%= format_venue_eth_amount(rec[:target_short_eth]) %> ETH.
            Estimated notional: <%= format_venue_usd_amount(rec[:estimated_notional_usd]) %>.
          </p>
          <% if rec[:required_changes].present? %>
            <p class="mt-2 text-sm text-yellow-100">Risk blockers: <%= rec[:required_changes].map { |change| change[:label] }.join(", ") %>.</p>
          <% else %>
            <p class="mt-2 text-sm text-green-100">Current hard ceilings and runtime caps are sufficient for the latest target hedge.</p>
          <% end %>
          <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm text-gray-200">
            <% rec[:required_changes].each do |change| %>
              <li>Set <%= change[:label] %> to at least <%= change[:recommended_value] %> <%= RiskSettings.unit_for(change[:key]) %>.</li>
            <% end %>
          </ol>
        </div>
        <div class="flex flex-col gap-2">
          <input type="hidden" name="position_id" value="<%= rec[:position_id] %>">
          <input type="hidden" name="venue" value="<%= rec[:venue] %>">
          <button name="apply_recommended" value="1" class="rounded-lg bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-500">Apply recommended hard + runtime limits</button>
          <p class="text-xs text-gray-500">Requires <%= rec[:confirmation_required] %>.</p>
        </div>
      </div>
    </div>
    <% end %>

    <% @risk_setting_groups.each do |group| %>
      <section class="rounded-xl border border-gray-800 bg-gray-950/40 p-4">
        <h3 class="text-base font-semibold text-white"><%= group[:title] %></h3>
        <div class="mt-4 space-y-4">
          <% group[:rows].each do |row| %>
            <div id="risk-setting-<%= row[:key].parameterize %>" class="rounded-lg border border-gray-800 bg-gray-900/80 p-4">
              <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
                <div class="min-w-0">
                  <h4 class="text-sm font-semibold text-white">
                    <%= row[:label] %>
                    <span class="font-mono text-xs font-normal text-gray-500">(<%= row[:key] %>)</span>
                  </h4>
                  <p class="mt-1 text-sm text-gray-400"><%= row[:description] %></p>
                  <p class="mt-2 text-xs text-gray-500"><%= row[:helper] %></p>
                </div>
                <span class="shrink-0 rounded-full border border-gray-700 bg-gray-950 px-2 py-1 text-xs text-gray-300"><%= row[:state] %></span>
              </div>
              <div class="mt-4 grid gap-3 text-sm md:grid-cols-3">
                <div>
                  <p class="text-xs uppercase tracking-wide text-gray-500">Current</p>
                  <p class="mt-1 text-white"><%= row[:current] %></p>
                </div>
                <div>
                  <p class="text-xs uppercase tracking-wide text-gray-500">Effective</p>
                  <p class="mt-1 text-gray-200"><%= row[:effective] %></p>
                </div>
                <div>
                  <p class="text-xs uppercase tracking-wide text-gray-500">Source</p>
                  <p class="mt-1 text-gray-300"><%= row[:source] %></p>
                </div>
              </div>
              <div class="mt-4 grid gap-2 lg:grid-cols-[minmax(9rem,12rem)_minmax(12rem,1fr)_auto]">
                <input name="risk_values[<%= row[:key] %>]" value="<%= row[:raw_value] %>" placeholder="new value" class="rounded border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white">
                <input name="risk_reasons[<%= row[:key] %>]" placeholder="reason for audit log" class="rounded border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white">
                <span class="rounded border border-gray-800 bg-gray-950 px-3 py-2 text-xs text-gray-500">Saved by Save changed settings</span>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
    <div class="flex justify-end">
      <button name="save_changed" value="1" class="rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500">Save changed settings</button>
    </div>
  <% end %>

  <p class="mt-4 text-xs text-gray-500">Archiving/deleting app records never closes on-chain LPs or exchange hedges. Risk setting changes create no orders, signatures, or cancels.</p>
</div>

<details class="bg-gray-900 rounded-xl border border-gray-800 p-6 max-w-lg">
  <summary class="cursor-pointer">
    <span class="text-lg font-semibold text-gray-200">Legacy Hyperliquid settings</span>
    <span class="ml-2 rounded-full border border-gray-700 bg-gray-950 px-2 py-0.5 text-xs text-gray-400">Legacy only</span>
    <p class="mt-1 text-sm text-gray-500">Kept only for historical records. Hyperliquid is not a supported current production venue in this app.</p>
  </summary>
  <%= form_with(model: @setting, url: settings_path, method: :patch, class: "space-y-6") do |f| %>
    <% if @setting.errors.any? %>
      <div class="rounded-lg bg-red-900/50 border border-red-700 p-4 text-red-300 text-sm">
        <% @setting.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="mt-6">
      <%= f.label :hyperliquid_leverage, "Leverage", class: "block text-sm font-medium text-gray-300 mb-2" %>
      <%= f.number_field :hyperliquid_leverage, step: 1, min: 1, max: 50, class: "w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2 text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
      <p class="text-gray-500 text-xs mt-1">Leverage multiplier for short positions (1x–50x)</p>
    </div>

    <div>
      <%= f.label :hyperliquid_cross_margin, "Margin Mode", class: "block text-sm font-medium text-gray-300 mb-2" %>
      <div class="flex items-center space-x-6">
        <label class="flex items-center space-x-2 cursor-pointer">
          <%= f.radio_button :hyperliquid_cross_margin, true, class: "w-4 h-4 bg-gray-800 border-gray-700 text-blue-600 focus:ring-blue-500" %>
          <span class="text-sm text-gray-300">Cross</span>
        </label>
        <label class="flex items-center space-x-2 cursor-pointer">
          <%= f.radio_button :hyperliquid_cross_margin, false, class: "w-4 h-4 bg-gray-800 border-gray-700 text-blue-600 focus:ring-blue-500" %>
          <span class="text-sm text-gray-300">Isolated</span>
        </label>
      </div>
    </div>

    <div>
      <%= f.submit "Save Settings", class: "bg-blue-600 hover:bg-blue-500 text-white px-6 py-2 rounded-lg text-sm font-medium transition cursor-pointer" %>
    </div>
  <% end %>
</details>
