<div class="flex flex-wrap items-center justify-between gap-4 mb-8">
  <h1 class="text-3xl font-bold text-white">Positions</h1>
  <div class="flex flex-wrap gap-3">
    <%= link_to "Mellow Autopilot Probe", mellow_autopilot_probe_path, class: "bg-gray-800 hover:bg-gray-700 text-gray-100 px-4 py-2 rounded-lg text-sm font-medium transition" %>
    <%= link_to "Import Aerodrome LP Position", new_position_path, class: "bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-lg text-sm font-medium transition" %>
  </div>
</div>

<% active_positions = @positions.select(&:active?) %>
<% duplicate_positions = @positions.reject(&:active?).select { |position| @duplicate_position_ids.include?(position.id) } %>
<% legacy_positions = @positions.select { |position| position.hedge&.unsupported_legacy_execution_venue? } %>
<% historical_positions = @positions.reject(&:active?).reject { |position| @duplicate_position_ids.include?(position.id) || position.hedge&.unsupported_legacy_execution_venue? } %>

<div class="mb-8 grid grid-cols-1 gap-4 xl:grid-cols-2">
  <section class="rounded-xl border border-green-800 bg-green-950/20 p-5">
    <h2 class="text-lg font-semibold text-white">Active production</h2>
    <div class="mt-4 space-y-3">
      <% active_positions.each do |position| %>
        <div class="rounded-lg border border-green-800 bg-gray-950/60 p-4">
          <p class="text-sm font-medium text-white"><%= operator_position_label(position) %></p>
          <p class="mt-1 text-xs text-gray-400"><%= position_source_detail(position) %> · <%= hedge_venue_status_label(position) %></p>
          <div class="mt-3 flex flex-wrap gap-2">
            <span class="rounded-full border border-green-700 bg-green-950 px-2 py-1 text-xs text-green-200">Current production</span>
            <%= link_to "Manage hedge", position_path(position, hedge_venue: HedgeVenues.normalize(position.hedge&.execution_venue), tab: "hedge"), class: "text-xs text-blue-300 hover:text-blue-200" %>
          </div>
        </div>
      <% end %>
      <% if active_positions.empty? %>
        <p class="text-sm text-gray-400">No active production position selected.</p>
      <% end %>
    </div>
  </section>

  <section class="rounded-xl border border-gray-800 bg-gray-900/80 p-5">
    <h2 class="text-lg font-semibold text-white">Inactive duplicates</h2>
    <div class="mt-4 space-y-3">
      <% duplicate_positions.each do |position| %>
        <div class="rounded-lg border border-yellow-800 bg-yellow-950/20 p-4">
          <p class="text-sm font-medium text-white"><%= operator_position_label(position) %></p>
          <p class="mt-1 text-xs text-gray-400"><%= position_source_detail(position) %> · <%= hedge_venue_status_label(position) %></p>
          <span class="mt-3 inline-block rounded-full border border-yellow-700 bg-yellow-950 px-2 py-1 text-xs text-yellow-200">Duplicate inactive</span>
        </div>
      <% end %>
      <% if duplicate_positions.empty? %>
        <p class="text-sm text-gray-400">No inactive duplicates detected.</p>
      <% end %>
    </div>
  </section>

  <section class="rounded-xl border border-gray-800 bg-gray-900/80 p-5">
    <h2 class="text-lg font-semibold text-white">Historical positions</h2>
    <div class="mt-4 space-y-3">
      <% historical_positions.each do |position| %>
        <div class="rounded-lg border border-gray-800 bg-gray-950/60 p-4 opacity-80">
          <p class="text-sm font-medium text-white"><%= operator_position_label(position) %></p>
          <p class="mt-1 text-xs text-gray-400"><%= position_source_detail(position) %> · <%= hedge_venue_status_label(position) %></p>
          <span class="mt-3 inline-block rounded-full border border-gray-700 bg-gray-950 px-2 py-1 text-xs text-gray-300"><%= position_role_label(position, @duplicate_position_ids) %></span>
        </div>
      <% end %>
      <% if historical_positions.empty? %>
        <p class="text-sm text-gray-400">No historical positions.</p>
      <% end %>
    </div>
  </section>

  <section class="rounded-xl border border-gray-800 bg-gray-900/80 p-5">
    <h2 class="text-lg font-semibold text-white">Legacy unsupported venue positions</h2>
    <div class="mt-4 space-y-3">
      <% legacy_positions.each do |position| %>
        <div class="rounded-lg border border-yellow-800 bg-yellow-950/20 p-4">
          <p class="text-sm font-medium text-white"><%= operator_position_label(position) %></p>
          <p class="mt-1 text-xs text-yellow-100"><%= hedge_venue_status_label(position) %>. Switch to supported venue.</p>
        </div>
      <% end %>
      <% if legacy_positions.empty? %>
        <p class="text-sm text-gray-400">No legacy unsupported venue rows.</p>
      <% end %>
    </div>
  </section>
</div>

<h2 class="mb-4 text-xl font-semibold text-white">All position records</h2>
<div class="bg-gray-900 rounded-xl border border-gray-800 overflow-hidden">
  <table class="w-full">
    <thead>
      <tr class="border-b border-gray-800">
        <th class="text-left text-gray-400 text-xs uppercase tracking-wide p-4">Pair</th>
        <th class="text-center text-gray-400 text-xs uppercase tracking-wide p-4">Status</th>
        <th class="text-left text-gray-400 text-xs uppercase tracking-wide p-4">DEX</th>
        <th class="text-right text-gray-400 text-xs uppercase tracking-wide p-4">Asset0 Amount</th>
        <th class="text-right text-gray-400 text-xs uppercase tracking-wide p-4">Asset1 Amount</th>
        <th class="text-right text-gray-400 text-xs uppercase tracking-wide p-4">Value</th>
        <th class="text-center text-gray-400 text-xs uppercase tracking-wide p-4">Hedge Venue</th>
        <th class="text-center text-gray-400 text-xs uppercase tracking-wide p-4">Snapshot</th>
        <th class="text-right text-gray-400 text-xs uppercase tracking-wide p-4">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @positions.each do |position| %>
        <% valuation = PositionValuation.current(position) %>
        <% dashboard_snapshot = position.position_dashboard_snapshot %>
        <% hedge_venue = HedgeVenues.supported?(position.hedge&.execution_venue) ? HedgeVenues.normalize(position.hedge&.execution_venue) : HedgeVenues.default_supported %>
        <tr class="border-b border-gray-800/50 hover:bg-gray-800/30">
          <td class="p-4">
            <%= link_to position_path(position, hedge_venue: hedge_venue), class: "text-blue-400 hover:text-blue-300 font-medium" do %>
              <%= operator_position_label(position) %>
            <% end %>
            <% if aerodrome_position?(position) %>
              <div class="mt-2 space-y-1">
                <p class="text-gray-500 text-xs">Chain: <%= chain_display_name(position) %> &middot; <%= position.mellow_autopilot? ? "Observed token ID" : "Token ID" %>: <%= position.external_id %></p>
                <p class="text-gray-500 text-xs">Pool: <%= position.pool_address %></p>
                <div class="flex flex-wrap gap-1">
                  <% if position.mellow_autopilot? %>
                    <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-indigo-900/40 text-indigo-300 border border-indigo-800">Mellow</span>
                  <% end %>
                  <% if position.hedge&.active? %>
                    <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-green-900/40 text-green-300 border border-green-800">Production hedge</span>
                  <% else %>
                    <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium <%= position_role_class(position, @duplicate_position_ids) %>"><%= position_role_label(position, @duplicate_position_ids) %></span>
                    <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-900/40 text-yellow-300 border border-yellow-800">Monitor-only</span>
                    <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-gray-800 text-gray-300 border border-gray-700">No orders</span>
                    <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-gray-800 text-gray-300 border border-gray-700">Hyperliquid not called</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </td>
          <td class="p-4 text-center">
            <% if position.active? %>
              <span class="inline-block px-2 py-1 rounded-full text-xs font-medium bg-green-900/50 text-green-300 border border-green-800">Active</span>
            <% else %>
              <span class="inline-block px-2 py-1 rounded-full text-xs font-medium bg-gray-800 text-gray-300 border border-gray-700">Archived</span>
            <% end %>
          </td>
          <td class="p-4 text-gray-300"><%= dex_display_name(position) %></td>
          <td class="p-4 text-right text-white"><%= amount_display(position.asset0_amount, precision: 6) %></td>
          <td class="p-4 text-right text-white"><%= amount_display(position.asset1_amount, precision: 2) %></td>
          <td class="p-4 text-right text-white font-medium"><%= valuation_value_display(valuation.current_value_usd) %></td>
          <td class="p-4 text-center">
            <% if position.hedge&.active? %>
              <% if position.hedge.unsupported_legacy_execution_venue? %>
                <span class="inline-block px-2 py-1 rounded-full text-xs font-medium bg-yellow-900/50 text-yellow-300 border border-yellow-800">Unsupported legacy venue</span>
              <% else %>
                <span class="inline-block px-2 py-1 rounded-full text-xs font-medium bg-green-900/50 text-green-400 border border-green-800">
                  <%= HedgeVenues.label(hedge_venue) %>
                </span>
              <% end %>
            <% else %>
              <span class="text-gray-500">-</span>
            <% end %>
          </td>
          <td class="p-4 text-center">
            <% if dashboard_snapshot&.stale_now? %>
              <span class="inline-block px-2 py-1 rounded-full text-xs font-medium bg-yellow-900/50 text-yellow-300 border border-yellow-800">Stale</span>
            <% elsif dashboard_snapshot %>
              <span class="inline-block px-2 py-1 rounded-full text-xs font-medium bg-green-900/50 text-green-300 border border-green-800"><%= dashboard_snapshot.refresh_status %></span>
            <% else %>
              <span class="inline-block px-2 py-1 rounded-full text-xs font-medium bg-gray-800 text-gray-500 border border-gray-700">Not refreshed</span>
            <% end %>
            <% if dashboard_snapshot&.inside_tolerance == true %>
              <div class="mt-1 text-xs text-green-300">In tolerance</div>
            <% elsif dashboard_snapshot&.inside_tolerance == false %>
              <div class="mt-1 text-xs text-yellow-300">Out of tolerance</div>
            <% end %>
          </td>
          <td class="p-4 text-right">
            <div class="flex flex-col items-end gap-2">
              <% unless position.active? %>
                <%= button_to "Make active", activate_position_path(position), method: :post, class: "rounded bg-blue-600 px-3 py-1 text-xs font-medium text-white hover:bg-blue-500" %>
              <% end %>
              <% if position.active? %>
                <%= button_to "Archive", archive_position_path(position), method: :post, class: "rounded bg-gray-800 px-3 py-1 text-xs font-medium text-gray-100 hover:bg-gray-700", form: { data: { turbo_confirm: "Archive this app record only? This does not close the on-chain LP or any perps." } } %>
              <% end %>
              <%= link_to "Open", position_path(position, hedge_venue: hedge_venue), class: "text-xs text-blue-400 hover:text-blue-300" %>
            </div>
          </td>
        </tr>
      <% end %>
      <% if @positions.empty? %>
        <tr>
          <td colspan="9" class="p-8 text-center text-gray-500">No positions found.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
