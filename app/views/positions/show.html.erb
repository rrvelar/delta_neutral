            <span class="rounded-full border border-green-800 bg-green-950/60 px-3 py-1 text-xs font-semibold text-green-300">Active production position</span>
          <% else %>
            <span class="rounded-full border border-gray-700 bg-gray-950 px-3 py-1 text-xs font-semibold text-gray-300">Archived app record</span>
          <% end %>
          <% if snapshot_margin_label != "Unavailable" %>
            <span class="rounded-full border border-gray-700 bg-gray-950 px-3 py-1 text-xs font-semibold text-gray-200"><%= snapshot_margin_label %></span>
          <% end %>
          <span class="rounded-full border <%= selected_live_enabled ? 'border-green-800 bg-green-950/60 text-green-300' : 'border-yellow-800 bg-yellow-950/60 text-yellow-200' %> px-3 py-1 text-xs font-semibold"><%= live_status_label %></span>
          <span class="rounded-full border <%= auto_gate_enabled ? 'border-green-800 bg-green-950/60 text-green-300' : 'border-gray-700 bg-gray-950 text-gray-300' %> px-3 py-1 text-xs font-semibold"><%= auto_operational_label %></span>
          <span class="rounded-full border <%= rebalance_needed.nil? ? 'border-gray-700 bg-gray-950 text-gray-300' : (rebalance_needed ? 'border-red-800 bg-red-950/60 text-red-200' : 'border-green-800 bg-green-950/60 text-green-300') %> px-3 py-1 text-xs font-semibold"><%= tolerance_label %></span>
          <span class="rounded-full border <%= signer_label == 'OK' ? 'border-green-800 bg-green-950/60 text-green-300' : 'border-gray-700 bg-gray-950 text-gray-300' %> px-3 py-1 text-xs font-semibold">Signer: <%= signer_label %></span>
        </div>
        <% if aerodrome %>
          <details class="mt-4 rounded-xl border border-gray-800 bg-gray-950/60 p-3">
            <summary class="cursor-pointer text-sm font-semibold text-gray-200">Advanced / manual controls</summary>
            <div class="mt-3 grid grid-cols-1 gap-3 text-sm md:grid-cols-3">
              <div><p class="text-xs text-gray-500">Manual UI selected venue</p><p class="text-white"><%= selected_venue_name %></p></div>
              <div><p class="text-xs text-gray-500">Manual live gate</p><p class="text-white"><%= live_status_label %></p></div>
              <div><p class="text-xs text-gray-500">Manual auto setting</p><p class="text-white"><%= auto_operational_label %></p></div>
            </div>
            <p class="mt-2 text-xs text-gray-500">These controls affect manual dashboard views only. Production runner venue above remains authoritative while 24/7 random rotation is active.</p>
          </details>
        <% end %>
      </div>
      <div class="flex flex-wrap gap-3">
        <% if aerodrome %>
          <% unless @position.active? %>
            <%= button_to "Make Active Production Position", activate_position_path(@position), method: :post, class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-blue-500" %>
          <% end %>
          <% if @position.active? %>
            <%= button_to "Archive App Record", archive_position_path(@position), method: :post, class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-gray-100 transition hover:bg-gray-700", form: { data: { turbo_confirm: "Archive this app record only? This does not close the on-chain LP or any perps." } } %>
          <% end %>
          <%= button_to "Refresh Read-only Data", sync_now_position_path(@position), method: :post, class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-gray-100 transition hover:bg-gray-700" %>
          <% proposal_button_path = @latest_aerodrome_hedge_proposal ? regenerate_position_aerodrome_hedge_proposals_path(@position) : position_aerodrome_hedge_proposals_path(@position) %>
          <% proposal_button_label = @latest_aerodrome_hedge_proposal ? "Regenerate Manual Hedge Proposal" : "Generate Manual Hedge Proposal" %>
          <%= button_to proposal_button_label, proposal_button_path, method: :post, class: "rounded-lg border border-yellow-800 bg-yellow-950/50 px-4 py-2 text-sm font-medium text-yellow-100 transition hover:bg-yellow-900/70" %>
        <% elsif @position.hedge %>
          <%= button_to "Sync Now", sync_now_position_path(@position), method: :post, class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-gray-100 transition hover:bg-gray-700" %>
          <%= link_to "View Hedge", hedge_path(@position.hedge), class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-gray-100 transition hover:bg-gray-700" %>
        <% else %>
          <%= button_to "Sync Now", sync_now_position_path(@position), method: :post, class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-gray-100 transition hover:bg-gray-700" %>
          <%= link_to "Create Hedge", new_hedge_path(position_id: @position.id), class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-gray-100 transition hover:bg-gray-700" %>
        <% end %>
      </div>
    </div>
  </section>

  <% if aerodrome %>
    <nav class="sticky top-0 z-10 -mx-4 border-y border-gray-800 bg-gray-950/95 px-4 py-3 backdrop-blur sm:mx-0 sm:rounded-xl sm:border">
      <div class="flex gap-2 overflow-x-auto text-sm">
        <% nav_tabs = if random_production_running
          [
            [ "Overview", "overview" ],
            [ "Accounting", "accounting" ],
            [ "Diagnostics", "diagnostics" ],
            [ "Settings", "settings" ]
          ]
        else
          [
            [ "Overview", "overview" ],
            [ "Hedge", "hedge" ],
            [ "Migration", "migration" ],
            [ "Routes", "routes" ],
            [ "Accounting", "accounting" ],
            [ "Diagnostics", "diagnostics" ],
            [ "Settings", "settings" ]
          ]
        end %>
        <% nav_tabs.each do |label, tab| %>
          <% tab_url = tab == "settings" ? edit_settings_path(anchor: "risk-settings") : position_path(@position, hedge_venue: selected_venue, tab: tab) %>
          <% active = position_tab == tab %>
          <a href="<%= tab_url %>" class="whitespace-nowrap rounded-lg border px-3 py-2 <%= active ? 'border-blue-700 bg-blue-950/60 text-blue-100' : 'border-gray-800 bg-gray-900 text-gray-200 hover:bg-gray-800' %>"><%= label %></a>
        <% end %>
        <% if random_production_running %>
          <span class="whitespace-nowrap rounded-lg border border-gray-800 bg-gray-950 px-3 py-2 text-gray-500">Hedge / Migration / Routes in Diagnostics</span>
        <% end %>
      </div>
    </nav>

    <section id="overview" class="grid grid-cols-1 gap-4 lg:grid-cols-4">
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-4">
        <p class="text-xs uppercase tracking-wide text-gray-500">LP Position</p>
        <p class="mt-2 text-lg font-semibold text-white"><%= @position.asset0 %>/<%= @position.asset1 %></p>
        <p class="mt-1 text-xs text-gray-500"><%= @position.active? ? "Active production position" : "Inactive / archived" %> · <%= @position.external_id %></p>
        <p class="mt-3 text-sm text-gray-300"><%= format_venue_eth_amount(@position.asset0_amount) %> WETH · <%= amount_display(@position.asset1_amount, precision: 2) %> USDC</p>
      </div>
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-4">
        <p class="text-xs uppercase tracking-wide text-gray-500">Hedge Target</p>
        <p class="mt-2 text-lg font-semibold text-white"><%= production_eth_value.call(production_target_short, "not loaded yet - cached target missing") %> target</p>
        <p class="mt-1 text-xs text-gray-500">Current <%= production_eth_value.call(production_active_short, "not loaded yet - cached direct short missing") %> · drift <%= production_drift_eth.present? ? format_venue_eth_amount(production_drift_eth) : "not loaded yet" %> · tolerance <%= production_tolerance_eth.present? ? format_venue_eth_amount(production_tolerance_eth) : "not loaded yet" %></p>
      </div>
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-4">
        <p class="text-xs uppercase tracking-wide text-gray-500">Production runner venue</p>
        <p class="mt-2 text-lg font-semibold text-white"><%= production_truth_venue_name %></p>
        <p class="mt-1 text-xs text-gray-500">Manual UI selected venue is in Advanced / manual controls.</p>
      </div>
      <div class="rounded-xl border <%= selected_action_blockers.present? || risk_cap_blocked || risk_order_blocked ? 'border-yellow-800 bg-yellow-950/20' : 'border-gray-800 bg-gray-900' %> p-4">
        <p class="text-xs uppercase tracking-wide text-gray-500">Next Action</p>
        <p class="mt-2 text-lg font-semibold text-white"><%= recommended_action_key.to_s.humanize %></p>
        <p class="mt-1 text-xs text-gray-500">Requested <%= format_venue_eth_amount(risk_requested_size) %> ETH · <%= selected_action_blockers.first || (risk_cap_blocked ? "Blocked by risk limit" : "Preview available") %></p>
      </div>
    </section>
  <% end %>

  <% if aerodrome %>
    <section class="grid grid-cols-1 gap-3 lg:grid-cols-4<%= tab_class.call('overview') %>">
      <% [
        [ "Production venue", cached_snapshot[:production_venue_name] || selected_venue_name, "Selected hedge execution venue" ],
        [ "Hedge status", tolerance_label, target_eth_short.present? && current_short_eth.present? ? "Target/current computed from latest known data" : "Current short unknown" ],
        [ "Auto", auto_operational_label, auto_gate_enabled ? "Continuous auto gate enabled" : "Continuous auto gate off" ],
        [ "Signer", signer_label, cached_snapshot.dig(:signer_status, :source).presence || "No cached signer health" ]
      ].each do |label, value, detail| %>
        <div class="rounded-xl border border-gray-800 bg-gray-900 p-4">
          <p class="text-xs uppercase tracking-wide text-gray-500"><%= label %></p>
          <p class="mt-2 text-xl font-semibold text-white"><%= value %></p>
          <p class="mt-1 break-words text-xs text-gray-500"><%= detail %></p>
        </div>
      <% end %>
    </section>

    <% health_reason = nil %>
    <% health_status = if extended_readiness_loaded && extended_auto_readiness[:target_short_eth].blank?
      health_reason = "fresh exposure unavailable"
      "BLOCKED"
    elsif canonical_extended_readiness && extended_auto_readiness[:within_tolerance] == true
      health_reason = "inside tolerance"
      "HEALTHY"
    elsif extended_readiness_has_target_current && extended_auto_readiness[:action_suppressed_reason].present?
      health_reason = extended_auto_readiness[:action_suppressed_reason]
      "WATCH"
    elsif extended_readiness_has_target_current && extended_auto_readiness[:auto_can_act] == true
      health_reason = "auto_can_act=true"
      "ACTION PENDING"
    elsif extended_readiness_loaded && Array(extended_auto_readiness[:blockers]).any? { |blocker| blocker.to_s.include?("EXTENDED_AUTO_REBALANCE_ENABLED") || blocker.to_s.include?("EXTENDED_LIVE_ENABLED") }
      health_reason = Array(extended_auto_readiness[:blockers]).find { |blocker| blocker.to_s.include?("EXTENDED_AUTO_REBALANCE_ENABLED") || blocker.to_s.include?("EXTENDED_LIVE_ENABLED") }
      "BLOCKED"
    elsif extended_readiness_loaded && Array(extended_auto_readiness[:blockers]).present?
      health_reason = Array(extended_auto_readiness[:blockers]).first
      "BLOCKED"
    else
      health_reason = production_health[:reason]
      production_health[:status].presence || "UNKNOWN"
    end %>
    <% health_class = case health_status
    when "HEALTHY" then "border-green-800 bg-green-950/50 text-green-200"
    when "WATCH" then "border-yellow-800 bg-yellow-950/50 text-yellow-100"
    when "ACTION PENDING" then "border-indigo-800 bg-indigo-950/50 text-indigo-100"
    when "ACTION REQUIRED", "BLOCKED" then "border-red-800 bg-red-950/50 text-red-100"
    else "border-gray-700 bg-gray-950 text-gray-300"
    end %>
    <section class="rounded-2xl border border-gray-800 bg-gray-900/80 p-5<%= tab_class.call('overview') %>">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
        <div>
          <p class="text-xs uppercase tracking-wide text-gray-500">Production Health</p>
          <h2 class="mt-1 text-lg font-semibold text-white">Extended hedge bot status</h2>
          <p class="mt-1 text-sm text-gray-400">Current Extended auto readiness is the production truth. Rebalance rows and migration previews are history only.</p>
        </div>
        <span class="rounded-full border px-3 py-1 text-xs font-semibold <%= health_class %>"><%= health_status %></span>
      </div>
      <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-4">
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4">
          <p class="text-xs text-gray-500">Live venue exposure</p>
          <p class="mt-1 text-white"><%= production_health[:production_venue_name].presence || cached_snapshot[:production_venue_name] || selected_venue_name %> · <%= format_venue_eth_amount(canonical_extended_readiness ? current_short_eth : production_health.dig(:exposure, :extended_short_eth) || current_short_eth) %> ETH</p>
          <p class="mt-1 text-xs text-gray-500">Target <%= format_venue_eth_amount(canonical_extended_readiness ? target_eth_short : production_health.dig(:exposure, :target_short_eth) || target_eth_short) %> ETH</p>
        </div>
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4">
          <p class="text-xs text-gray-500">Conflict checks</p>
          <p class="mt-1 text-white">Ethereal <%= production_health.dig(:exposure, :ethereal_status).presence || "unknown" %> · Nado <%= production_health.dig(:exposure, :nado_status).presence || "unknown" %></p>
          <p class="mt-1 text-xs text-gray-500">Open orders <%= production_health.dig(:exposure, :open_orders_count_extended).nil? ? "unknown" : production_health.dig(:exposure, :open_orders_count_extended) %></p>
        </div>
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4">
          <p class="text-xs text-gray-500">Snapshot refresh</p>
          <p class="mt-1 text-white"><%= production_health.dig(:snapshot, :age_seconds).nil? ? "not refreshed" : "#{production_health.dig(:snapshot, :age_seconds)}s ago" %></p>
          <p class="mt-1 text-xs text-gray-500">position <%= production_health.dig(:snapshot, :refresh_status).presence || "unknown" %> · rewards <%= production_health.dig(:rewards_snapshot, :status).presence || "missing" %> · accounting <%= production_health.dig(:accounting_snapshot, :status).presence || "missing" %></p>
        </div>
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4">
          <p class="text-xs text-gray-500">Auto / signer</p>
          <p class="mt-1 text-white"><%= production_health.dig(:auto, :extended_auto_enabled) ? "Auto enabled" : "Auto off" %> · signer <%= production_health.dig(:signer, :status).presence || "unknown" %></p>
          <p class="mt-1 text-xs text-gray-500">Last success <%= production_health.dig(:last_successful_rebalance, :id) ? "##{production_health.dig(:last_successful_rebalance, :id)}" : "none" %></p>
        </div>
      </div>
      <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-3">
        <% latest_health_rebalance = production_health[:latest_rebalance] || {} %>
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4">
          <p class="text-xs text-gray-500">Latest Extended rebalance</p>
          <p class="mt-1 text-white"><%= latest_health_rebalance[:id] ? "##{latest_health_rebalance[:id]} · #{latest_health_rebalance[:status]}" : "No Extended action history" %></p>
          <p class="mt-1 text-xs text-gray-500"><%= latest_health_rebalance[:old_short_size] || "—" %> → <%= latest_health_rebalance[:new_short_size] || "—" %> ETH</p>
        </div>
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4">
          <p class="text-xs text-gray-500">24h action count</p>
          <p class="mt-1 text-white">pending <%= production_health[:pending_count_last_24h] || 0 %> · failed <%= production_health[:failed_count_last_24h] || 0 %></p>
          <p class="mt-1 text-xs text-gray-500">Duplicate risk <%= production_health[:duplicate_risk_detected] ? "detected" : "clear" %></p>
        </div>
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4">
          <p class="text-xs text-gray-500">Auto decision</p>
          <% canonical_auto_decision = if extended_readiness_has_target_current
            extended_auto_readiness[:auto_can_act] == true ? "Auto can act" : (extended_auto_readiness[:action_suppressed_reason].presence || extended_action_label)
          else
            production_health[:auto_should_act] ? "Auto should act" : (production_health[:auto_should_be_waiting] ? "Auto should wait" : "Unknown")
          end %>
          <p class="mt-1 text-white"><%= canonical_auto_decision %></p>
          <p class="mt-1 text-xs text-gray-500">Inside tolerance <%= canonical_extended_readiness ? extended_auto_readiness[:within_tolerance] : (production_health.dig(:exposure, :inside_tolerance).nil? ? "unknown" : production_health.dig(:exposure, :inside_tolerance)) %></p>
        </div>
      </div>
      <% health_messages = (Array(health_reason) + Array(production_health[:action_required]) + Array(production_health[:warnings]) + Array(extended_auto_readiness[:action_suppressed_reason])).compact.uniq %>
      <% if health_messages.any? %>
        <div class="mt-4 rounded-xl border <%= production_health[:action_required].present? ? 'border-red-900 bg-red-950/20' : 'border-yellow-900 bg-yellow-950/20' %> p-4">
          <p class="text-sm font-semibold <%= production_health[:action_required].present? ? 'text-red-100' : 'text-yellow-100' %>"><%= production_health[:action_required].present? ? "Operator attention" : "Watch items" %></p>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm <%= production_health[:action_required].present? ? 'text-red-100' : 'text-yellow-100' %>">
            <% health_messages.first(6).each do |message| %><li class="break-words"><%= message %></li><% end %>
          </ul>
        </div>
      <% end %>
    </section>

    <section class="rounded-2xl border border-gray-800 bg-gray-900/80 p-5<%= tab_class.call('overview') %>">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs uppercase tracking-wide text-gray-500">Venue Exposure Summary</p>
          <h2 class="mt-1 text-lg font-semibold text-white">Latest-known short exposure</h2>
        </div>
        <p class="text-xs text-gray-500">Persisted dashboard snapshot; live diagnostics load separately.</p>
      </div>
      <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-3">
        <% %i[extended ethereal nado].each do |venue_key| %>
          <% state = cached_venue_states[venue_key] || {} %>
          <% stale = state[:stale_as_of] %>
          <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-xs uppercase tracking-wide text-gray-500"><%= state[:venue_name] || HedgeVenues.label(venue_key.to_s) %></p>
                <p class="mt-2 text-xl font-semibold text-white"><%= state[:short_size_eth].present? ? "#{format_venue_eth_amount(state[:short_size_eth])} ETH" : "Unknown" %></p>
              </div>
              <span class="rounded-full border <%= state[:status] == 'flat' ? 'border-green-800 bg-green-950/60 text-green-300' : (state[:status].in?([ 'active', 'short' ]) ? 'border-indigo-800 bg-indigo-950/60 text-indigo-200' : 'border-gray-700 bg-gray-950 text-gray-300') %> px-2 py-1 text-xs"><%= state[:status].presence || "unknown" %></span>
            </div>
            <dl class="mt-3 space-y-1 text-xs">
              <div class="flex justify-between gap-3"><dt class="text-gray-500">Notional</dt><dd class="text-white"><%= format_venue_usd_amount(state[:notional_usd]) %></dd></div>
              <div class="flex justify-between gap-3"><dt class="text-gray-500">Leverage</dt><dd class="text-white"><%= state[:leverage].present? ? "#{state[:leverage]}x" : "not loaded yet - snapshot lacks leverage" %></dd></div>
              <% if venue_key == :extended %>
                <div class="flex justify-between gap-3"><dt class="text-gray-500">Mark</dt><dd class="text-white"><%= format_venue_usd_amount(state[:mark_price]) %></dd></div>
                <div class="flex justify-between gap-3"><dt class="text-gray-500">Open orders</dt><dd class="text-white"><%= state[:open_orders_count].nil? ? "not loaded yet - snapshot lacks open-order count" : state[:open_orders_count] %></dd></div>
              <% end %>
              <div class="flex justify-between gap-3"><dt class="text-gray-500">Latest action</dt><dd class="text-white"><%= state[:latest_status].presence || "none" %></dd></div>
            </dl>
            <p class="mt-3 break-words text-xs text-gray-500"><%= stale ? "snapshot as of #{l(stale, format: :short)} from #{state[:source]}" : "Snapshot not refreshed." %></p>
          </div>
        <% end %>
      </div>
      <div class="mt-4 rounded-xl border border-gray-800 bg-gray-950/60 p-4 text-sm">
        <div class="grid grid-cols-1 gap-3 md:grid-cols-4">
          <div><p class="text-xs text-gray-500">Combined short</p><p class="text-white"><%= format_venue_eth_amount(cached_snapshot[:combined_short_eth]) %> ETH</p></div>
          <div><p class="text-xs text-gray-500">Target short</p><p class="text-white"><%= format_venue_eth_amount(target_eth_short) %> ETH</p></div>
          <div><p class="text-xs text-gray-500">Selected drift</p><p class="text-white"><%= format_venue_eth_amount(drift_eth) %> ETH</p></div>
          <div><p class="text-xs text-gray-500">Migration</p><p class="text-white"><%= cached_snapshot.dig(:migration_status, :label).presence || "Not active" %></p></div>
        </div>
      </div>
    </section>

    <% migration_plan = @migration_control_plan || {} %>
    <% latest_migration_receipt = @latest_hedge_migration_receipt || {} %>
    <% latest_daily_random_rotation_receipt = @latest_daily_random_rotation_receipt || {} %>
    <% random_rotation_virtual_state = @random_rotation_virtual_state || {} %>
    <% auto_migration_decision = @auto_migration_decision || {} %>
    <% live_autopilot_readiness = @live_autopilot_readiness || {} %>
    <% migration_from_default = migration_plan[:from_venue].presence || cached_snapshot[:production_venue].presence || selected_venue %>
    <% migration_to_default = migration_plan[:to_venue].presence || (migration_from_default == "extended" ? "ethereal" : "extended") %>
    <% route_matrix_routes = Array((@migration_route_matrix || {})[:routes]) %>
    <% next_canary_route = Array(live_autopilot_readiness[:live_autopilot_blocked_routes]).find { |route| route[:live_path_implemented] } || route_matrix_routes.find { |route| route[:live_path_implemented] } %>
    <% nado_routes = route_matrix_routes.select { |route| [ route[:from_venue], route[:to_venue] ].include?("nado") } %>
    <% ops_verdict = if health_status == "HEALTHY"
      "OK_TO_OPERATE"
    elsif health_status == "WATCH"
      "WATCH"
    elsif health_status == "ACTION PENDING"
      "MANUAL_ACTION_REQUIRED"
    else
      "BLOCKED"
    end %>
    <section id="migration" class="rounded-2xl border border-gray-800 bg-gray-900/80 p-5<%= tab_class.call('migration') %>">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
        <div>
          <p class="text-xs uppercase tracking-wide text-gray-500">Operations / Migration Safety</p>
          <h2 class="mt-1 text-lg font-semibold text-white">Current production and migration gates</h2>
          <p class="mt-1 text-sm text-gray-400">Read-only operator summary. Readiness panels do not submit orders or create signatures.</p>
        </div>
        <span class="rounded-full border <%= ops_verdict == 'OK_TO_OPERATE' ? 'border-green-800 bg-green-950/60 text-green-300' : (ops_verdict == 'WATCH' ? 'border-yellow-800 bg-yellow-950/50 text-yellow-100' : 'border-red-800 bg-red-950/50 text-red-100') %> px-3 py-1 text-xs font-semibold"><%= ops_verdict %></span>
      </div>
      <div class="mt-4 grid grid-cols-1 gap-3 lg:grid-cols-4">
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4">
          <p class="text-xs text-gray-500">Production hedge loop</p>
          <p class="mt-1 text-white"><%= cached_snapshot[:production_venue_name] || selected_venue_name %> · <%= health_status %></p>
          <p class="mt-1 break-words text-xs text-gray-500">Exposure <%= extended_auto_readiness[:exposure_source].presence || @position.mellow_metadata_hash["exposure_source"].presence || "unavailable" %> · <%= extended_auto_readiness[:target_source].presence || "target source unavailable" %></p>
          <p class="mt-1 text-xs text-gray-500">Method <%= @position.mellow_metadata_hash["successful_method"].presence || extended_auto_readiness[:successful_method].presence || "unavailable" %></p>
        </div>
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4">
          <p class="text-xs text-gray-500">Target / drift</p>
          <p class="mt-1 text-white">Target <%= format_venue_eth_amount(target_eth_short) %> · Extended <%= format_venue_eth_amount(current_short_eth) %> ETH</p>
          <p class="mt-1 text-xs text-gray-500">Drift <%= format_venue_eth_amount(drift_eth) %> / tolerance <%= format_venue_eth_amount(tolerance_eth) %></p>
          <p class="mt-1 text-xs text-gray-500">Planned <%= extended_action_label %></p>
        </div>
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4">
          <p class="text-xs text-gray-500">Anti-churn / emergency</p>
          <p class="mt-1 text-white"><%= extended_auto_readiness[:action_suppressed_reason].present? ? "WATCH" : (inside_tolerance == true ? "Not needed: inside tolerance" : "Manual recovery only") %></p>
          <p class="mt-1 text-xs text-gray-500">Min <%= extended_auto_readiness[:min_rebalance_size_eth].presence || "0.03" %> ETH / $<%= extended_auto_readiness[:min_rebalance_notional_usd].presence || "50" %> · cooldown <%= extended_auto_readiness[:cooldown_remaining_seconds].presence || 0 %>s</p>
          <p class="mt-1 text-xs text-gray-500">Confirmations <%= extended_auto_readiness[:consecutive_outside_tolerance_count].presence || 0 %>/<%= extended_auto_readiness[:consecutive_outside_tolerance_required].presence || 2 %> · strong drift <%= extended_auto_readiness[:strong_drift_bypass_used] ? "yes" : "no" %></p>
        </div>
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4">
          <p class="text-xs text-gray-500">Migration / autopilot gates</p>
          <p class="mt-1 text-white">Migration live <%= live_autopilot_readiness[:live_migration_enabled] ? "enabled" : "disabled" %> · random live <%= live_autopilot_readiness[:live_autopilot_enabled] ? "enabled" : "disabled" %></p>
          <p class="mt-1 text-xs text-gray-500">Source-first locked by default · target-first recommended</p>
          <p class="mt-1 text-xs text-gray-500">Next canary <%= next_canary_route ? "#{HedgeVenues.label(next_canary_route[:from_venue])}->#{HedgeVenues.label(next_canary_route[:to_venue])}" : "none" %></p>
          <p class="mt-1 text-xs text-gray-500">Nado live <%= nado_routes.any? { |route| route[:live_path_implemented] } ? "implemented" : "blocked / unproven" %></p>
        </div>
      </div>
      <% ops_blockers = (Array(health_reason) + Array(next_canary_route&.fetch(:blockers, [])) + Array(live_autopilot_readiness[:nado_live_blockers])).compact.uniq.first(6) %>
      <% if ops_blockers.present? && ops_verdict != "OK_TO_OPERATE" %>
        <ul class="mt-4 list-disc space-y-1 pl-5 text-sm text-yellow-100">
          <% ops_blockers.each do |blocker| %><li class="break-words"><%= blocker %></li><% end %>
        </ul>
      <% end %>
    </section>
    <section class="rounded-2xl border border-gray-800 bg-gray-900/80 p-5<%= tab_class.call('migration', 'routes') %>">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
        <div>
          <p class="text-xs uppercase tracking-wide text-gray-500">Migration Control Center</p>
          <h2 class="mt-1 text-lg font-semibold text-white"><%= random_production_running ? "24/7 Production Runner is active" : "Manual hedge venue migration" %></h2>
          <p class="mt-1 text-sm text-gray-400"><%= random_production_running ? "Manual migration controls are disabled unless the production runner is stopped. The compact runner state above is the production truth." : "Disabled unless manually gated. Preview uses persisted route data and does not override current production runner readiness." %></p>
        </div>
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 px-4 py-3 text-sm">
          <p class="text-gray-500">Active migration status</p>
          <p class="mt-1 text-white"><%= cached_snapshot.dig(:migration_status, :label).presence || "Not active" %></p>
        </div>
      </div>

      <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-4">
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4"><p class="text-xs text-gray-500">Production runner venue</p><p class="mt-1 text-white"><%= production_truth_venue_name %></p></div>
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4"><p class="text-xs text-gray-500">Preview route</p><p class="mt-1 text-white"><%= HedgeVenues.label(migration_plan[:from_venue]) %> → <%= HedgeVenues.label(migration_plan[:to_venue]) %></p></div>
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4"><p class="text-xs text-gray-500">Manual UI selected venue</p><p class="mt-1 text-white"><%= selected_venue_name %></p></div>
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4"><p class="text-xs text-gray-500">Tolerance</p><p class="<%= inside_tolerance.nil? ? 'text-gray-300' : (inside_tolerance ? 'text-green-300' : 'text-red-300') %> mt-1"><%= inside_tolerance.nil? ? "Unknown" : (inside_tolerance ? "Inside tolerance" : "Outside tolerance") %></p></div>
      </div>
      <div class="mt-3 rounded-xl border border-yellow-900 bg-yellow-950/20 p-3 text-sm text-yellow-100">
        Preview does not switch the production hedge venue. Production remains <%= cached_snapshot[:production_venue_name] || HedgeVenues.label(@position.hedge&.execution_venue) %> until a live migration completes and final readback allows finalize.
      </div>

      <% if production_route_ready || random_production_running %>
        <details class="mt-4 rounded-xl border border-gray-800 bg-gray-950/60 p-4">
          <summary class="cursor-pointer text-sm font-semibold text-white">Advanced / legacy diagnostics: setup wizard and route matrix are diagnostic only</summary>
          <p class="mt-2 text-xs text-gray-400">Production runner status and route proofs above are authoritative for 24/7 operation.</p>
          <%= render "random_rotation_setup", position: @position, setup: @random_rotation_setup, production_runner: @random_production_runner_status %>
        </details>
      <% else %>
        <%= render "random_rotation_setup", position: @position, setup: @random_rotation_setup, production_runner: @random_production_runner_status %>
      <% end %>

      <% random_production_tail_visible = ActiveModel::Type::Boolean.new.cast(params[:show_random_production_tail]) %>
      <% daily_coverage_venues = %w[extended ethereal nado] %>
      <% current_policy_venue = HedgeVenues.normalize(random_production[:current_production_venue] || @position.hedge&.execution_venue) %>
      <% next_policy_target = daily_coverage_venues[(daily_coverage_venues.index(current_policy_venue).to_i + 1) % daily_coverage_venues.size] %>
      <div class="mt-4 rounded-xl border border-gray-800 bg-gray-950/60 p-4">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
          <div>
            <p class="text-xs uppercase tracking-wide text-gray-500">Production Random Runner</p>
            <h3 class="mt-1 text-base font-semibold text-white">24/7 random rotation control</h3>
            <p class="mt-1 text-xs text-gray-400">Dashboard controls submit systemd start/stop requests only. The web request does not run the production loop. Policy: 3 migrations/day with 5-minute hold checks.</p>
            <% if random_production_running %>
              <p class="mt-2 rounded-lg border border-green-900 bg-green-950/30 px-3 py-2 text-xs text-green-100">Already running. Use Stop Safely only if needed.</p>
            <% end %>
          </div>
          <span class="rounded-full border <%= random_production_status == 'running' ? 'border-green-800 bg-green-950/60 text-green-300' : (random_production_status.in?([ 'blocked', 'stale lock' ]) ? 'border-red-800 bg-red-950/50 text-red-100' : 'border-gray-700 bg-gray-900 text-gray-300') %> px-3 py-1 text-xs font-semibold"><%= random_production_status %></span>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-4">
          <div><p class="text-xs text-gray-500">Current venue</p><p class="text-white"><%= random_production[:current_production_venue].present? ? HedgeVenues.label(random_production[:current_production_venue]) : "unknown" %></p></div>
          <div><p class="text-xs text-gray-500">Target short ETH</p><p class="text-white"><%= format_venue_eth_amount(random_production[:target_short_eth]) %></p></div>
          <div><p class="text-xs text-gray-500">Combined short ETH</p><p class="text-white"><%= format_venue_eth_amount(random_production[:combined_short_eth]) %></p></div>
          <div><p class="text-xs text-gray-500">Inside tolerance</p><p class="<%= random_production[:inside_tolerance] == true ? 'text-green-300' : (random_production[:inside_tolerance] == false ? 'text-red-300' : 'text-gray-300') %>"><%= random_production[:inside_tolerance].nil? ? "unknown" : random_production[:inside_tolerance].to_s %></p></div>
          <div><p class="text-xs text-gray-500">Last route</p><p class="text-white"><%= random_production[:last_route].presence || "none" %></p></div>
          <div><p class="text-xs text-gray-500">Last cycle</p><p class="text-white"><%= random_production[:last_cycle].presence || "none" %></p></div>
          <div><p class="text-xs text-gray-500">Last hold check</p><p class="text-white"><%= random_production[:last_hold_check].presence || "none" %></p></div>
          <div><p class="text-xs text-gray-500">Heartbeat</p><p class="text-white"><%= random_production[:heartbeat_updated_at].presence || "none" %></p></div>
          <div><p class="text-xs text-gray-500">Lock pid</p><p class="text-white"><%= random_production[:lock_pid].presence || "none" %></p></div>
          <div><p class="text-xs text-gray-500">Open orders zero</p><p class="<%= random_production[:open_orders_zero] ? 'text-green-300' : 'text-red-300' %>"><%= random_production[:open_orders_zero] ? "true" : "false" %></p></div>
          <% route_summary = random_production[:route_proofs_summary] || {} %>
          <div><p class="text-xs text-gray-500">Route proofs</p><p class="text-white"><%= route_summary[:missing_cache] || route_summary["missing_cache"] ? "cache missing" : "ready #{route_summary[:ready] || route_summary['ready']} / total #{route_summary[:total] || route_summary['total']} · missing #{route_summary[:missing] || route_summary['missing'] || 0} · stale #{route_summary[:stale] || route_summary['stale'] || 0}" %></p></div>
          <div><p class="text-xs text-gray-500">Migration policy</p><p class="text-white">3/day · interval 28800s · hold check 300s</p></div>
          <div><p class="text-xs text-gray-500">Next target venue</p><p class="text-white"><%= HedgeVenues.label(next_policy_target) %> · daily coverage policy</p></div>
          <div><p class="text-xs text-gray-500">Latest blocker</p><p class="break-words text-white"><%= random_production[:latest_blocker].presence || "none" %></p></div>
        </div>

        <% control_request = random_production[:control_request] || {} %>
        <% control_result = random_production[:control_result] || {} %>
        <% control_systemd_status = control_result["systemd_status"].is_a?(Hash) ? control_result["systemd_status"].map { |service, state| "#{service}: #{state}" }.join(", ") : control_result["systemd_status"] %>
        <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-4">
          <div><p class="text-xs text-gray-500">Control mode</p><p class="text-white"><%= random_production[:host_control_mode].presence || "unknown" %></p></div>
          <div><p class="text-xs text-gray-500">Host control</p><p class="<%= random_production[:host_control_available] ? 'text-green-300' : 'text-yellow-200' %>"><%= random_production[:host_control_available] ? "available" : "unavailable in container" %></p></div>
          <div><p class="text-xs text-gray-500">Bridge status</p><p class="<%= random_production[:bridge_status] == 'failed' ? 'text-red-300' : (random_production[:bridge_status] == 'pending' ? 'text-yellow-200' : 'text-white') %>"><%= random_production[:bridge_status].presence || "unknown" %></p></div>
          <div><p class="text-xs text-gray-500">Service status</p><p class="text-white"><%= control_systemd_status.presence || control_result["status"].presence || "unknown" %></p></div>
          <div><p class="text-xs text-gray-500">Last control request</p><p class="break-words text-white"><%= [ control_request["action"], control_request["mode"], control_request["requested_at"] ].compact.join(" · ").presence || "none" %></p></div>
          <div class="md:col-span-3"><p class="text-xs text-gray-500">Last control result</p><p class="break-words text-white"><%= [ control_result["status"], control_result["action"], control_result["mode"], control_result["handled_at"], control_result["stderr"].presence ].compact.join(" · ").presence || "none" %></p></div>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-3">
          <div class="rounded-lg border border-gray-800 bg-gray-950 p-3">
            <p class="text-xs uppercase tracking-wide text-gray-500">Direct venue shorts</p>
            <div class="mt-2 grid grid-cols-3 gap-2 text-xs">
              <% (random_production[:direct_venue_shorts] || {}).each do |venue, value| %>
                <div><span class="text-gray-500"><%= HedgeVenues.label(venue) %></span><p class="text-white"><%= format_venue_eth_amount(value) %></p></div>
              <% end %>
            </div>
          </div>
          <div class="rounded-lg border border-gray-800 bg-gray-950 p-3">
            <p class="text-xs uppercase tracking-wide text-gray-500">Direct open orders</p>
            <div class="mt-2 space-y-1 text-xs">
              <% (random_production[:direct_open_orders] || {}).each do |venue, details| %>
                <p class="text-gray-300"><%= HedgeVenues.label(venue) %>: <%= details[:status] || details["status"] || "unknown" %> <%= details[:count] || details["count"] %></p>
              <% end %>
            </div>
          </div>
          <div class="rounded-lg border border-gray-800 bg-gray-950 p-3">
            <p class="text-xs uppercase tracking-wide text-gray-500">Gates state</p>
            <div class="mt-2 space-y-1 text-xs">
              <% (random_production[:gates_state] || {}).each do |key, enabled| %>
                <p class="text-gray-300"><%= key %>: <span class="<%= enabled ? 'text-green-300' : 'text-gray-400' %>"><%= enabled ? "true" : "false" %></span></p>
              <% end %>
            </div>
          </div>
        </div>

        <% if Array(random_production[:direct_preflight_blockers]).present? %>
          <div class="mt-3 rounded-lg border border-red-900 bg-red-950/20 p-3">
            <p class="text-xs font-semibold text-red-100">Direct preflight blockers</p>
            <ul class="mt-2 list-disc space-y-1 pl-5 text-xs text-red-100">
              <% Array(random_production[:direct_preflight_blockers]).first(6).each do |blocker| %><li class="break-words"><%= blocker %></li><% end %>
            </ul>
          </div>
        <% end %>
        <% diagnostics = random_production[:dashboard_snapshot_diagnostic] || {} %>
        <% if Array(diagnostics[:blockers] || diagnostics["blockers"]).present? %>
          <div class="mt-3 rounded-lg border border-yellow-900 bg-yellow-950/20 p-3">
            <p class="text-xs font-semibold text-yellow-100">Dashboard snapshot diagnostics only</p>
            <ul class="mt-2 list-disc space-y-1 pl-5 text-xs text-yellow-100">
              <% Array(diagnostics[:blockers] || diagnostics["blockers"]).first(6).each do |blocker| %><li class="break-words"><%= blocker %></li><% end %>
            </ul>
          </div>
        <% end %>

        <div class="mt-4 grid grid-cols-1 gap-3 xl:grid-cols-3">
          <% [[ "Start 24h Canary", "canary" ], [ "Start 24/7 Production", "production" ]].each do |label, mode| %>
            <%= form_with url: random_production_start_position_path(@position), method: :post, class: "rounded-lg border border-gray-800 bg-gray-950 p-3" do |form| %>
              <%= form.hidden_field :production_runner_mode, value: mode %>
              <code class="block break-all rounded border border-gray-800 bg-black/30 p-2 text-[11px] text-gray-300"><%= MigrationRandomProductionRunner::CONFIRMATION %></code>
              <%= form.text_field :random_production_confirmation, autocomplete: "off", placeholder: MigrationRandomProductionRunner::CONFIRMATION, disabled: random_production_running, class: "mt-2 w-full rounded-lg border border-gray-700 bg-gray-950 px-2 py-2 text-xs text-white placeholder-gray-600 disabled:text-gray-600" %>
              <%= form.submit label, disabled: random_production_running, class: "mt-2 w-full rounded-lg border border-red-800 bg-red-950/70 px-3 py-2 text-xs font-semibold text-red-100 hover:bg-red-900 disabled:border-gray-800 disabled:bg-gray-900 disabled:text-gray-600" %>
            <% end %>
          <% end %>
          <div class="rounded-lg border border-gray-800 bg-gray-950 p-3">
            <%= button_to "Stop Safely", random_production_stop_position_path(@position), method: :post, class: "w-full rounded-lg bg-gray-800 px-3 py-2 text-xs font-medium text-gray-100 hover:bg-gray-700" %>
            <%= button_to "Refresh Status", random_production_refresh_position_path(@position), method: :post, class: "mt-2 w-full rounded-lg bg-gray-800 px-3 py-2 text-xs font-medium text-gray-100 hover:bg-gray-700" %>
            <%= link_to "View Tail", position_path(@position, tab: "migration", show_random_production_tail: true), class: "mt-2 block rounded-lg bg-gray-800 px-3 py-2 text-center text-xs font-medium text-gray-100 hover:bg-gray-700" %>
          </div>
        </div>

        <% if random_production_tail_visible %>
          <div class="mt-4 overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-800 text-left text-xs">
              <thead class="text-gray-500"><tr><th class="px-3 py-2">Cycle</th><th class="px-3 py-2">Route</th><th class="px-3 py-2">Status</th><th class="px-3 py-2">Orders</th><th class="px-3 py-2">Post venue</th><th class="px-3 py-2">Hold checks</th><th class="px-3 py-2">Hold span</th><th class="px-3 py-2">Hold warning</th><th class="px-3 py-2">Blockers</th></tr></thead>
              <tbody class="divide-y divide-gray-800 text-gray-300">
                <% Array(random_production[:tail_events]).last(300).each do |event| %>
                  <tr>
                    <td class="px-3 py-2"><%= event["cycle"] || "—" %></td>
                    <td class="px-3 py-2"><%= event["route"] || "—" %></td>
                    <td class="px-3 py-2"><%= event["status"] || event["event"] || "recorded" %></td>
                    <td class="px-3 py-2"><%= event.dig("execution", "orders_submitted") || event["orders_submitted"] || 0 %></td>
                    <td class="px-3 py-2"><%= event.dig("post_cycle_hedge", "production_venue") || event["final_production_venue"] || "—" %></td>
                    <td class="px-3 py-2"><%= event["hold_rebalance_checks_count"] || Array(event["hold_rebalance_checks"]).size %></td>
                    <td class="px-3 py-2"><%= event["hold_monitor_actual_span_seconds"] || "—" %></td>
                    <td class="px-3 py-2"><%= event["hold_monitor_gap_warning"] || "none" %></td>
                    <td class="px-3 py-2"><%= Array(event["blockers"]).first(2).join("; ").presence || "none" %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>

      <div class="mt-4 grid grid-cols-1 gap-4 xl:grid-cols-3">
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4 xl:col-span-2">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="text-xs uppercase tracking-wide text-gray-500">Current plan</p>
              <p class="mt-1 text-sm text-gray-300"><%= HedgeVenues.label(migration_plan[:from_venue]) %> → <%= HedgeVenues.label(migration_plan[:to_venue]) %> · <%= migration_plan[:mode].presence || "preview" %> · <%= migration_plan[:migration_sequence].to_s.tr("_", "-") %></p>
            </div>
            <span class="rounded-full border <%= migration_plan[:blockers].present? ? 'border-yellow-800 bg-yellow-950/50 text-yellow-200' : 'border-green-800 bg-green-950/60 text-green-300' %> px-3 py-1 text-xs"><%= migration_plan[:blockers].present? ? "Blocked preview" : "Preview ready" %></span>
          </div>
          <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-3">
            <div><p class="text-xs text-gray-500">Production venue</p><p class="text-white"><%= HedgeVenues.label(migration_plan[:production_venue] || @position.hedge&.execution_venue) %></p></div>
            <div><p class="text-xs text-gray-500">Preview from</p><p class="text-white"><%= HedgeVenues.label(migration_plan[:from_venue]) %></p></div>
            <div><p class="text-xs text-gray-500">Preview to</p><p class="text-white"><%= HedgeVenues.label(migration_plan[:to_venue]) %></p></div>
            <div><p class="text-xs text-gray-500">Sequence</p><p class="text-white"><%= migration_plan[:migration_sequence].to_s.tr("_", " ") %></p></div>
            <div><p class="text-xs text-gray-500">From short</p><p class="text-white"><%= format_venue_eth_amount(migration_plan[:from_short_before]) %> ETH</p></div>
            <div><p class="text-xs text-gray-500">To short</p><p class="text-white"><%= format_venue_eth_amount(migration_plan[:to_short_before]) %> ETH</p></div>
            <div><p class="text-xs text-gray-500">Current drift</p><p class="text-white"><%= format_venue_eth_amount(migration_plan[:drift_before] || drift_eth) %> ETH</p></div>
            <div><p class="text-xs text-gray-500">Temporary combined after first leg</p><p class="text-white"><%= format_venue_eth_amount(migration_plan[:temporary_combined_after_first_leg] || migration_plan[:temporary_exposure]) %> ETH</p></div>
            <div><p class="text-xs text-gray-500">Temporary risk</p><p class="text-white"><%= migration_plan[:temporary_risk_type].presence || "—" %></p></div>
            <div><p class="text-xs text-gray-500">Target venue leg</p><p class="text-white"><%= migration_plan.dig(:planned_to_leg, :side).presence || "—" %> <%= format_venue_eth_amount(migration_plan.dig(:planned_to_leg, :size_eth)) %> ETH</p></div>
            <div><p class="text-xs text-gray-500">Source venue leg</p><p class="text-white"><%= migration_plan.dig(:planned_from_leg, :side).presence || "—" %> <%= format_venue_eth_amount(migration_plan.dig(:planned_from_leg, :size_eth)) %> ETH</p></div>
            <div><p class="text-xs text-gray-500">Projected final combined</p><p class="text-white"><%= format_venue_eth_amount(migration_plan[:expected_final_combined] || migration_plan[:expected_combined_short_after]) %> ETH</p></div>
            <div><p class="text-xs text-gray-500">Projected final drift</p><p class="text-white"><%= format_venue_eth_amount(migration_plan[:expected_final_drift]) %> ETH</p></div>
            <div><p class="text-xs text-gray-500">Finalize availability</p><p class="<%= migration_plan[:finalize_available] ? 'text-green-300' : 'text-yellow-200' %>"><%= migration_plan[:finalize_available] ? "Available after live readback" : "Not available from this plan" %></p></div>
          </div>
          <% if migration_plan[:mode].to_s == "full" && inside_tolerance == false %>
            <div class="mt-4 rounded-lg border border-yellow-900 bg-yellow-950/20 p-3 text-xs text-yellow-100">
              Full migration correction: this plan targets <%= format_venue_eth_amount(migration_plan[:target_short]) %> ETH final combined exposure instead of preserving the current combined short. Temporary <%= migration_plan[:migration_sequence].to_s.tr("_", "-") %> exposure may reach <%= format_venue_eth_amount(migration_plan[:temporary_combined_after_first_leg] || migration_plan[:temporary_exposure]) %> ETH before the second leg confirms.
            </div>
          <% elsif migration_plan[:mode].to_s == "stepwise" %>
            <div class="mt-4 rounded-lg border border-yellow-900 bg-yellow-950/20 p-3 text-xs text-yellow-100">
              Stepwise migration transfers at most <%= format_venue_eth_amount(migration_plan[:max_step_size_eth]) %> ETH per run. It may preserve current combined exposure and may not correct drift unless a separate correction is planned.
            </div>
          <% end %>
          <% if migration_plan[:warnings].present? %>
            <ul class="mt-4 list-disc space-y-1 pl-5 text-xs text-yellow-100">
              <% migration_plan[:warnings].first(3).each do |warning| %><li><%= warning %></li><% end %>
            </ul>
          <% end %>
          <% if migration_plan[:blockers].present? %>
            <ul class="mt-4 list-disc space-y-1 pl-5 text-xs text-yellow-100">
              <% migration_plan[:blockers].first(4).each do |blocker| %><li><%= blocker %></li><% end %>
            </ul>
          <% end %>
        </div>

        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4">
          <p class="text-xs uppercase tracking-wide text-gray-500">Last migration receipt</p>
          <% if latest_migration_receipt.present? %>
            <p class="mt-2 text-sm text-white"><%= latest_migration_receipt["final_status"] || latest_migration_receipt["status"] || "recorded" %></p>
            <p class="mt-1 text-xs text-gray-500"><%= latest_migration_receipt["from_venue"] || latest_migration_receipt["venue"] %> → <%= latest_migration_receipt["to_venue"] || "extended" %></p>
            <p class="mt-1 text-xs text-gray-500"><%= latest_migration_receipt["timestamp"] || latest_migration_receipt["created_at"] || "time unavailable" %></p>
          <% else %>
            <p class="mt-2 text-sm text-gray-300">No generic migration receipt yet.</p>
          <% end %>
          <div class="mt-4 border-t border-gray-800 pt-3">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-xs uppercase tracking-wide text-gray-500">Random Rotation Planner</p>
                <p class="mt-1 text-sm text-gray-300">Decision-only random rotation. No economics, funding, fees, PnL, scoring, signatures, or orders.</p>
              </div>
              <%= button_to "Run virtual random rotation decision", migration_random_rotation_decision_position_path(@position), method: :post, params: { use_virtual_state: true }, class: "rounded-lg bg-gray-800 px-3 py-2 text-xs font-medium text-gray-100 hover:bg-gray-700" %>
            </div>
            <div class="mt-3 grid grid-cols-1 gap-2 text-xs md:grid-cols-2">
              <div><span class="text-gray-500">Strategy</span><p class="text-white"><%= auto_migration_decision[:strategy].presence || "random_rotation" %></p></div>
              <div><span class="text-gray-500">Production venue</span><p class="text-white"><%= HedgeVenues.label(random_rotation_virtual_state[:production_venue].presence || auto_migration_decision[:production_venue]) %></p></div>
              <div><span class="text-gray-500">Virtual current venue</span><p class="text-white"><%= HedgeVenues.label(random_rotation_virtual_state[:virtual_current_venue].presence || auto_migration_decision[:current_venue]) %></p></div>
              <div><span class="text-gray-500">Dry-run eligible targets</span><p class="text-white"><%= Array(auto_migration_decision[:eligible_target_venues]).map { |venue| HedgeVenues.label(venue) }.presence&.join(", ") || "none" %></p></div>
              <div><span class="text-gray-500">Selected route</span><p class="text-white"><%= auto_migration_decision[:selected_route].present? ? "#{HedgeVenues.label(auto_migration_decision.dig(:selected_route, :from_venue))} -> #{HedgeVenues.label(auto_migration_decision.dig(:selected_route, :to_venue))}" : "none" %></p></div>
              <div><span class="text-gray-500">Live eligible routes</span><p class="text-white"><%= Array(auto_migration_decision[:live_eligible_routes]).map { |route| "#{HedgeVenues.label(route[:from_venue])}->#{HedgeVenues.label(route[:to_venue])}" }.presence&.join(", ") || "none" %></p></div>
              <div><span class="text-gray-500">Selected route live</span><p class="text-white"><%= auto_migration_decision[:selected_route_live_available] ? "available" : "blocked" %></p></div>
              <div><span class="text-gray-500">Daily limit</span><p class="text-white"><%= auto_migration_decision.dig(:daily_limit_status, :count) || 0 %>/<%= auto_migration_decision.dig(:daily_limit_status, :max_per_day) || 1 %></p></div>
              <div><span class="text-gray-500">Cooldown</span><p class="text-white"><%= auto_migration_decision.dig(:cooldown_status, :remaining_hours).to_f.round(2) %>h remaining</p></div>
            </div>
            <% selected_to_venue = auto_migration_decision.dig(:selected_route, :to_venue) %>
            <% if selected_to_venue == "nado" && !auto_migration_decision[:selected_route_live_available] %>
                  <p class="mt-2 break-words text-xs text-yellow-200">Selected for decision-only dry-run rotation; live random migration still requires route proofs and operator gates.</p>
            <% end %>
            <p class="mt-2 text-xs text-gray-500">Live execution: blocked/gated. would_migrate=<%= auto_migration_decision[:would_migrate] ? "true" : "false" %>.</p>
            <p class="mt-1 text-xs text-gray-500">Virtual dry-run state only. Production hedge venue was not changed.</p>
            <div class="mt-3 rounded-lg border border-gray-800 bg-gray-950/80 p-3">
              <p class="text-xs uppercase tracking-wide text-gray-500">Last Daily Dry-run</p>
              <% if latest_daily_random_rotation_receipt.present? %>
                <div class="mt-2 grid grid-cols-1 gap-2 text-xs md:grid-cols-2">
                  <div><span class="text-gray-500">Time</span><p class="text-white"><%= latest_daily_random_rotation_receipt["timestamp"] || "unknown" %></p></div>
                  <div><span class="text-gray-500">Status</span><p class="text-white"><%= latest_daily_random_rotation_receipt["status"] || "recorded" %></p></div>
                  <div><span class="text-gray-500">Virtual route selected</span><p class="text-white"><%= latest_daily_random_rotation_receipt["selected_route"].present? ? "#{HedgeVenues.label(latest_daily_random_rotation_receipt.dig("selected_route", "from_venue"))}->#{HedgeVenues.label(latest_daily_random_rotation_receipt.dig("selected_route", "to_venue"))}" : "none" %></p></div>
                  <div><span class="text-gray-500">Selected target</span><p class="text-white"><%= HedgeVenues.label(latest_daily_random_rotation_receipt["selected_target_venue"]) %></p></div>
                  <div><span class="text-gray-500">Route status</span><p class="text-white"><%= latest_daily_random_rotation_receipt.dig("selected_route", "virtual_route_status") || latest_daily_random_rotation_receipt.dig("selected_route", "route_status") || "unknown" %></p></div>
                  <div><span class="text-gray-500">Production status</span><p class="text-white"><%= latest_daily_random_rotation_receipt.dig("selected_route", "production_route_status") || "unknown" %></p></div>
                  <div><span class="text-gray-500">Virtual before / after</span><p class="text-white"><%= HedgeVenues.label(latest_daily_random_rotation_receipt["virtual_current_venue_before"]) %> -> <%= HedgeVenues.label(latest_daily_random_rotation_receipt["virtual_current_venue_after"]) %></p></div>
                  <div><span class="text-gray-500">Daily enabled</span><p class="text-white"><%= latest_daily_random_rotation_receipt["daily_enabled"] ? "true" : "false" %></p></div>
                  <div><span class="text-gray-500">Orders / signatures</span><p class="text-white"><%= latest_daily_random_rotation_receipt["orders_submitted"] || 0 %> / <%= latest_daily_random_rotation_receipt["signatures_created"] || 0 %></p></div>
                </div>
                <% if latest_daily_random_rotation_receipt.dig("selected_route", "production_route_status") == "PREVIEW_BLOCKED" %>
                  <p class="mt-2 text-xs text-yellow-200">Production route remains blocked because Nado has no real source short.</p>
                <% end %>
                <% if latest_daily_random_rotation_receipt.dig("selected_route", "synthetic_source_leg_proof_required") %>
                  <p class="mt-1 text-xs text-yellow-200">Virtual dry-run allowed via synthetic Nado close proof.</p>
                <% end %>
                <p class="mt-2 break-words text-xs text-gray-500"><%= latest_daily_random_rotation_receipt["receipt_path"] %></p>
              <% else %>
                <p class="mt-2 text-xs text-gray-400">No daily random rotation dry-run receipt yet.</p>
              <% end %>
              <p class="mt-2 text-xs text-gray-500">Decision-only. No migration executed.</p>
            </div>
            <% if auto_migration_decision[:blockers].present? %>
              <p class="mt-1 break-words text-xs text-gray-500"><%= auto_migration_decision[:blockers].first %></p>
            <% end %>
            <% if auto_migration_decision[:decision_excluded_routes].present? %>
              <p class="mt-2 break-words text-xs text-gray-500">Decision excluded: <%= auto_migration_decision[:decision_excluded_routes].first(2).map { |route| "#{HedgeVenues.label(route[:from_venue])}->#{HedgeVenues.label(route[:to_venue])}: #{Array(route[:reasons]).first}" }.join("; ") %></p>
            <% end %>
            <% if auto_migration_decision[:live_blocked_routes].present? %>
              <p class="mt-2 break-words text-xs text-gray-500">Live blocked: <%= auto_migration_decision[:live_blocked_routes].first(2).map { |route| "#{HedgeVenues.label(route[:from_venue])}->#{HedgeVenues.label(route[:to_venue])}: #{Array(route[:live_blockers]).first}" }.join("; ") %></p>
            <% end %>
          </div>
        </div>
      </div>

      <div id="routes" class="mt-4 rounded-xl border border-gray-800 bg-gray-950/60 p-4<%= tab_class.call('routes', 'migration') %>">
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="text-xs uppercase tracking-wide text-gray-500">Live Autopilot Readiness</p>
            <p class="mt-1 text-sm text-gray-300">No live orders are submitted by this readiness panel.</p>
          </div>
          <p class="text-xs text-gray-500">Live enabled: <%= live_autopilot_readiness[:live_autopilot_enabled] ? "true" : "false" %></p>
        </div>
        <div class="mt-3 grid grid-cols-1 gap-2 text-xs md:grid-cols-3">
          <div><span class="text-gray-500">Production venue</span><p class="text-white"><%= HedgeVenues.label(live_autopilot_readiness[:production_venue]) %></p></div>
          <div><span class="text-gray-500">Live eligible routes</span><p class="text-white"><%= Array(live_autopilot_readiness[:live_autopilot_eligible_routes]).map { |route| "#{HedgeVenues.label(route[:from_venue])}->#{HedgeVenues.label(route[:to_venue])}" }.presence&.join(", ") || "none" %></p></div>
          <div><span class="text-gray-500">Next supervised canary</span><p class="text-white"><%= Array(live_autopilot_readiness[:live_autopilot_blocked_routes]).find { |route| route[:live_path_implemented] }&.then { |route| "#{HedgeVenues.label(route[:from_venue])}->#{HedgeVenues.label(route[:to_venue])}" } || "none" %></p></div>
        </div>
        <% if live_autopilot_readiness[:live_autopilot_blocked_routes].present? %>
          <div class="mt-3 overflow-x-auto">
            <table class="min-w-full text-left text-xs">
              <thead class="text-gray-500"><tr><th class="py-2 pr-3">Route</th><th class="py-2 pr-3">Live path</th><th class="py-2 pr-3">Canary</th><th class="py-2 pr-3">Blocker</th></tr></thead>
              <tbody class="divide-y divide-gray-800">
                <% live_autopilot_readiness[:live_autopilot_blocked_routes].first(6).each do |route| %>
                  <tr>
                    <td class="py-2 pr-3 text-white"><%= HedgeVenues.label(route[:from_venue]) %> -> <%= HedgeVenues.label(route[:to_venue]) %></td>
                    <td class="py-2 pr-3 text-gray-300"><%= route[:live_path_implemented] ? "implemented" : "not implemented" %></td>
                    <td class="py-2 pr-3 text-gray-300"><%= route[:live_canary_confirmed] ? "confirmed" : "missing" %></td>
                    <td class="py-2 pr-3 text-gray-400"><%= Array(route[:blockers]).first || "none" %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
        <% if live_autopilot_readiness[:nado_live_blockers].present? %>
          <p class="mt-3 text-xs text-yellow-200">Nado live warning: <%= live_autopilot_readiness[:nado_live_blockers].first %></p>
        <% end %>
      </div>

      <div class="mt-4 grid grid-cols-1 gap-4 xl:grid-cols-4">
        <%= form_with url: migration_preview_position_path(@position), method: :post, class: "rounded-xl border border-gray-800 bg-gray-950/60 p-4 xl:col-span-3" do |form| %>
          <div class="grid grid-cols-1 gap-3 md:grid-cols-6">
            <div>
              <%= form.label :from_venue, "From", class: "block text-xs uppercase tracking-wide text-gray-500" %>
              <%= form.select :from_venue, options_for_select([ [ "Extended", "extended" ], [ "Ethereal", "ethereal" ], [ "Nado", "nado" ] ], migration_from_default), {}, class: "mt-1 w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white" %>
            </div>
            <div>
              <%= form.label :to_venue, "To", class: "block text-xs uppercase tracking-wide text-gray-500" %>
              <%= form.select :to_venue, options_for_select([ [ "Extended", "extended" ], [ "Ethereal", "ethereal" ], [ "Nado", "nado" ] ], migration_to_default), {}, class: "mt-1 w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white" %>
            </div>
            <div>
              <%= form.label :migration_mode, "Mode", class: "block text-xs uppercase tracking-wide text-gray-500" %>
              <%= form.select :migration_mode, options_for_select([ [ "Preview", "preview" ], [ "Stepwise", "stepwise" ], [ "Full", "full" ] ], migration_plan[:mode] || "preview"), {}, class: "mt-1 w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white" %>
            </div>
            <div>
              <%= form.label :migration_sequence, "Sequence", class: "block text-xs uppercase tracking-wide text-gray-500" %>
              <%= form.select :migration_sequence, options_for_select([ [ "Target-first", "target_first" ], [ "Source-first", "source_first" ] ], migration_plan[:migration_sequence] || "target_first"), {}, class: "mt-1 w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white" %>
            </div>
            <div>
              <%= form.label :max_step_size_eth, "Max step ETH", class: "block text-xs uppercase tracking-wide text-gray-500" %>
              <%= form.text_field :max_step_size_eth, value: params[:max_step_size_eth].presence || migration_plan[:max_step_size_eth].presence || "0.01", class: "mt-1 w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white" %>
            </div>
            <div class="flex items-end">
              <label class="flex items-center gap-2 rounded-lg border border-gray-800 px-3 py-2 text-sm text-gray-300">
                <%= form.check_box :full_migration_allowed, checked: ActiveModel::Type::Boolean.new.cast(migration_plan[:full_migration_allowed]), class: "rounded border-gray-700 bg-gray-950" %>
                Full allowed
              </label>
            </div>
          </div>
          <div class="mt-3 flex flex-wrap gap-2">
            <%= form.submit "Preview migration", class: "rounded-lg bg-gray-800 px-3 py-2 text-xs font-medium text-gray-100 hover:bg-gray-700" %>
          </div>
          <div class="mt-3 grid grid-cols-1 gap-2 text-xs text-yellow-100 md:grid-cols-2">
            <p class="rounded-lg border border-yellow-900 bg-yellow-950/20 p-3">Target-first opens the target venue first, then closes the source. It avoids an unhedged window, but creates temporary overhedge.</p>
            <p class="rounded-lg border border-yellow-900 bg-yellow-950/20 p-3">Source-first closes the source venue first, then opens the target. It avoids temporary overhedge, but creates a temporary underhedged or unhedged window.</p>
          </div>
        <% end %>

        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4">
          <p class="text-xs uppercase tracking-wide text-gray-500">Manual live controls</p>
          <p class="mt-1 text-xs text-gray-400">Live is blocked unless the migration env gate, venue live gates, zero open orders, disabled auto, fresh snapshot, and exact phrase are present.</p>
          <%= form_with url: migration_run_position_path(@position), method: :post, class: "mt-3 space-y-2" do |form| %>
            <%= form.hidden_field :from_venue, value: migration_from_default %>
            <%= form.hidden_field :to_venue, value: migration_to_default %>
            <%= form.hidden_field :migration_mode, value: migration_plan[:mode].presence || "preview" %>
            <%= form.hidden_field :migration_sequence, value: migration_plan[:migration_sequence].presence || "target_first" %>
            <%= form.hidden_field :max_step_size_eth, value: params[:max_step_size_eth].presence || migration_plan[:max_step_size_eth].presence || "0.01" %>
            <%= form.hidden_field :full_migration_allowed, value: ActiveModel::Type::Boolean.new.cast(migration_plan[:full_migration_allowed]) ? "1" : "0" %>
            <code class="block break-all rounded border border-gray-800 bg-gray-950 p-2 text-[11px] text-gray-300"><%= HedgeVenueMigrationExecutor::CONFIRMATION %></code>
            <%= form.text_field :migration_confirmation, autocomplete: "off", placeholder: HedgeVenueMigrationExecutor::CONFIRMATION, class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-2 py-2 text-xs text-white placeholder-gray-600" %>
            <%= form.submit "Run manual migration", class: "w-full rounded-lg border border-red-800 bg-red-950/70 px-3 py-2 text-xs font-semibold text-red-100 hover:bg-red-900" %>
          <% end %>
          <div class="mt-3 grid grid-cols-1 gap-2">
            <%= button_to "Finalize migration", migration_finalize_position_path(@position), method: :post, class: "rounded-lg bg-gray-800 px-3 py-2 text-xs font-medium text-gray-100 hover:bg-gray-700" %>
            <%= button_to "Cancel / clear migration state", migration_cancel_position_path(@position), method: :post, class: "rounded-lg bg-gray-800 px-3 py-2 text-xs font-medium text-gray-100 hover:bg-gray-700" %>
          </div>
        </div>
      </div>

      <% route_matrix = @migration_route_matrix || {} %>
      <% route_rows = route_matrix[:routes] || [] %>
      <div class="mt-4 rounded-xl border border-gray-800 bg-gray-950/60 p-4">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
          <div>
            <p class="text-xs uppercase tracking-wide text-gray-500">Legacy route matrix diagnostics only</p>
            <h3 class="mt-1 text-base font-semibold text-white"><%= production_route_ready ? "Production route proofs are 6/6 READY_FOR_RANDOM" : "Cached daily venue rotation diagnostics" %></h3>
            <p class="mt-1 text-xs text-gray-400"><%= production_route_ready ? "Legacy route matrix diagnostics only. Production runner uses READY_FOR_RANDOM route proofs. This table may show preview or dry-run states, but it does not block the active production runner." : "Dry-run proof only. Matrix rows use PositionDashboardSnapshot exposure and never sign or submit orders." %></p>
          </div>
          <%= button_to "Run dry-run route proof", migration_route_proof_position_path(@position), method: :post, class: "rounded-lg bg-gray-800 px-3 py-2 text-xs font-medium text-gray-100 hover:bg-gray-700" %>
        </div>
        <div class="mt-4 overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-800 text-left text-xs">
            <thead class="text-gray-500">
              <tr>
                <th class="px-3 py-2 font-medium">Route</th>
                <th class="px-3 py-2 font-medium">Preview</th>
                <th class="px-3 py-2 font-medium">Live</th>
                <th class="px-3 py-2 font-medium">Full</th>
                <th class="px-3 py-2 font-medium">Stepwise</th>
                <th class="px-3 py-2 font-medium">Target-first</th>
                <th class="px-3 py-2 font-medium">Source-first</th>
                <th class="px-3 py-2 font-medium">Status</th>
                <th class="px-3 py-2 font-medium">Blockers</th>
                <th class="px-3 py-2 font-medium">Last proof time</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-800 text-gray-300">
              <% route_rows.each do |route| %>
                <% ready = route[:route_status] == "READY_FOR_DRY_RUN" %>
                <tr>
                  <td class="whitespace-nowrap px-3 py-2 text-white"><%= HedgeVenues.label(route[:from_venue]) %> → <%= HedgeVenues.label(route[:to_venue]) %></td>
                  <td class="<%= route[:preview_available] ? 'text-green-300' : 'text-yellow-200' %> whitespace-nowrap px-3 py-2"><%= route[:preview_available] ? "Available" : "Blocked" %></td>
                  <td class="whitespace-nowrap px-3 py-2 text-yellow-200"><%= route[:live_available] ? "Gated" : "Blocked" %></td>
                  <td class="whitespace-nowrap px-3 py-2"><%= route[:supported_modes]&.include?("full") ? "yes" : "no" %></td>
                  <td class="whitespace-nowrap px-3 py-2"><%= route[:supported_modes]&.include?("stepwise") ? "yes" : "no" %></td>
                  <td class="whitespace-nowrap px-3 py-2"><%= route[:supported_sequences]&.include?("target_first") ? "yes" : "no" %></td>
                  <td class="whitespace-nowrap px-3 py-2"><%= route[:supported_sequences]&.include?("source_first") ? "yes" : "no" %></td>
                  <td class="<%= ready ? 'text-green-300' : 'text-yellow-200' %> whitespace-nowrap px-3 py-2"><%= route[:route_status] %></td>
                  <td class="max-w-md px-3 py-2 text-gray-400">
                    <% if route[:nado_readiness].present? %>
                      <span class="block text-gray-300">Nado: <%= route.dig(:nado_readiness, :nado_flat).nil? ? "unknown" : (route.dig(:nado_readiness, :nado_flat) ? "flat" : "#{format_venue_eth_amount(route.dig(:nado_readiness, :nado_current_short_eth))} ETH short") %>; open orders <%= route.dig(:nado_readiness, :nado_open_orders_count).nil? ? "unknown" : route.dig(:nado_readiness, :nado_open_orders_count) %>.</span>
                      <span class="block text-gray-500">Nado previews: open <%= route.dig(:nado_readiness, :nado_open_short_preview_available) ? "yes" : "no" %>, close <%= route.dig(:nado_readiness, :nado_reduce_only_close_preview_available) ? "proven (#{route.dig(:nado_readiness, :nado_reduce_only_close_preview_proof_mode)})" : "no" %>.</span>
                      <% if route.dig(:nado_readiness, :route_still_blocked_because_source_flat) %>
                        <span class="block text-yellow-200">Source route blocked because production Nado is flat.</span>
                      <% end %>
                      <% if route.dig(:nado_readiness, :nado_open_orders_unavailable_reason).present? %>
                        <span class="block text-gray-500"><%= route.dig(:nado_readiness, :nado_open_orders_unavailable_reason) %></span>
                      <% end %>
                    <% end %>
                    <%= Array(route[:blockers]).first(2).join("; ").presence || "none" %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-2 text-gray-400"><%= route[:last_proof_time].presence || "not recorded" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-xs text-gray-500">Nado routes are intentionally visible and fail-closed until Nado readback, open-order, close/open, and migration executor proof is implemented.</p>
      </div>
    </section>

    <section id="diagnostics" class="<%= tab_class.call('diagnostics') %>">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="text-lg font-semibold text-white">Portfolio Snapshot</h2>
        <div class="flex flex-wrap items-center justify-end gap-2 text-xs">
          <span class="text-gray-500"><%= canonical_extended_readiness ? "Current Extended readiness and fresh target are shown." : "Initial render uses cached values; diagnostics load separately." %></span>
          <%= link_to "Production diagnostics", production_diagnostics_position_path(@position, hedge_venue: selected_venue), class: "rounded border border-gray-700 px-2 py-1 text-gray-300 hover:bg-gray-800" %>
          <%= link_to "Hedge accounting", hedge_accounting_diagnostics_position_path(@position, hedge_venue: selected_venue), class: "rounded border border-gray-700 px-2 py-1 text-gray-300 hover:bg-gray-800" %>
          <%= link_to "Rewards / fees", rewards_fees_diagnostics_position_path(@position), class: "rounded border border-gray-700 px-2 py-1 text-gray-300 hover:bg-gray-800" %>
          <% if selected_venue == "extended" %>
            <%= link_to "Extended readiness", extended_diagnostics_position_path(@position, hedge_venue: selected_venue), class: "rounded border border-gray-700 px-2 py-1 text-gray-300 hover:bg-gray-800" %>
          <% end %>
        </div>
      </div>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
        <% [
          [ position_valuation.hedge_target_label, format_venue_eth_amount(position_valuation.weth_exposure), "WETH exposure" ],
          [ @position.mellow_autopilot? ? "Mellow USDC exposure" : "#{@position.asset1} amount", format_token_amount(position_valuation.usdc_exposure || @position.asset1_amount, decimals: 2), "USDC leg" ],
          [ position_valuation.current_value_label, valuation_value_display(position_valuation.current_value_usd), "Entry #{valuation_value_display(position_valuation.entry_value_usd)}" ],
          [ "Hedge venue", selected_venue_name, snapshot_margin_label ],
          [ "Target hedge ETH", format_venue_eth_amount(target_eth_short), canonical_extended_readiness ? "Source #{extended_auto_readiness[:target_source].presence || extended_auto_readiness[:exposure_source].presence || 'fresh target'}" : "Target short" ],
          [ "Target source", (canonical_extended_readiness ? (extended_auto_readiness[:exposure_source].presence || extended_auto_readiness[:target_source].presence) : cached_snapshot[:refresh_status]).presence || "Unavailable", canonical_extended_readiness ? "Refreshed #{extended_auto_readiness[:exposure_refreshed_at].presence || 'unavailable'}" : "Snapshot source" ],
          [ current_short_label, format_venue_eth_amount(current_short_eth), "Exchange readback" ],
          [ "Drift", format_venue_eth_amount(drift_eth), drift_usd.present? ? format_venue_usd_amount(drift_usd) : "USD unavailable" ],
          [ "Unrealized hedge PnL", format_venue_usd_amount(hedge_unrealized), "Snapshot venue readback" ],
          [ "Tolerance state", tolerance_label, "Tolerance #{format_venue_eth_amount(tolerance_eth)}" ],
          [ "Margin mode", snapshot_margin_label, snapshot_margin_detail ],
          [ "Entry price", format_venue_usd_amount(entry_price), "Readback entry" ],
          [ "Mark price", format_venue_usd_amount(mark_price), "Readback mark" ],
          [ "Isolated margin", format_venue_usd_amount(isolated_margin), margin_mode.to_s == "isolated" ? "Isolated collateral" : "Not applicable" ]
        ].tap { |rows| rows.insert(10, [ "Effective leverage", effective_leverage_display, effective_leverage_detail ]) if effective_leverage_display.present? }.each do |label, value, detail| %>
          <div class="min-w-0 rounded-xl border border-gray-800 bg-gray-900 p-4">
            <p class="truncate text-xs uppercase tracking-wide text-gray-500"><%= label %></p>
            <p class="mt-2 truncate text-xl font-semibold text-white" title="<%= value %>"><%= value %></p>
            <p class="mt-1 truncate text-xs text-gray-500" title="<%= detail %>"><%= detail %></p>
          </div>
        <% end %>
      </div>
    </section>

    <section id="hedge" class="rounded-2xl border border-gray-800 bg-gray-900/80 p-5<%= tab_class.call('hedge') %>">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div>
          <p class="text-xs uppercase tracking-wide text-gray-500">Hedge Control Center</p>
          <h2 class="mt-1 text-xl font-semibold text-white"><%= selected_venue_name %> Hedge Actions</h2>
          <p class="mt-1 text-sm text-gray-400">Preview, confirm, submit, read back. Live actions stay gated until the exact venue confirmation is entered.</p>
        </div>
        <%= form_with url: hedge_venue_position_path(@position), method: :patch, class: "flex flex-col gap-2 sm:flex-row sm:items-end" do |form| %>
          <div>
            <%= form.label :hedge_venue, "Hedge venue", class: "block text-xs uppercase tracking-wide text-gray-500" %>
            <%= form.select :hedge_venue, options_for_select(@hedge_venue_options || HedgeVenues.options, selected_venue), {}, class: "mt-1 w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white" %>
          </div>
          <%= form.submit "Set Venue", class: "rounded-lg bg-gray-800 px-3 py-2 text-sm font-medium text-gray-100 hover:bg-gray-700" %>
        <% end %>
      </div>

      <div class="mt-5 grid grid-cols-1 gap-4 xl:grid-cols-3">
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4 xl:col-span-1">
          <p class="text-xs uppercase tracking-wide text-gray-500">Action Preview</p>
          <div class="mt-3 space-y-2 text-sm">
            <div class="flex justify-between gap-4"><span class="text-gray-500"><%= current_short_label %></span><span class="truncate text-white" title="<%= current_short_eth %>"><%= format_venue_eth_amount(current_short_eth) %> ETH</span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Target short</span><span class="truncate text-white" title="<%= target_eth_short %>"><%= format_venue_eth_amount(target_eth_short) %> ETH</span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Delta</span><span class="<%= drift_negative ? 'text-red-300' : 'text-green-300' %>" title="<%= drift_eth %>"><%= format_venue_eth_amount(drift_eth) %> ETH</span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Next action</span><span class="<%= rebalance_needed ? 'text-yellow-200' : 'text-green-300' %>"><%= rebalance_needed ? next_action.to_s.humanize : "within tolerance / no-op" %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Live gate</span><span class="text-white"><%= live_status_label %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Auto</span><span class="text-white"><%= auto_operational_label %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Signer</span><span class="text-white"><%= signer_label %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500"><%= current_position_label %></span><span class="text-white"><%= current_short_eth.present? ? "snapshot" : "not refreshed" %></span></div>
            <% if selected_venue == "extended" %>
              <div class="flex justify-between gap-4"><span class="text-gray-500">Open orders</span><span class="text-white"><%= snapshot_open_orders_count.nil? ? "not refreshed" : snapshot_open_orders_count %></span></div>
              <div class="flex justify-between gap-4"><span class="text-gray-500">Auto readiness</span><span class="text-gray-300"><%= selected_auto_readiness_loaded ? (selected_auto_ready ? "ready" : "blocked") : "diagnostics separate" %></span></div>
              <div class="flex justify-between gap-4"><span class="text-gray-500">Planned auto</span><span class="text-white"><%= extended_action_label %></span></div>
              <div class="flex justify-between gap-4"><span class="text-gray-500">Min size</span><span class="text-white"><%= extended_auto_readiness[:min_rebalance_size_eth].presence || "0.03" %> ETH / $<%= extended_auto_readiness[:min_rebalance_notional_usd].presence || "50" %></span></div>
              <div class="flex justify-between gap-4"><span class="text-gray-500">Cooldown</span><span class="text-white"><%= extended_auto_readiness[:cooldown_remaining_seconds].presence || 0 %>s</span></div>
              <div class="flex justify-between gap-4"><span class="text-gray-500">Confirmations</span><span class="text-white"><%= extended_auto_readiness[:consecutive_outside_tolerance_count].presence || 0 %>/<%= extended_auto_readiness[:consecutive_outside_tolerance_required].presence || 2 %></span></div>
              <div class="flex justify-between gap-4"><span class="text-gray-500">Drift / tolerance</span><span class="text-white"><%= extended_auto_readiness[:drift_to_tolerance_ratio].presence || "n/a" %></span></div>
              <div class="flex justify-between gap-4"><span class="text-gray-500">Strong drift threshold</span><span class="text-white"><%= extended_auto_readiness[:strong_drift_threshold].presence || "n/a" %> ETH</span></div>
            <% end %>
          </div>
          <% if hedge_preview && !hedge_preview.supported && !readiness_preview_available %>
            <div class="mt-4 rounded-lg border border-yellow-900 bg-yellow-950/30 p-3">
              <p class="text-xs font-semibold text-yellow-100">Hedge preview unavailable</p>
              <p class="mt-1 break-words text-xs text-yellow-200"><%= hedge_preview.reason %></p>
            </div>
          <% end %>
          <% if selected_adapter&.venue_name == "Ethereal" %>
            <p class="mt-4 rounded-lg border border-indigo-900 bg-indigo-950/30 p-3 text-xs text-indigo-100">Ethereal uses cross margin only. Effective leverage is estimated from position notional / account collateral.</p>
          <% end %>
          <% if selected_venue == "extended" %>
            <div class="mt-4 rounded-lg border border-gray-800 bg-gray-950/60 p-3 text-xs text-gray-300">
              <p>Extended production venue. Manual auto setting <%= auto_operational_label %>. Signer: <%= signer_label %>. Required: 1x isolated-equivalent.</p>
              <div class="mt-3 grid grid-cols-1 gap-2 border-t border-gray-800 pt-3 sm:grid-cols-2">
                <div><span class="text-gray-500">Production venue</span><p class="text-white">Extended</p></div>
                <div><span class="text-gray-500">Normal Extended auto</span><p class="<%= auto_gate_enabled ? 'text-green-300' : 'text-gray-300' %>"><%= auto_gate_enabled ? "enabled" : "disabled" %></p></div>
                <div><span class="text-gray-500">Migration / canary</span><p class="text-gray-300">disabled unless manually gated</p></div>
                <div><span class="text-gray-500">Live random autopilot</span><p class="text-gray-300">disabled</p></div>
              </div>
              <% if selected_snapshot[:leverage].present? && BigDecimal(selected_snapshot[:leverage].to_s) == 1 && margin_mode.blank? %>
                <p class="mt-2 text-gray-400"><%= snapshot_margin_detail %>.</p>
              <% end %>
              <% if cached_snapshot.dig(:migration_status, :complete) %>
                <p class="mt-2 text-green-200"><%= cached_snapshot.dig(:migration_status, :label) %></p>
              <% else %>
                <details class="mt-2">
                  <summary class="cursor-pointer text-yellow-100">Migration tools</summary>
                  <p class="mt-2 text-yellow-100">Migration is stepwise. Production venue is not switched until finalize succeeds.</p>
                  <p class="mt-2 text-yellow-100">Fast migration is available as a gated dry-run/live task. Extended-first temporarily overhedges until Ethereal close confirms.</p>
                </details>
              <% end %>
              <p class="mt-2 text-gray-400">Detailed live preflight loads separately. Dry-runs do not sign or submit orders.</p>
              <% if migration_full_readiness[:target_short_eth].present? %>
                <div class="mt-3 grid grid-cols-2 gap-2 border-t border-yellow-900/60 pt-3">
                  <div><span class="text-yellow-300">Ethereal short</span><br><%= format_venue_eth_amount(migration_full_readiness[:ethereal_short_eth]) %> ETH</div>
                  <div><span class="text-yellow-300">Extended short</span><br><%= format_venue_eth_amount(migration_full_readiness[:extended_short_eth]) %> ETH</div>
                  <div><span class="text-yellow-300">Target</span><br><%= format_venue_eth_amount(migration_full_readiness[:target_short_eth]) %> ETH</div>
                  <div><span class="text-yellow-300">Expected final</span><br><%= format_venue_eth_amount(migration_full_readiness[:expected_extended_short_after]) %> ETH Extended / <%= format_venue_eth_amount(migration_full_readiness[:expected_ethereal_short_after]) %> ETH Ethereal</div>
                </div>
              <% end %>
              <% if selected_auto_readiness_loaded && extended_auto_readiness[:blockers].present? %>
                <p class="mt-3 break-words border-t border-yellow-900/60 pt-3 text-yellow-200">Continuous auto readiness blockers: <%= extended_auto_readiness[:blockers].uniq.join("; ") %></p>
              <% end %>
              <% if selected_venue == "extended" && extended_auto_readiness[:action_suppressed_reason].present? %>
                <p class="mt-3 break-words border-t border-yellow-900/60 pt-3 text-yellow-200">Auto watch: <%= extended_auto_readiness[:action_suppressed_reason] %>. No live order will be submitted while this condition holds.</p>
              <% elsif selected_venue == "extended" && extended_planned_action == "no_op" %>
                <p class="mt-3 border-t border-gray-800 pt-3 text-green-200">Extended auto is a no-op because the current short is inside tolerance.</p>
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="rounded-xl border <%= risk_cap_blocked || risk_order_blocked || risk_short_cap.value.blank? ? 'border-yellow-800 bg-yellow-950/20' : 'border-gray-800 bg-gray-950/60' %> p-4 xl:col-span-2">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <p class="text-xs uppercase tracking-wide text-gray-500">Risk Cap Status</p>
              <h3 class="mt-1 text-lg font-semibold text-white"><%= risk_cap_blocked || risk_order_blocked ? "Blocked by risk limit" : "Risk limits loaded" %></h3>
              <p class="mt-1 text-sm text-gray-400">Venue-specific caps override generic Aerodrome caps. Missing caps fail closed.</p>
            </div>
            <a href="<%= edit_settings_path(anchor: 'risk-settings') %>" class="rounded-lg bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-500">Risk Settings</a>
          </div>
          <div class="mt-4 grid grid-cols-1 gap-3 text-sm md:grid-cols-3">
            <div class="rounded-lg border border-gray-800 bg-gray-950/70 p-3">
              <p class="text-xs text-gray-500">Target hedge</p>
              <p class="mt-1 text-white"><%= format_venue_eth_amount(risk_target_short) %> ETH</p>
            </div>
            <div class="rounded-lg border border-gray-800 bg-gray-950/70 p-3">
              <p class="text-xs text-gray-500">Current <%= selected_venue_name %> short</p>
              <p class="mt-1 text-white"><%= format_venue_eth_amount(risk_current_short) %> ETH</p>
            </div>
            <div class="rounded-lg border border-gray-800 bg-gray-950/70 p-3">
              <p class="text-xs text-gray-500">Requested <%= recommended_action_key %></p>
              <p class="mt-1 text-white"><%= format_venue_eth_amount(risk_requested_size) %> ETH</p>
            </div>
            <div class="rounded-lg border border-gray-800 bg-gray-950/70 p-3 md:col-span-2">
              <p class="text-xs text-gray-500">Current cap</p>
              <p class="mt-1 break-words font-mono text-xs text-white"><%= risk_short_cap.key %> = <%= risk_short_cap.value&.to_s("F") || "not configured" %> ETH</p>
              <p class="mt-1 text-xs text-gray-500">Source: <%= risk_short_cap.source %></p>
            </div>
            <div class="rounded-lg border border-gray-800 bg-gray-950/70 p-3">
              <p class="text-xs text-gray-500">Minimum required cap</p>
              <p class="mt-1 text-white"><%= format_venue_eth_amount(risk_expected_after) %> ETH</p>
            </div>
          </div>
          <% if risk_cap_blocked || risk_order_blocked || risk_short_cap.value.blank? %>
            <p class="mt-4 text-sm text-yellow-100">Action: raise cap intentionally, reduce LP size, or choose another supported venue. Cap increases require <%= RiskSettings::INCREASE_CONFIRMATION %>.</p>
          <% end %>
        </div>

        <% position_risk_changes = @risk_recommendation&.fetch(:required_changes, []) || [] %>
        <% if position_risk_changes.present? %>
          <div class="rounded-xl border border-yellow-800 bg-yellow-950/20 p-4 xl:col-span-2">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
              <div>
                <p class="text-xs uppercase tracking-wide text-yellow-300">Recommended fix available</p>
                <h3 class="mt-1 text-lg font-semibold text-white">Apply limits that clear the current risk blockers</h3>
                <p class="mt-1 text-sm text-yellow-100">This updates app risk settings only. It does not submit orders, create signatures, or close positions.</p>
                <ul class="mt-3 space-y-1 text-sm text-gray-200">
                  <% position_risk_changes.each do |change| %>
                    <% current_value = change[:current_value].presence || "not configured" %>
                    <% verb = begin
                      current_decimal = RiskSettings.decimal(change[:current_value])
                      recommended_decimal = RiskSettings.decimal(change[:recommended_value])
                      current_decimal && recommended_decimal && recommended_decimal < current_decimal ? "Lower" : "Set"
                    end %>
                    <li><%= verb %> <%= change[:label] %> from <%= current_value %> to <%= change[:recommended_value] %> <%= RiskSettings.unit_for(change[:key]) %>.</li>
                  <% end %>
                </ul>
              </div>
              <%= form_with url: risk_settings_path, method: :patch, class: "min-w-full space-y-2 lg:min-w-80" do |form| %>
                <%= form.hidden_field :position_id, value: @risk_recommendation[:position_id] %>
                <%= form.hidden_field :venue, value: @risk_recommendation[:venue] %>
                <%= form.text_field :confirmation, placeholder: @risk_recommendation[:confirmation_required], class: "w-full rounded border border-yellow-800 bg-gray-950 px-3 py-2 text-sm text-white placeholder:text-gray-500" %>
                <%= form.button "Apply recommended limits", name: "apply_recommended", value: "1", class: "w-full rounded-lg bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-500" %>
                <p class="text-xs text-gray-500">Required confirmation: <%= @risk_recommendation[:confirmation_required] %></p>
              <% end %>
            </div>
          </div>
        <% end %>

        <% emergency_restore_outside = begin
          (BigDecimal((cached_snapshot[:target_short_eth] || target_eth_short).to_s) - BigDecimal(cached_snapshot[:combined_short_eth].to_s)).abs > BigDecimal((cached_snapshot[:tolerance_eth] || "0").to_s)
        rescue ArgumentError, TypeError
          false
        end %>
        <% emergency_restore_visible = (cached_snapshot[:production_venue].presence || @position.hedge&.execution_venue).to_s == "extended" %>
        <% emergency_target_short_eth = canonical_extended_readiness ? target_eth_short : (cached_snapshot[:target_short_eth] || target_eth_short) %>
        <% emergency_current_short_eth = canonical_extended_readiness ? current_short_eth : cached_snapshot[:combined_short_eth] %>
        <% emergency_drift_eth = canonical_extended_readiness ? drift_eth : (cached_snapshot[:drift_eth] || drift_eth) %>
        <% if emergency_restore_visible %>
          <div class="rounded-xl border <%= inside_tolerance == true ? 'border-gray-800 bg-gray-950/50' : 'border-red-900 bg-red-950/20' %> p-4 xl:col-span-2">
            <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
              <div>
                <p class="text-xs uppercase tracking-wide <%= inside_tolerance == true ? 'text-gray-500' : 'text-red-300' %>">Emergency Restore Hedge</p>
                <h3 class="mt-1 text-lg font-semibold text-white">Refresh exposure and adjust Extended hedge</h3>
                <% if inside_tolerance == true %>
                  <p class="mt-1 text-sm text-green-200">Not needed: inside tolerance. Normal Extended auto is the primary path and is currently a no-op.</p>
                <% else %>
                  <p class="mt-1 text-sm text-red-100">Use only when the production hedge is overhedged, underhedged, or flat after a failed manual migration. This path refreshes Mellow/Aerodrome source exposure before sizing, bypasses stale proposal/history gates, and keeps Extended live gates, cap checks, open-order checks, signer health, and readback confirmation.</p>
                <% end %>
              </div>
              <span class="rounded-full border <%= inside_tolerance == true ? 'border-gray-700 bg-gray-950 text-gray-300' : 'border-red-800 bg-red-950 text-red-100' %> px-3 py-1 text-xs font-semibold"><%= inside_tolerance == true ? "Not needed" : "Manual recovery" %></span>
            </div>
            <div class="mt-4 grid grid-cols-1 gap-3 text-sm md:grid-cols-4">
              <div><span class="text-gray-500">Production venue</span><p class="text-white"><%= HedgeVenues.label(cached_snapshot[:production_venue]) %></p></div>
              <div><span class="text-gray-500">Target short</span><p class="text-white"><%= format_venue_eth_amount(emergency_target_short_eth) %> ETH</p></div>
              <div><span class="text-gray-500"><%= canonical_extended_readiness ? "Current short" : "Combined short" %></span><p class="text-white"><%= format_venue_eth_amount(emergency_current_short_eth) %> ETH</p></div>
              <div><span class="text-gray-500">Drift</span><p class="text-white"><%= format_venue_eth_amount(emergency_drift_eth) %> ETH</p></div>
            </div>
            <div class="mt-4 grid grid-cols-1 gap-3 lg:grid-cols-2">
              <%= button_to "Emergency Refresh & Adjust Dry Run", hedge_emergency_restore_position_path(@position), method: :post, params: { dry_run: true, emergency_action: "adjust" }, disabled: inside_tolerance == true, class: "rounded-lg bg-gray-800 px-3 py-2 text-xs font-medium text-gray-100 hover:bg-gray-700 disabled:bg-gray-900 disabled:text-gray-600" %>
              <%= form_with url: hedge_emergency_restore_position_path(@position), method: :post, class: "space-y-2" do |form| %>
                <%= form.hidden_field :live, value: "true" %>
                <%= form.hidden_field :emergency_action, value: "adjust" %>
                <p class="text-xs text-gray-400">Required phrase</p>
                <code class="block break-all rounded-lg border border-gray-800 bg-gray-950 p-2 text-[11px] text-gray-200"><%= HedgeEmergencyRestore::ADJUST_CONFIRMATION %></code>
                <%= form.text_field :hedge_emergency_restore_confirmation,
                  value: "",
                  autocomplete: "off",
                  placeholder: HedgeEmergencyRestore::ADJUST_CONFIRMATION,
                  data: { required_confirmation: HedgeEmergencyRestore::ADJUST_CONFIRMATION, live_submit_id: "hedge-emergency-restore-submit" },
                  oninput: "document.getElementById(this.dataset.liveSubmitId).disabled = this.value !== this.dataset.requiredConfirmation",
                  class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-2 py-2 text-xs text-white placeholder-gray-600" %>
                <%= form.submit "Emergency Refresh & Adjust Live", id: "hedge-emergency-restore-submit", disabled: true, class: "w-full rounded-lg border border-red-800 bg-red-950/80 px-3 py-2 text-xs font-semibold text-red-100 transition hover:bg-red-900 disabled:border-gray-800 disabled:bg-gray-900 disabled:text-gray-600" %>
              <% end %>
            </div>
            <p class="mt-3 text-xs text-yellow-200">Emergency adjust refreshes source-of-truth Mellow exposure before computing target and does not use stale DB exposure if the fresh resolver is unavailable. Current DB WETH is displayed for context only: <%= format_venue_eth_amount(@position.asset0_amount) %>.</p>
            <p class="mt-3 text-xs text-gray-500">Default is dry-run. Live requires HEDGE_EMERGENCY_ADJUST_ENABLED=true or HEDGE_EMERGENCY_RESTORE_ENABLED=true, Extended live/probe gates, zero Extended open orders, exact phrase, target within caps, and successful Extended readback. No production venue is changed.</p>
          </div>
        <% end %>

        <div class="space-y-4 xl:col-span-2">
          <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <p class="text-xs uppercase tracking-wide text-gray-500">Live Gates</p>
                <p class="mt-1 text-sm text-gray-300"><%= live_status_label %> for <%= selected_venue_name %>. Preview actions do not create orders.</p>
              </div>
              <span class="rounded-full border <%= selected_action_blockers.blank? ? 'border-gray-700 bg-gray-950 text-gray-300' : 'border-yellow-800 bg-yellow-950/50 text-yellow-200' %> px-3 py-1 text-xs font-semibold"><%= selected_action_blockers.blank? ? "Preflight diagnostics separate" : "#{selected_action_blockers.size} blocker#{'s' unless selected_action_blockers.size == 1}" %></span>
            </div>
            <% if selected_action_blockers.present? %>
              <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-yellow-100">
                <% selected_action_blockers.each do |blocker| %>
                  <li class="break-words"><%= blocker %></li>
                <% end %>
              </ul>
            <% else %>
              <p class="mt-3 text-sm text-gray-300">Detailed live preflight loads separately; no blocker is counted from unloaded diagnostics.</p>
            <% end %>
            <% if selected_action_warnings.present? %>
              <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-yellow-200">
                <% selected_action_warnings.each do |warning| %>
                  <li class="break-words"><%= warning %></li>
                <% end %>
              </ul>
            <% end %>
            <% if selected_venue == "ethereal" && @position.hedge&.execution_venue != "ethereal" %>
              <p class="mt-3 text-sm text-yellow-200">Current active hedge venue is <%= HedgeVenues.label(@position.hedge&.execution_venue) %>; opening Ethereal would create a second hedge unless migration is intended.</p>
            <% end %>
            <% unless selected_adapter&.live_enabled? %>
              <p class="mt-3 text-sm text-yellow-200">Live submit is disabled for <%= selected_venue_name %>; previews do not create orders.</p>
              <% if selected_venue == "nado" %>
                <p class="mt-2 text-sm text-yellow-100">Enable Nado live gate to perform one-shot manual rebalance. Continuous auto does not need to be enabled.</p>
              <% end %>
            <% end %>
          </div>

          <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
            <% [
              [ :open, hedge_open_preview_position_path(@position), hedge_open_position_path(@position), "Open Hedge" ],
              [ :rebalance, hedge_rebalance_preview_position_path(@position), hedge_rebalance_position_path(@position), "Rebalance Hedge" ]
            ].each do |key, preview_path, live_path, label| %>
              <% action_preflight = action_preflights[key] || {} %>
              <% action_blockers = (action_preflight[:blockers] || []).uniq.reject { |blocker| blocker.to_s.start_with?("submitted confirmation must equal") || neutral_preflight_messages.include?(blocker.to_s) } %>
              <% action_needed = case key
              when :open then next_action == "open"
              when :rebalance then next_action.in?([ "increase short", "reduce short", "rebalance" ])
              when :close then BigDecimal(current_short_eth.to_s).positive? rescue false
              end %>
              <% required_phrase = selected_venue == "nado" ? AerodromeDashboardHedgeAction::NADO_CONFIRMATION : (selected_venue == "ethereal" ? AerodromeDashboardHedgeAction::ETHEREAL_CONFIRMATION : (selected_venue == "extended" ? AerodromeDashboardHedgeAction::EXTENDED_CONFIRMATION : (key == :close ? AerodromeLiveEmergencyClose::CONFIRMATION : AerodromeDashboardHedgeAction::CONFIRMATION))) %>
              <% confirmation_enabled = action_needed && selected_adapter&.live_enabled? && action_blockers.blank? %>
              <% submit_id = "dashboard-hedge-live-submit-#{key}" %>
              <div class="rounded-xl border <%= action_needed ? 'border-indigo-800 bg-indigo-950/20' : 'border-gray-800 bg-gray-950/40 opacity-80' %> p-4">
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <p class="font-medium text-white"><%= label %></p>
                    <p class="mt-1 text-xs text-gray-500"><%= action_needed ? "Relevant now" : "Not needed now" %></p>
                  </div>
                  <% if key == recommended_action_key && next_action != "no-op" %>
                    <span class="rounded-full border border-indigo-700 bg-indigo-950 px-2 py-1 text-[11px] text-indigo-200">planned</span>
                  <% end %>
                </div>
                <div class="mt-3">
                  <%= button_to "#{label} Preview", preview_path, method: :post, params: { hedge_venue: selected_venue }, disabled: !action_needed, class: "w-full rounded-lg bg-gray-800 px-3 py-2 text-xs font-medium text-gray-100 transition hover:bg-gray-700 disabled:bg-gray-900 disabled:text-gray-600" %>
                </div>
                <% if action_needed %>
                  <div class="mt-3 rounded-lg border border-gray-800 bg-gray-950 p-2">
                    <p class="text-xs text-gray-500">Required phrase</p>
                    <code id="dashboard-hedge-phrase-<%= key %>" class="mt-1 block break-all text-[11px] text-gray-200"><%= required_phrase %></code>
                  </div>
                  <%= form_with url: live_path, method: :post, class: "mt-3" do |form| %>
                    <%= form.hidden_field :hedge_venue, value: selected_venue %>
                    <%= form.text_field :dashboard_hedge_confirmation,
                      id: "dashboard-hedge-confirmation-#{key}",
                      placeholder: required_phrase,
                      value: "",
                      autocomplete: "off",
                      disabled: !confirmation_enabled,
                      data: { required_confirmation: required_phrase, live_submit_id: submit_id },
                      oninput: "document.getElementById(this.dataset.liveSubmitId).disabled = this.value !== this.dataset.requiredConfirmation",
                      class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-2 py-2 text-xs text-white placeholder-gray-600 disabled:border-gray-800 disabled:text-gray-600" %>
                    <%= form.submit "#{label} Live", id: submit_id, disabled: true, class: "mt-2 w-full rounded-lg border border-red-800 bg-red-950/70 px-3 py-2 text-xs font-semibold text-red-100 transition hover:bg-red-900 disabled:border-gray-800 disabled:bg-gray-900 disabled:text-gray-600" %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>

          <details class="rounded-xl border border-red-950/70 bg-red-950/10 p-4">
            <summary class="cursor-pointer text-sm font-semibold text-red-100">Emergency / manual close tools</summary>
            <% key = :close %>
            <% action_preflight = action_preflights[key] || {} %>
            <% action_blockers = (action_preflight[:blockers] || []).uniq.reject { |blocker| blocker.to_s.start_with?("submitted confirmation must equal") } %>
            <% close_needed = BigDecimal(current_short_eth.to_s).positive? rescue false %>
            <% required_phrase = selected_venue == "nado" ? AerodromeDashboardHedgeAction::NADO_CONFIRMATION : (selected_venue == "ethereal" ? AerodromeDashboardHedgeAction::ETHEREAL_CONFIRMATION : (selected_venue == "extended" ? AerodromeDashboardHedgeAction::EXTENDED_CONFIRMATION : AerodromeLiveEmergencyClose::CONFIRMATION)) %>
            <% confirmation_enabled = close_needed && selected_adapter&.live_enabled? && action_blockers.blank? %>
            <% submit_id = "dashboard-hedge-live-submit-close" %>
            <p class="mt-3 text-sm text-red-100">Close is a dangerous manual action for the production hedge. Use it only for explicit operator intervention.</p>
            <div class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-2">
              <%= button_to "Close Hedge Preview", hedge_close_preview_position_path(@position), method: :post, params: { hedge_venue: selected_venue }, disabled: !close_needed, class: "rounded-lg bg-gray-800 px-3 py-2 text-xs font-medium text-gray-100 transition hover:bg-gray-700 disabled:bg-gray-900 disabled:text-gray-600" %>
              <% if close_needed %>
                <%= form_with url: hedge_close_position_path(@position), method: :post, class: "space-y-2" do |form| %>
                  <%= form.hidden_field :hedge_venue, value: selected_venue %>
                  <code id="dashboard-hedge-phrase-close" class="block break-all rounded-lg border border-gray-800 bg-gray-950 p-2 text-[11px] text-gray-200"><%= required_phrase %></code>
                  <%= form.text_field :dashboard_hedge_confirmation,
                    id: "dashboard-hedge-confirmation-close",
                    placeholder: required_phrase,
                    value: "",
                    autocomplete: "off",
                    disabled: !confirmation_enabled,
                    data: { required_confirmation: required_phrase, live_submit_id: submit_id },
                    oninput: "document.getElementById(this.dataset.liveSubmitId).disabled = this.value !== this.dataset.requiredConfirmation",
                    class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-2 py-2 text-xs text-white placeholder-gray-600 disabled:border-gray-800 disabled:text-gray-600" %>
                  <%= form.submit "Close Hedge Live", id: submit_id, disabled: true, class: "w-full rounded-lg border border-red-800 bg-red-950/70 px-3 py-2 text-xs font-semibold text-red-100 transition hover:bg-red-900 disabled:border-gray-800 disabled:bg-gray-900 disabled:text-gray-600" %>
                <% end %>
              <% end %>
            </div>
          </details>
        </div>
      </div>
    </section>

    <section id="accounting" class="rounded-2xl border border-gray-800 bg-gray-900/80 p-5<%= tab_class.call('accounting') %>">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <p class="text-xs uppercase tracking-wide text-gray-500">Auto-Rebalance Status</p>
          <h2 class="mt-1 text-lg font-semibold text-white"><%= auto_operational_label %></h2>
          <% if auto_status[:auto_rebalance_message].present? %>
            <p class="mt-1 text-sm text-gray-400"><%= auto_status[:auto_rebalance_message] %></p>
          <% end %>
        </div>
        <div class="grid grid-cols-2 gap-3 text-sm md:grid-cols-4">
          <div><p class="text-xs text-gray-500">Position sync</p><p class="text-white"><%= auto_status.dig(:scheduler, :position_sync_schedule).presence || "every minute" %></p></div>
          <div><p class="text-xs text-gray-500">Hedge sync</p><p class="text-white"><%= auto_status.dig(:scheduler, :hedge_sync_schedule).presence || "every 5 minutes" %></p></div>
          <div><p class="text-xs text-gray-500">Selected venue</p><p class="text-white"><%= auto_status[:execution_venue_name] || selected_venue_name %></p></div>
          <div><p class="text-xs text-gray-500">Last rebalance</p><p class="text-white"><%= auto_status[:last_rebalance_id] ? "##{auto_status[:last_rebalance_id]}" : "None" %></p></div>
        </div>
      </div>
      <% if auto_status[:last_rebalance_id] %>
        <div class="mt-4 rounded-lg border border-gray-800 bg-gray-950/60 p-3 text-sm">
          <p class="text-gray-300">
            Last selected-venue success:
            #<%= auto_status[:last_rebalance_id] %>
            · <%= auto_status[:last_rebalance_time]&.strftime("%m/%d %H:%M") || "time unavailable" %>
            · <%= format_venue_eth_amount(auto_status[:last_rebalance_old_short_eth]) %> → <%= format_venue_eth_amount(auto_status[:last_rebalance_new_short_eth]) %> ETH
            · <%= auto_status[:last_rebalance_status] %>
          </p>
        </div>
      <% elsif auto_gate_enabled %>
        <p class="mt-4 rounded-lg border border-gray-800 bg-gray-950/60 p-3 text-sm text-gray-300">Auto active; readiness diagnostics load separately.</p>
      <% end %>
      <div class="mt-4 grid grid-cols-2 gap-3 text-sm md:grid-cols-4">
        <div class="rounded-lg border border-gray-800 bg-gray-950/60 p-3"><p class="text-xs text-gray-500">Current drift</p><p class="mt-1 text-white"><%= format_venue_eth_amount(auto_status[:current_drift_eth] || drift_eth) %></p></div>
        <div class="rounded-lg border border-gray-800 bg-gray-950/60 p-3"><p class="text-xs text-gray-500">Tolerance</p><p class="mt-1 text-white"><%= format_venue_eth_amount(auto_status[:tolerance_eth] || tolerance_eth) %></p></div>
        <div class="rounded-lg border border-gray-800 bg-gray-950/60 p-3"><p class="text-xs text-gray-500">Rebalance needed now</p><p class="<%= rebalance_needed.nil? ? 'text-gray-300' : (rebalance_needed ? 'text-red-300' : 'text-green-300') %> mt-1"><%= rebalance_needed.nil? ? "unknown" : (rebalance_needed ? "yes" : "no") %></p></div>
        <div class="rounded-lg border border-gray-800 bg-gray-950/60 p-3"><p class="text-xs text-gray-500">Manage</p><%= link_to "Settings", edit_settings_path, class: "mt-1 inline-block text-indigo-300 hover:text-indigo-200" %></div>
      </div>
      <% auto_messages = ((auto_status[:blockers] || []) + (auto_status[:warnings] || [])).uniq %>
      <% if auto_messages.present? %>
        <ul class="mt-4 list-disc space-y-1 pl-5 text-sm text-yellow-100">
          <% auto_messages.each do |message| %><li><%= message %></li><% end %>
        </ul>
      <% end %>
      <% if aerodrome && auto_control_status.present? && OperationalSettings.auto_key_for(selected_venue) %>
        <% auto_enabled = auto_control_status[:selected_auto_enabled] %>
        <% auto_phrase = auto_enabled ? auto_control_status[:disable_confirmation] : auto_control_status[:enable_confirmation] %>
        <% auto_button_label = auto_enabled ? "Disable #{selected_venue_name} Auto" : "Enable #{selected_venue_name} Auto" %>
        <% auto_blockers = auto_enabled ? [] : auto_control_status[:blockers] %>
        <div id="auto-settings" class="mt-5 rounded-xl border <%= auto_blockers.present? ? 'border-yellow-800 bg-yellow-950/20' : 'border-gray-800 bg-gray-950/60' %> p-4">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
            <div>
              <p class="text-xs uppercase tracking-wide text-gray-500">Auto-Rebalance Controls</p>
              <h3 class="mt-1 text-lg font-semibold text-white"><%= auto_enabled ? "Auto On" : "Auto Off" %></h3>
              <p class="mt-1 text-sm text-gray-400">Selected active venue: <%= selected_venue_name %>. This only changes the auto loop setting. It does not submit an order.</p>
              <p class="mt-2 text-sm text-gray-300">
                <% if auto_enabled %>
                  Disables automatic <%= selected_venue_name %> rebalances. Manual hedge controls remain available.
                <% else %>
                  Enables the <%= selected_venue_name %> auto-rebalance loop for the active production position. It will only act when drift exceeds tolerance and all safety gates pass.
                <% end %>
              </p>
              <% if auto_blockers.present? %>
                <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-yellow-100">
                  <% auto_blockers.each do |blocker| %><li><%= blocker %></li><% end %>
                </ul>
              <% elsif !auto_enabled && inside_tolerance == false %>
                <p class="mt-3 text-sm text-yellow-100">Hedge is outside tolerance; enabling auto may allow a rebalance on the next sync once all safety gates pass.</p>
              <% end %>
              <details class="mt-3 text-xs text-gray-500">
                <summary class="cursor-pointer">Technical keys</summary>
                <p class="mt-1 font-mono"><%= auto_control_status[:selected_auto_key] %> · source <%= auto_control_status[:selected_auto_source] %></p>
                <p class="font-mono">Migration/random remain disabled through DB overrides.</p>
              </details>
            </div>
            <%= form_with url: auto_rebalance_position_path(@position), method: :post, class: "min-w-full space-y-2 lg:min-w-80" do |form| %>
              <%= form.hidden_field :venue, value: selected_venue %>
              <%= form.hidden_field :enabled, value: (!auto_enabled).to_s %>
              <%= form.text_field :auto_confirmation, placeholder: auto_phrase, autocomplete: "off", class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white placeholder-gray-600" %>
              <%= form.submit auto_button_label, disabled: auto_blockers.present?, class: "w-full rounded-lg bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-500 disabled:bg-gray-900 disabled:text-gray-600" %>
              <p class="text-xs text-gray-500">Required confirmation: <%= auto_phrase %></p>
            <% end %>
          </div>
        </div>
      <% end %>
    </section>

    <% history_report = @aerodrome_rebalance_history_status || {} %>
    <% history_records = history_report[:records] || [] %>
    <% selected_history = history_records.select { |record| HedgeVenues.normalize(record.venue) == selected_venue } %>
    <% selected_success_history = selected_history.select { |record| record.status == ShortRebalance::STATUS_SUCCESS } %>
    <% primary_selected_history = selected_success_history.presence || selected_history %>
    <% previous_history = history_records.reject { |record| HedgeVenues.normalize(record.venue) == selected_venue } %>
    <section class="rounded-2xl border border-gray-800 bg-gray-900/80 p-5<%= tab_class.call('hedge', 'diagnostics') %>">
      <div class="flex items-center justify-between gap-3">
        <div>
          <p class="text-xs uppercase tracking-wide text-gray-500">Recent Rebalance History</p>
          <h2 class="mt-1 text-lg font-semibold text-white"><%= selected_venue_name %> history</h2>
        </div>
        <span class="rounded-full border border-gray-700 bg-gray-950 px-3 py-1 text-xs text-gray-300"><%= selected_history.size %> selected-venue rows</span>
      </div>
      <% if selected_history.any? %>
        <div class="mt-4 overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-800 text-sm">
            <thead class="text-left text-xs uppercase tracking-wide text-gray-500">
              <tr><th class="px-3 py-2">ID</th><th class="px-3 py-2">Time</th><th class="px-3 py-2">Venue</th><th class="px-3 py-2">Side</th><th class="px-3 py-2">Old</th><th class="px-3 py-2">New</th><th class="px-3 py-2">Delta</th><th class="px-3 py-2">Realized</th><th class="px-3 py-2">Status</th><th class="px-3 py-2">Message</th><th class="px-3 py-2">Order</th></tr>
            </thead>
            <tbody class="divide-y divide-gray-800">
              <% primary_selected_history.first(12).each do |rebalance| %>
                <tr>
                  <% rebalance_delta = if rebalance.old_short_size && rebalance.new_short_size
                    BigDecimal(rebalance.new_short_size.to_s) - BigDecimal(rebalance.old_short_size.to_s)
                  end %>
                  <td class="px-3 py-3 text-gray-500"><%= rebalance.id %></td>
                  <td class="px-3 py-3 text-gray-400"><%= rebalance.rebalanced_at&.strftime("%m/%d %H:%M") || "—" %></td>
                  <td class="px-3 py-3 text-gray-300"><%= rebalance.venue %></td>
                  <td class="px-3 py-3 text-gray-300"><%= [ rebalance.order_side, ("reduce-only" if rebalance.reduce_only) ].compact.join(" / ").presence || "—" %></td>
                  <td class="px-3 py-3 text-gray-300"><%= format_venue_eth_amount(rebalance.old_short_size) %></td>
                  <td class="px-3 py-3 text-gray-300"><%= format_venue_eth_amount(rebalance.new_short_size) %></td>
                  <td class="px-3 py-3 text-gray-300"><%= signed_eth_delta(rebalance_delta) %></td>
                  <td class="px-3 py-3 text-gray-300"><%= rebalance.realized_pnl ? format_usd(rebalance.realized_pnl) : "—" %></td>
                  <td class="px-3 py-3"><span class="rounded-full border px-2 py-1 text-xs <%= rebalance_status_class(rebalance.status) %>"><%= rebalance.status %></span></td>
                  <td class="max-w-xs break-words px-3 py-3 text-gray-400"><%= rebalance.message.presence || "—" %></td>
                  <td class="max-w-xs truncate px-3 py-3 text-gray-400" title="<%= rebalance.exchange_order_id %>"><%= rebalance.exchange_order_id.presence || "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="mt-4 text-sm text-gray-400">No <%= selected_venue_name %> rebalance history yet.</p>
      <% end %>
      <% if previous_history.any? %>
        <details class="mt-4 rounded-xl border border-gray-800 bg-gray-950/50 p-4">
          <summary class="cursor-pointer text-sm font-medium text-gray-200">Previous venue history (<%= previous_history.size %>)</summary>
          <div class="mt-3 overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-800 text-sm">
              <tbody class="divide-y divide-gray-800">
                <% previous_history.first(20).each do |rebalance| %>
                  <tr>
                    <td class="px-3 py-2 text-gray-400"><%= rebalance.rebalanced_at&.strftime("%m/%d %H:%M") || "—" %></td>
                    <td class="px-3 py-2 text-gray-300"><%= rebalance.venue %></td>
                    <td class="px-3 py-2 text-gray-300"><%= format_venue_eth_amount(rebalance.new_short_size) %></td>
                    <td class="px-3 py-2 text-gray-400"><%= rebalance.status %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </details>
      <% end %>
      <% attention_history = history_records.select { |record| record.status != ShortRebalance::STATUS_SUCCESS } %>
      <% if attention_history.any? %>
        <details class="mt-4 rounded-xl border border-yellow-900/70 bg-yellow-950/20 p-4">
          <summary class="cursor-pointer text-sm font-medium text-yellow-100">Failed / needs attention (<%= attention_history.size %>)</summary>
          <div class="mt-3 space-y-2 text-sm">
            <% attention_history.first(10).each do |rebalance| %>
              <div class="rounded-lg border border-yellow-900/50 bg-gray-950/60 p-3">
                <p class="text-yellow-100">#<%= rebalance.id %> · <%= HedgeVenues.label(rebalance.venue) %> · <%= rebalance.status %></p>
                <p class="mt-1 break-words text-xs text-yellow-200"><%= rebalance.message.presence || "No message" %></p>
              </div>
            <% end %>
          </div>
        </details>
      <% end %>
    </section>

    <section class="rounded-2xl border border-gray-800 bg-gray-900/80 p-5<%= tab_class.call('accounting') %>">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs uppercase tracking-wide text-gray-500">Hedge PnL & Costs</p>
          <h2 class="mt-1 text-lg font-semibold text-white">Optional accounting diagnostics</h2>
