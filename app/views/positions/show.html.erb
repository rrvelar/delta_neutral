<% position_valuation = @position_valuation || PositionValuation.current(@position) %>
<% aerodrome = aerodrome_position?(@position) %>
<% production_dashboard = @aerodrome_production_dashboard_status || {} %>
<% auto_status = @aerodrome_auto_rebalance_status || {} %>
<% selected_venue = @selected_hedge_venue || HedgeVenues.normalize(@position.hedge&.execution_venue) %>
<% selected_adapter = @selected_hedge_venue_adapter || (aerodrome ? HedgeVenues.build(selected_venue) : nil) %>
<% selected_venue_name = selected_adapter&.venue_name || HedgeVenues.label(selected_venue) %>
<% venue_dashboard = @selected_hedge_venue_dashboard || {} %>
<% selected_account_state = venue_dashboard[:account_state] || {} %>
<% selected_read_only_diagnostics = selected_account_state[:read_only_diagnostics] || {} %>
<% dashboard_status = production_dashboard.presence || {} %>
<% target_eth_short = dashboard_status[:target_hedge_eth] || venue_dashboard[:target_hedge_eth] %>
<% current_short_eth = dashboard_status[:current_short_eth] || venue_dashboard[:current_short_eth] %>
<% drift_eth = dashboard_status[:drift_eth] || venue_dashboard[:drift_eth] %>
<% tolerance_eth = venue_dashboard[:tolerance_eth] || auto_status[:tolerance_eth] %>
<% current_venue_position = dashboard_status[:current_venue_position] || venue_dashboard[:current_venue_position] || {} %>
<% margin_mode = dashboard_status[:margin_mode] || current_venue_position[:margin_mode] %>
<% effective_leverage = current_venue_position[:effective_leverage] || dashboard_status[:effective_leverage] %>
<% mark_price = dashboard_status[:mark_price] || current_venue_position[:mark_price] %>
<% current_notional = dashboard_status[:current_venue_notional_usd] || current_venue_position[:notional_usd] %>
<% entry_price = dashboard_status[:entry_price] || current_venue_position[:entry_price] %>
<% isolated_margin = dashboard_status[:isolated_margin_usd] || current_venue_position[:isolated_margin_usd] %>
<% drift_usd = dashboard_status[:drift_notional_usd] %>
<% rebalance_needed = dashboard_status[:rebalance_needed_now] || auto_status[:rebalance_needed] %>
<% tolerance_label = rebalance_needed ? "Needs Rebalance" : "Within Tolerance" %>
<% selected_live_enabled = selected_adapter&.live_enabled? %>
<% selected_live_supported = selected_adapter&.live_supported? %>
<% live_status_label = selected_live_enabled ? "Live Enabled" : (selected_live_supported ? "Live Gated" : "Read-only") %>
<% auto_gate_enabled = if selected_venue == "nado"
  ActiveModel::Type::Boolean.new.cast(ENV.fetch("AERODROME_NADO_AUTO_REBALANCE_ENABLED", "false"))
elsif selected_venue == "ethereal"
  ActiveModel::Type::Boolean.new.cast(ENV.fetch("AERODROME_ETHEREAL_AUTO_REBALANCE_ENABLED", "false"))
elsif selected_venue == "extended"
  false
else
  ActiveModel::Type::Boolean.new.cast(ENV.fetch("AERODROME_HEDGE_ENABLED", "false")) && !ActiveModel::Type::Boolean.new.cast(ENV.fetch("AERODROME_HEDGE_PAUSED", "true"))
end %>
<% auto_status_label = auto_gate_enabled ? "Auto Enabled" : "Auto Paused" %>
<% next_action = venue_dashboard[:next_action] || (rebalance_needed ? "rebalance" : "no-op") %>
<% action_preflights = venue_dashboard[:action_live_preflights] || {} %>
<% recommended_action_key = case next_action
when "open" then :open
when "increase short", "reduce short", "rebalance" then :rebalance
when "close" then :close
else :open
end %>
<% active_preflight = action_preflights[recommended_action_key] || venue_dashboard[:live_preflight] || {} %>
<% selected_action_blockers = (active_preflight[:blockers] || []).uniq %>
<% selected_action_warnings = (active_preflight[:warnings] || []).uniq %>
<% open_preview = venue_dashboard[:open_preview] || {} %>
<% migration_full_readiness = venue_dashboard[:migration_full_readiness] || {} %>
<% extended_auto_readiness = venue_dashboard[:auto_readiness] || {} %>
<% hedge_accounting = @hedge_venue_accounting || {} %>
<% accounting_components = hedge_accounting[:components] || {} %>
<% rewards_report = @aerodrome_rewards_report || {} %>
<% fees_report = @aerodrome_fees_report || {} %>
<% reward_value_state = rewards_report[:value_state].presence || (rewards_report[:claimable_aero_usd].present? ? (rewards_report[:claimable_aero_usd].to_s == "0" ? "verified_zero" : "estimated") : "unavailable") %>
<% fee_value_state = fees_report[:value_state].presence || (fees_report[:total_fees_usd].present? ? (fees_report[:total_fees_usd].to_s == "0" ? "verified_zero" : "estimated") : "unavailable") %>
<% rewards_usable = %w[estimated verified_zero detected].include?(reward_value_state) %>
<% fees_usable = %w[estimated verified_zero detected].include?(fee_value_state) %>
<% hedge_preview = aerodrome ? aerodrome_hedge_preview_for(@position) : nil %>
<% latest_snap = @pnl_snapshots.first %>
<% pool_unrealized = position_valuation.pool_delta_usd %>
<% pnl_execution_venue = HedgeVenues.normalize(dashboard_status[:execution_venue] || @position.hedge&.execution_venue) %>
<% venue_hedge_unrealized_raw = accounting_components.dig(:unrealized_pnl_usd, :value).presence || dashboard_status[:venue_hedge_unrealized_pnl_usd].presence %>
<% hedge_unrealized = pnl_execution_venue.in?(%w[nado ethereal extended]) ? (venue_hedge_unrealized_raw ? BigDecimal(venue_hedge_unrealized_raw.to_s) : nil) : (latest_snap&.hedge_unrealized || 0).to_d %>
<% hedge_unrealized_available = !hedge_unrealized.nil? %>
<% hedge_realized = if accounting_components.dig(:realized_pnl_usd, :value).present?
  BigDecimal(accounting_components.dig(:realized_pnl_usd, :value).to_s)
else
  (latest_snap&.hedge_realized || 0).to_d
end %>
<% total_unrealized = if pool_unrealized && hedge_unrealized_available
  pool_unrealized + hedge_unrealized
elsif pool_unrealized && !pnl_execution_venue.in?(%w[nado ethereal extended])
  pool_unrealized
elsif hedge_unrealized_available
  hedge_unrealized
end %>
<% total_pnl = total_unrealized ? total_unrealized + hedge_realized : nil %>
<% rewards_pnl = reward_value_state == "verified_zero" ? "0" : (rewards_usable ? rewards_report.fetch(:claimable_aero_usd, nil).presence : nil) %>
<% rewards_pnl = BigDecimal(rewards_pnl.to_s) if rewards_pnl %>
<% fees_pnl = fee_value_state == "verified_zero" ? "0" : (fees_usable ? fees_report.fetch(:total_fees_usd, nil).presence : nil) %>
<% fees_pnl = BigDecimal(fees_pnl.to_s) if fees_pnl %>
<% total_pnl_with_rewards = total_pnl && rewards_pnl ? total_pnl + rewards_pnl : nil %>
<% total_pnl_with_rewards_and_fees = total_pnl_with_rewards && fees_pnl ? total_pnl_with_rewards + fees_pnl : nil %>
<% mellow_asset0_value = @position.mellow_autopilot? && position_valuation.current_value_usd && position_valuation.usdc_exposure ? position_valuation.current_value_usd - position_valuation.usdc_exposure : nil %>
<% mellow_asset1_value = @position.mellow_autopilot? ? position_valuation.usdc_exposure : nil %>
<% current_short_label = "Current #{selected_venue_name} ETH short" %>
<% current_position_label = "Current #{selected_venue_name} ETH-PERP position" %>
<% drift_negative = begin
  drift_eth.present? && BigDecimal(drift_eth.to_s).negative?
rescue ArgumentError
  false
end %>

<div class="space-y-8">
  <section class="rounded-2xl border border-gray-800 bg-gray-900/80 p-5 shadow-2xl shadow-black/20">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
      <div class="min-w-0">
        <p class="text-xs uppercase tracking-wide text-gray-500">Position Control Center</p>
        <h1 class="mt-1 text-3xl font-semibold text-white"><%= @position.asset0 %>/<%= @position.asset1 %></h1>
        <p class="mt-2 text-sm text-gray-400">
          <%= @position.source_label %> &middot; <%= dex_display_name(@position) %> &middot; <%= chain_display_name(@position) %>
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="rounded-full border border-indigo-700 bg-indigo-950/60 px-3 py-1 text-xs font-semibold text-indigo-200">Selected Venue: <%= selected_venue_name %></span>
          <% if margin_mode.present? %>
            <span class="rounded-full border border-gray-700 bg-gray-950 px-3 py-1 text-xs font-semibold text-gray-200"><%= margin_mode.to_s == "isolated" ? "Isolated 1.0x" : "#{margin_mode.to_s.humanize} Margin" %></span>
          <% end %>
          <span class="rounded-full border <%= selected_live_enabled ? 'border-green-800 bg-green-950/60 text-green-300' : 'border-yellow-800 bg-yellow-950/60 text-yellow-200' %> px-3 py-1 text-xs font-semibold"><%= live_status_label %></span>
          <span class="rounded-full border <%= auto_gate_enabled ? 'border-green-800 bg-green-950/60 text-green-300' : 'border-gray-700 bg-gray-950 text-gray-300' %> px-3 py-1 text-xs font-semibold"><%= auto_status_label %></span>
          <span class="rounded-full border <%= rebalance_needed ? 'border-red-800 bg-red-950/60 text-red-200' : 'border-green-800 bg-green-950/60 text-green-300' %> px-3 py-1 text-xs font-semibold"><%= tolerance_label %></span>
        </div>
      </div>
      <div class="flex flex-wrap gap-3">
        <% if aerodrome %>
          <%= button_to "Refresh Read-only Data", sync_now_position_path(@position), method: :post, class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-gray-100 transition hover:bg-gray-700" %>
          <% proposal_button_path = @latest_aerodrome_hedge_proposal ? regenerate_position_aerodrome_hedge_proposals_path(@position) : position_aerodrome_hedge_proposals_path(@position) %>
          <% proposal_button_label = @latest_aerodrome_hedge_proposal ? "Regenerate Manual Hedge Proposal" : "Generate Manual Hedge Proposal" %>
          <%= button_to proposal_button_label, proposal_button_path, method: :post, class: "rounded-lg border border-yellow-800 bg-yellow-950/50 px-4 py-2 text-sm font-medium text-yellow-100 transition hover:bg-yellow-900/70" %>
        <% elsif @position.hedge %>
          <%= button_to "Sync Now", sync_now_position_path(@position), method: :post, class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-gray-100 transition hover:bg-gray-700" %>
          <%= link_to "View Hedge", hedge_path(@position.hedge), class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-gray-100 transition hover:bg-gray-700" %>
        <% else %>
          <%= button_to "Sync Now", sync_now_position_path(@position), method: :post, class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-gray-100 transition hover:bg-gray-700" %>
          <%= link_to "Create Hedge", new_hedge_path(position_id: @position.id), class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-gray-100 transition hover:bg-gray-700" %>
        <% end %>
      </div>
    </div>
  </section>

  <% if aerodrome %>
    <section>
      <div class="mb-3 flex items-center justify-between">
        <h2 class="text-lg font-semibold text-white">Portfolio Snapshot</h2>
        <span class="text-xs text-gray-500">Source of truth: <%= selected_venue_name %> readback + <%= @position.mellow_autopilot? ? "Mellow pro-rata accounting" : "Slipstream NFT accounting" %></span>
      </div>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
        <% [
          [ position_valuation.hedge_target_label, format_venue_eth_amount(position_valuation.weth_exposure), "WETH exposure" ],
          [ @position.mellow_autopilot? ? "Mellow USDC exposure" : "#{@position.asset1} amount", format_token_amount(position_valuation.usdc_exposure || @position.asset1_amount, decimals: 2), "USDC leg" ],
          [ position_valuation.current_value_label, valuation_value_display(position_valuation.current_value_usd), "Entry #{valuation_value_display(position_valuation.entry_value_usd)}" ],
          [ "Hedge venue", selected_venue_name, margin_mode.present? ? margin_mode.to_s.humanize : "margin unavailable" ],
          [ "Target hedge ETH", format_venue_eth_amount(target_eth_short), "Target short" ],
          [ current_short_label, format_venue_eth_amount(current_short_eth), "Exchange readback" ],
          [ "Drift", format_venue_eth_amount(drift_eth), drift_usd.present? ? format_venue_usd_amount(drift_usd) : "USD unavailable" ],
          [ "Net hedge PnL", format_venue_usd_amount(hedge_accounting[:net_venue_pnl_usd]), "Realized + unrealized + funding - fees - borrow" ],
          [ "Tolerance state", tolerance_label, "Tolerance #{format_venue_eth_amount(tolerance_eth)}" ],
          [ "Margin mode", margin_mode.present? ? (margin_mode.to_s == "isolated" ? "Isolated 1.0x" : margin_mode.to_s.humanize) : "Unavailable", selected_venue == "ethereal" ? "Ethereal cross only" : "Venue readback" ],
          [ "Effective leverage", effective_leverage.present? ? "#{number_with_precision(BigDecimal(effective_leverage.to_s), precision: 3)}x" : "Unavailable", current_notional.present? ? "Notional #{format_venue_usd_amount(current_notional)}" : "Notional unavailable" ],
          [ "Entry price", format_venue_usd_amount(entry_price), "Readback entry" ],
          [ "Mark price", format_venue_usd_amount(mark_price), "Readback mark" ],
          [ "Isolated margin", format_venue_usd_amount(isolated_margin), margin_mode.to_s == "isolated" ? "Isolated collateral" : "Not applicable" ]
        ].each do |label, value, detail| %>
          <div class="min-w-0 rounded-xl border border-gray-800 bg-gray-900 p-4">
            <p class="truncate text-xs uppercase tracking-wide text-gray-500"><%= label %></p>
            <p class="mt-2 truncate text-xl font-semibold text-white" title="<%= value %>"><%= value %></p>
            <p class="mt-1 truncate text-xs text-gray-500" title="<%= detail %>"><%= detail %></p>
          </div>
        <% end %>
      </div>
    </section>

    <section class="rounded-2xl border border-gray-800 bg-gray-900/80 p-5">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div>
          <p class="text-xs uppercase tracking-wide text-gray-500">Hedge Control Center</p>
          <h2 class="mt-1 text-xl font-semibold text-white"><%= selected_venue_name %> Hedge Actions</h2>
          <p class="mt-1 text-sm text-gray-400">Preview, confirm, submit, read back. Live actions stay gated until the exact venue confirmation is entered.</p>
        </div>
        <%= form_with url: hedge_venue_position_path(@position), method: :patch, class: "flex flex-col gap-2 sm:flex-row sm:items-end" do |form| %>
          <div>
            <%= form.label :hedge_venue, "Hedge venue", class: "block text-xs uppercase tracking-wide text-gray-500" %>
            <%= form.select :hedge_venue, options_for_select(@hedge_venue_options || HedgeVenues.options, selected_venue), {}, class: "mt-1 w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white" %>
          </div>
          <%= form.submit "Set Venue", class: "rounded-lg bg-gray-800 px-3 py-2 text-sm font-medium text-gray-100 hover:bg-gray-700" %>
        <% end %>
      </div>

      <div class="mt-5 grid grid-cols-1 gap-4 xl:grid-cols-3">
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4 xl:col-span-1">
          <p class="text-xs uppercase tracking-wide text-gray-500">Action Preview</p>
          <div class="mt-3 space-y-2 text-sm">
            <div class="flex justify-between gap-4"><span class="text-gray-500"><%= current_short_label %></span><span class="truncate text-white" title="<%= current_short_eth %>"><%= format_venue_eth_amount(current_short_eth) %> ETH</span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Target short</span><span class="truncate text-white" title="<%= target_eth_short %>"><%= format_venue_eth_amount(target_eth_short) %> ETH</span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Delta</span><span class="<%= drift_negative ? 'text-red-300' : 'text-green-300' %>" title="<%= drift_eth %>"><%= format_venue_eth_amount(drift_eth) %> ETH</span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Notional impact</span><span class="text-white"><%= format_venue_usd_amount(drift_usd) %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Mark price</span><span class="text-white"><%= format_venue_usd_amount(mark_price) %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Entry price</span><span class="text-white"><%= format_venue_usd_amount(entry_price) %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Isolated margin</span><span class="text-white"><%= format_venue_usd_amount(isolated_margin) %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Margin mode</span><span class="text-white"><%= margin_mode.present? ? margin_mode.to_s.humanize : "Unavailable" %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Estimated leverage</span><span class="text-white"><%= effective_leverage.present? ? "#{number_with_precision(BigDecimal(effective_leverage.to_s), precision: 3)}x" : "Unavailable" %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Next action</span><span class="<%= rebalance_needed ? 'text-yellow-200' : 'text-green-300' %>"><%= rebalance_needed ? next_action.to_s.humanize : "within tolerance / no-op" %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500"><%= current_position_label %></span><span class="text-white"><%= current_venue_position.present? ? "available" : "unavailable" %></span></div>
            <% if selected_venue == "extended" %>
              <div class="flex justify-between gap-4"><span class="text-gray-500">Extended position</span><span class="text-white"><%= selected_read_only_diagnostics[:current_position_status] || (current_venue_position.present? ? "position_present" : "no_position") %></span></div>
              <div class="flex justify-between gap-4"><span class="text-gray-500">Open orders</span><span class="text-white"><%= selected_account_state[:open_orders_count] || selected_read_only_diagnostics[:open_orders_count] || "Unavailable" %></span></div>
              <div class="flex justify-between gap-4"><span class="text-gray-500">Leverage gate</span><span class="text-white"><%= selected_read_only_diagnostics[:margin_gate_status] || selected_account_state.dig(:margin_gate, :status) || "unknown" %></span></div>
              <div class="flex justify-between gap-4"><span class="text-gray-500">Current leverage</span><span class="text-white"><%= selected_read_only_diagnostics[:current_leverage] || "Unavailable" %></span></div>
              <div class="flex justify-between gap-4"><span class="text-gray-500">Current margin</span><span class="text-white"><%= selected_read_only_diagnostics[:current_margin_mode] || "Unavailable" %></span></div>
              <div class="flex justify-between gap-4"><span class="text-gray-500">One-shot auto gate</span><span class="text-white"><%= ActiveModel::Type::Boolean.new.cast(ENV["EXTENDED_ONE_SHOT_REBALANCE_ENABLED"]) ? "enabled" : "disabled" %></span></div>
              <div class="flex justify-between gap-4"><span class="text-gray-500">Continuous auto</span><span class="text-white"><%= ActiveModel::Type::Boolean.new.cast(ENV["EXTENDED_AUTO_REBALANCE_ENABLED"]) ? "enabled" : "disabled" %></span></div>
              <div class="flex justify-between gap-4"><span class="text-gray-500">Auto readiness</span><span class="<%= extended_auto_readiness[:continuous_auto_ready] ? 'text-green-300' : 'text-yellow-200' %>"><%= extended_auto_readiness[:continuous_auto_ready] ? "ready" : "blocked" %></span></div>
              <div class="flex justify-between gap-4"><span class="text-gray-500">Planned auto</span><span class="text-white"><%= extended_auto_readiness[:planned_auto_action] || "unknown" %></span></div>
              <div class="flex justify-between gap-4"><span class="text-gray-500">Auto order size</span><span class="text-white"><%= format_venue_eth_amount(extended_auto_readiness[:planned_auto_order_size_eth]) %> ETH</span></div>
              <div class="flex justify-between gap-4"><span class="text-gray-500">Auto cap</span><span class="text-white"><%= format_venue_eth_amount(extended_auto_readiness[:auto_max_rebalance_size_eth]) %> ETH</span></div>
              <div class="flex justify-between gap-4"><span class="text-gray-500">Ethereal flat</span><span class="<%= extended_auto_readiness[:ethereal_flat] ? 'text-green-300' : 'text-yellow-200' %>"><%= extended_auto_readiness[:ethereal_flat].nil? ? "unknown" : extended_auto_readiness[:ethereal_flat] %></span></div>
              <div class="flex justify-between gap-4"><span class="text-gray-500">Nado flat</span><span class="<%= extended_auto_readiness[:nado_flat] ? 'text-green-300' : 'text-yellow-200' %>"><%= extended_auto_readiness[:nado_flat].nil? ? "unknown" : extended_auto_readiness[:nado_flat] %></span></div>
              <div class="flex justify-between gap-4"><span class="text-gray-500">Signer</span><span class="<%= extended_auto_readiness.dig(:signer_health, :ok) ? 'text-green-300' : 'text-yellow-200' %>"><%= extended_auto_readiness.dig(:signer_health, :ok) ? "ok" : "blocked" %></span></div>
            <% end %>
          </div>
          <% if hedge_preview && !hedge_preview.supported %>
            <div class="mt-4 rounded-lg border border-yellow-900 bg-yellow-950/30 p-3">
              <p class="text-xs font-semibold text-yellow-100">Hedge preview unavailable</p>
              <p class="mt-1 break-words text-xs text-yellow-200"><%= hedge_preview.reason %></p>
            </div>
          <% end %>
          <% if selected_adapter&.venue_name == "Ethereal" %>
            <p class="mt-4 rounded-lg border border-indigo-900 bg-indigo-950/30 p-3 text-xs text-indigo-100">Ethereal uses cross margin only. Effective leverage is estimated from position notional / account collateral.</p>
          <% end %>
          <% if selected_venue == "extended" %>
            <div class="mt-4 rounded-lg border border-yellow-900 bg-yellow-950/30 p-3 text-xs text-yellow-100">
              <p>Manual live supported; auto disabled. Signer must be running; key stored outside Rails. Use close_only after probe.</p>
              <p class="mt-2 text-yellow-100">Extended manual live proven. Auto requires explicit gate.</p>
              <p class="mt-2 text-yellow-100">Migration is stepwise. Production venue is not switched until finalize succeeds.</p>
              <p class="mt-2 text-yellow-100">Fast migration is available as a gated dry-run/live task. Extended-first temporarily overhedges until Ethereal close confirms.</p>
              <p class="mt-2 text-yellow-100">Required: 1x isolated.</p>
              <p class="mt-2 text-yellow-200">Extended mainnet order submit is implemented behind explicit live gates. Dry-runs do not sign or submit orders.</p>
              <% if migration_full_readiness.present? %>
                <div class="mt-3 grid grid-cols-2 gap-2 border-t border-yellow-900/60 pt-3">
                  <div><span class="text-yellow-300">Ethereal short</span><br><%= format_venue_eth_amount(migration_full_readiness[:ethereal_short_eth]) %> ETH</div>
                  <div><span class="text-yellow-300">Extended short</span><br><%= format_venue_eth_amount(migration_full_readiness[:extended_short_eth]) %> ETH</div>
                  <div><span class="text-yellow-300">Target</span><br><%= format_venue_eth_amount(migration_full_readiness[:target_short_eth]) %> ETH</div>
                  <div><span class="text-yellow-300">Expected final</span><br><%= format_venue_eth_amount(migration_full_readiness[:expected_extended_short_after]) %> ETH Extended / <%= format_venue_eth_amount(migration_full_readiness[:expected_ethereal_short_after]) %> ETH Ethereal</div>
                </div>
              <% end %>
              <% if extended_auto_readiness[:blockers].present? %>
                <p class="mt-3 break-words border-t border-yellow-900/60 pt-3 text-yellow-200">Continuous auto readiness blockers: <%= extended_auto_readiness[:blockers].uniq.join("; ") %></p>
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="space-y-4 xl:col-span-2">
          <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <p class="text-xs uppercase tracking-wide text-gray-500">Live Gates</p>
                <p class="mt-1 text-sm text-gray-300"><%= live_status_label %> for <%= selected_venue_name %>. Preview actions do not create orders.</p>
              </div>
              <span class="rounded-full border <%= selected_action_blockers.blank? ? 'border-green-800 bg-green-950/50 text-green-300' : 'border-yellow-800 bg-yellow-950/50 text-yellow-200' %> px-3 py-1 text-xs font-semibold"><%= selected_action_blockers.blank? ? "Preflight clear" : "#{selected_action_blockers.size} blocker#{'s' unless selected_action_blockers.size == 1}" %></span>
            </div>
            <% if selected_action_blockers.present? %>
              <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-yellow-100">
                <% selected_action_blockers.each do |blocker| %>
                  <li class="break-words"><%= blocker %></li>
                <% end %>
              </ul>
            <% else %>
              <p class="mt-3 text-sm text-green-200">No live preflight blockers reported for the planned action.</p>
            <% end %>
            <% if selected_action_warnings.present? %>
              <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-yellow-200">
                <% selected_action_warnings.each do |warning| %>
                  <li class="break-words"><%= warning %></li>
                <% end %>
              </ul>
            <% end %>
            <% if selected_venue == "ethereal" && @position.hedge&.execution_venue != "ethereal" %>
              <p class="mt-3 text-sm text-yellow-200">Current active hedge venue is <%= HedgeVenues.label(@position.hedge&.execution_venue) %>; opening Ethereal would create a second hedge unless migration is intended.</p>
            <% end %>
            <% unless selected_adapter&.live_enabled? %>
              <p class="mt-3 text-sm text-yellow-200">Live submit is disabled for <%= selected_venue_name %>; previews do not create orders.</p>
            <% end %>
          </div>

          <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
            <% [
              [ :open, hedge_open_preview_position_path(@position), hedge_open_position_path(@position), "Open Hedge" ],
              [ :rebalance, hedge_rebalance_preview_position_path(@position), hedge_rebalance_position_path(@position), "Rebalance Hedge" ],
              [ :close, hedge_close_preview_position_path(@position), hedge_close_position_path(@position), "Close Hedge" ]
            ].each do |key, preview_path, live_path, label| %>
              <% action_preflight = action_preflights[key] || {} %>
              <% action_blockers = (action_preflight[:blockers] || []).uniq.reject { |blocker| blocker.to_s.start_with?("submitted confirmation must equal") } %>
              <% action_needed = case key
              when :open then next_action == "open"
              when :rebalance then next_action.in?([ "increase short", "reduce short", "rebalance" ])
              when :close then BigDecimal(current_short_eth.to_s).positive? rescue false
              end %>
              <% required_phrase = selected_venue == "nado" ? AerodromeDashboardHedgeAction::NADO_CONFIRMATION : (selected_venue == "ethereal" ? AerodromeDashboardHedgeAction::ETHEREAL_CONFIRMATION : (selected_venue == "extended" ? AerodromeDashboardHedgeAction::EXTENDED_CONFIRMATION : (key == :close ? AerodromeLiveEmergencyClose::CONFIRMATION : AerodromeDashboardHedgeAction::CONFIRMATION))) %>
              <% confirmation_enabled = action_needed && selected_adapter&.live_enabled? && action_blockers.blank? %>
              <% submit_id = "dashboard-hedge-live-submit-#{key}" %>
              <div class="rounded-xl border <%= action_needed ? 'border-indigo-800 bg-indigo-950/20' : 'border-gray-800 bg-gray-950/40 opacity-80' %> p-4">
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <p class="font-medium text-white"><%= label %></p>
                    <p class="mt-1 text-xs text-gray-500"><%= action_needed ? "Relevant now" : "Not needed now" %></p>
                  </div>
                  <% if key == recommended_action_key && next_action != "no-op" %>
                    <span class="rounded-full border border-indigo-700 bg-indigo-950 px-2 py-1 text-[11px] text-indigo-200">planned</span>
                  <% end %>
                </div>
                <div class="mt-3">
                  <%= button_to "#{label} Preview", preview_path, method: :post, params: { hedge_venue: selected_venue }, disabled: !action_needed, class: "w-full rounded-lg bg-gray-800 px-3 py-2 text-xs font-medium text-gray-100 transition hover:bg-gray-700 disabled:bg-gray-900 disabled:text-gray-600" %>
                </div>
                <% if action_needed %>
                  <div class="mt-3 rounded-lg border border-gray-800 bg-gray-950 p-2">
                    <p class="text-xs text-gray-500">Required phrase</p>
                    <code id="dashboard-hedge-phrase-<%= key %>" class="mt-1 block break-all text-[11px] text-gray-200"><%= required_phrase %></code>
                  </div>
                  <%= form_with url: live_path, method: :post, class: "mt-3" do |form| %>
                    <%= form.hidden_field :hedge_venue, value: selected_venue %>
                    <%= form.text_field :dashboard_hedge_confirmation,
                      id: "dashboard-hedge-confirmation-#{key}",
                      placeholder: required_phrase,
                      value: "",
                      autocomplete: "off",
                      disabled: !confirmation_enabled,
                      data: { required_confirmation: required_phrase, live_submit_id: submit_id },
                      oninput: "document.getElementById(this.dataset.liveSubmitId).disabled = this.value !== this.dataset.requiredConfirmation",
                      class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-2 py-2 text-xs text-white placeholder-gray-600 disabled:border-gray-800 disabled:text-gray-600" %>
                    <%= form.submit "#{label} Live", id: submit_id, disabled: true, class: "mt-2 w-full rounded-lg border border-red-800 bg-red-950/70 px-3 py-2 text-xs font-semibold text-red-100 transition hover:bg-red-900 disabled:border-gray-800 disabled:bg-gray-900 disabled:text-gray-600" %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </section>

    <section class="rounded-2xl border border-gray-800 bg-gray-900/80 p-5">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <p class="text-xs uppercase tracking-wide text-gray-500">Auto-Rebalance Status</p>
          <h2 class="mt-1 text-lg font-semibold text-white"><%= auto_status[:auto_rebalance_status].to_s.humanize.presence || "Unavailable" %></h2>
          <% if auto_status[:auto_rebalance_message].present? %>
            <p class="mt-1 text-sm text-gray-400"><%= auto_status[:auto_rebalance_message] %></p>
          <% end %>
        </div>
        <div class="grid grid-cols-2 gap-3 text-sm md:grid-cols-4">
          <div><p class="text-xs text-gray-500">Position sync</p><p class="text-white"><%= auto_status.dig(:scheduler, :position_sync_schedule).presence || "every minute" %></p></div>
          <div><p class="text-xs text-gray-500">Hedge sync</p><p class="text-white"><%= auto_status.dig(:scheduler, :hedge_sync_schedule).presence || "every 5 minutes" %></p></div>
          <div><p class="text-xs text-gray-500">Selected venue</p><p class="text-white"><%= auto_status[:execution_venue_name] || selected_venue_name %></p></div>
          <div><p class="text-xs text-gray-500">Last rebalance</p><p class="text-white"><%= auto_status[:last_rebalance_time]&.strftime("%m/%d %H:%M") || "None" %></p></div>
        </div>
      </div>
      <div class="mt-4 grid grid-cols-2 gap-3 text-sm md:grid-cols-4">
        <div class="rounded-lg border border-gray-800 bg-gray-950/60 p-3"><p class="text-xs text-gray-500">Current drift</p><p class="mt-1 text-white"><%= format_venue_eth_amount(auto_status[:current_drift_eth] || drift_eth) %></p></div>
        <div class="rounded-lg border border-gray-800 bg-gray-950/60 p-3"><p class="text-xs text-gray-500">Tolerance</p><p class="mt-1 text-white"><%= format_venue_eth_amount(auto_status[:tolerance_eth] || tolerance_eth) %></p></div>
        <div class="rounded-lg border border-gray-800 bg-gray-950/60 p-3"><p class="text-xs text-gray-500">Rebalance needed now</p><p class="<%= auto_status[:rebalance_needed] ? 'text-red-300' : 'text-green-300' %> mt-1"><%= auto_status[:rebalance_needed] ? "yes" : "no" %></p></div>
        <div class="rounded-lg border border-gray-800 bg-gray-950/60 p-3"><p class="text-xs text-gray-500">Manage</p><%= link_to "Settings", edit_settings_path, class: "mt-1 inline-block text-indigo-300 hover:text-indigo-200" %></div>
      </div>
      <% auto_messages = ((auto_status[:blockers] || []) + (auto_status[:warnings] || [])).uniq %>
      <% if auto_messages.present? %>
        <ul class="mt-4 list-disc space-y-1 pl-5 text-sm text-yellow-100">
          <% auto_messages.each do |message| %><li><%= message %></li><% end %>
        </ul>
      <% end %>
    </section>

    <% history_report = @aerodrome_rebalance_history_status || {} %>
    <% history_records = history_report[:records] || [] %>
    <% selected_history = history_records.select { |record| HedgeVenues.normalize(record.venue) == selected_venue } %>
    <% previous_history = history_records.reject { |record| HedgeVenues.normalize(record.venue) == selected_venue } %>
    <section class="rounded-2xl border border-gray-800 bg-gray-900/80 p-5">
      <div class="flex items-center justify-between gap-3">
        <div>
          <p class="text-xs uppercase tracking-wide text-gray-500">Recent Rebalance History</p>
          <h2 class="mt-1 text-lg font-semibold text-white"><%= selected_venue_name %> history</h2>
        </div>
        <span class="rounded-full border border-gray-700 bg-gray-950 px-3 py-1 text-xs text-gray-300"><%= selected_history.size %> selected-venue rows</span>
      </div>
      <% if selected_history.any? %>
        <div class="mt-4 overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-800 text-sm">
            <thead class="text-left text-xs uppercase tracking-wide text-gray-500">
              <tr><th class="px-3 py-2">ID</th><th class="px-3 py-2">Time</th><th class="px-3 py-2">Venue</th><th class="px-3 py-2">Side</th><th class="px-3 py-2">Old</th><th class="px-3 py-2">New</th><th class="px-3 py-2">Delta</th><th class="px-3 py-2">Realized</th><th class="px-3 py-2">Status</th><th class="px-3 py-2">Message</th><th class="px-3 py-2">Order</th></tr>
            </thead>
            <tbody class="divide-y divide-gray-800">
              <% selected_history.first(12).each do |rebalance| %>
                <tr>
                  <% rebalance_delta = if rebalance.old_short_size && rebalance.new_short_size
                    BigDecimal(rebalance.new_short_size.to_s) - BigDecimal(rebalance.old_short_size.to_s)
                  end %>
                  <td class="px-3 py-3 text-gray-500"><%= rebalance.id %></td>
                  <td class="px-3 py-3 text-gray-400"><%= rebalance.rebalanced_at&.strftime("%m/%d %H:%M") || "—" %></td>
                  <td class="px-3 py-3 text-gray-300"><%= rebalance.venue %></td>
                  <td class="px-3 py-3 text-gray-300"><%= [ rebalance.order_side, ("reduce-only" if rebalance.reduce_only) ].compact.join(" / ").presence || "—" %></td>
                  <td class="px-3 py-3 text-gray-300"><%= format_venue_eth_amount(rebalance.old_short_size) %></td>
                  <td class="px-3 py-3 text-gray-300"><%= format_venue_eth_amount(rebalance.new_short_size) %></td>
                  <td class="px-3 py-3 text-gray-300"><%= signed_eth_delta(rebalance_delta) %></td>
                  <td class="px-3 py-3 text-gray-300"><%= rebalance.realized_pnl ? format_usd(rebalance.realized_pnl) : "—" %></td>
                  <td class="px-3 py-3"><span class="rounded-full border px-2 py-1 text-xs <%= rebalance_status_class(rebalance.status) %>"><%= rebalance.status %></span></td>
                  <td class="max-w-xs break-words px-3 py-3 text-gray-400"><%= rebalance.message.presence || "—" %></td>
                  <td class="max-w-xs truncate px-3 py-3 text-gray-400" title="<%= rebalance.exchange_order_id %>"><%= rebalance.exchange_order_id.presence || "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="mt-4 text-sm text-gray-400">No <%= selected_venue_name %> rebalance history yet.</p>
      <% end %>
      <% if previous_history.any? %>
        <details class="mt-4 rounded-xl border border-gray-800 bg-gray-950/50 p-4">
          <summary class="cursor-pointer text-sm font-medium text-gray-200">Previous venue history (<%= previous_history.size %>)</summary>
          <div class="mt-3 overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-800 text-sm">
              <tbody class="divide-y divide-gray-800">
                <% previous_history.first(20).each do |rebalance| %>
                  <tr>
                    <td class="px-3 py-2 text-gray-400"><%= rebalance.rebalanced_at&.strftime("%m/%d %H:%M") || "—" %></td>
                    <td class="px-3 py-2 text-gray-300"><%= rebalance.venue %></td>
                    <td class="px-3 py-2 text-gray-300"><%= format_venue_eth_amount(rebalance.new_short_size) %></td>
                    <td class="px-3 py-2 text-gray-400"><%= rebalance.status %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </details>
      <% end %>
    </section>

    <section class="rounded-2xl border border-gray-800 bg-gray-900/80 p-5">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs uppercase tracking-wide text-gray-500">Hedge PnL & Costs</p>
          <h2 class="mt-1 text-lg font-semibold text-white"><%= selected_venue_name %> venue accounting</h2>
        </div>
        <p class="text-sm text-gray-400">Missing venue components are shown as unavailable, not as zero.</p>
      </div>
      <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-3 xl:grid-cols-6">
        <% [
          [ "Unrealized hedge PnL", accounting_components.dig(:unrealized_pnl_usd, :value), accounting_components.dig(:unrealized_pnl_usd, :state), accounting_components.dig(:unrealized_pnl_usd, :source) ],
          [ "Realized hedge PnL", accounting_components.dig(:realized_pnl_usd, :value), accounting_components.dig(:realized_pnl_usd, :state), accounting_components.dig(:realized_pnl_usd, :source) ],
          [ "Trading fees", accounting_components.dig(:trading_fees_usd, :value), accounting_components.dig(:trading_fees_usd, :state), accounting_components.dig(:trading_fees_usd, :source) ],
          [ "Funding", accounting_components.dig(:funding_pnl_usd, :value), accounting_components.dig(:funding_pnl_usd, :state), accounting_components.dig(:funding_pnl_usd, :source) ],
          [ "Borrow / interest", accounting_components.dig(:borrow_interest_usd, :value), accounting_components.dig(:borrow_interest_usd, :state), accounting_components.dig(:borrow_interest_usd, :source) ],
          [ "Net hedge PnL", hedge_accounting[:net_venue_pnl_usd], hedge_accounting[:net_venue_pnl_usd].present? ? "available" : "unavailable", "realized + unrealized + funding - fees - borrow + rebates" ]
        ].each do |label, value, state, source| %>
          <div class="min-w-0 rounded-xl border border-gray-800 bg-gray-950/60 p-4">
            <p class="text-xs text-gray-500"><%= label %></p>
            <p class="mt-2 text-lg font-semibold <%= value.present? && BigDecimal(value.to_s) < 0 ? 'text-red-300' : 'text-white' rescue 'text-white' %>"><%= value.present? ? format_venue_usd_amount(value) : "Unavailable" %></p>
            <p class="mt-1 break-words text-xs text-gray-500"><%= state.presence || "unavailable" %> · <%= source.presence || "venue does not expose this component" %></p>
          </div>
        <% end %>
      </div>
      <% fee_rates = hedge_accounting[:fee_rates] || {} %>
      <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-3">
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4">
          <p class="text-xs text-gray-500">Fee tier / rate</p>
          <p class="mt-2 text-sm text-white"><%= fee_rates.present? ? fee_rates.map { |key, value| "#{key.to_s.humanize}: #{value}" }.join(" · ") : "Unavailable" %></p>
        </div>
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4 md:col-span-2">
          <p class="text-xs text-gray-500">Unavailable components</p>
          <p class="mt-2 break-words text-sm text-white"><%= (hedge_accounting[:unavailable_components] || []).map { |key| key.to_s.humanize }.presence&.join(", ") || "None" %></p>
        </div>
      </div>
    </section>

    <section class="grid grid-cols-1 gap-4 xl:grid-cols-3">
      <div class="rounded-2xl border border-gray-800 bg-gray-900/80 p-5 xl:col-span-2">
        <p class="text-xs uppercase tracking-wide text-gray-500">PnL & Rewards</p>
        <h2 class="mt-1 text-lg font-semibold text-white">PnL Summary</h2>
        <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-3">
              <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4"><p class="text-xs text-gray-500">Total PnL Excluding Rewards / Fees</p><p class="mt-2 text-xl font-semibold <%= (total_pnl || 0) >= 0 ? 'text-green-300' : 'text-red-300' %>"><%= total_pnl ? format_usd(total_pnl) : "Unavailable" %></p></div>
              <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4"><p class="text-xs text-gray-500">Total unrealized</p><p class="mt-2 text-xl font-semibold <%= (total_unrealized || 0) >= 0 ? 'text-green-300' : 'text-red-300' %>"><%= total_unrealized ? format_usd(total_unrealized) : "Unavailable" %></p><p class="mt-1 text-xs text-gray-500">Pool <%= pool_unrealized ? format_usd(pool_unrealized) : "Unavailable" %> / Hedge <%= hedge_unrealized_available ? format_usd(hedge_unrealized) : "Unavailable" %></p></div>
              <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4"><p class="text-xs text-gray-500">Realized</p><p class="mt-2 text-xl font-semibold <%= hedge_realized >= 0 ? 'text-green-300' : 'text-red-300' %>"><%= format_usd(hedge_realized) %></p></div>
              <div class="min-w-0 rounded-xl border border-gray-800 bg-gray-950/60 p-4">
                <p class="text-xs text-gray-500"><%= rewards_report[:reward_source] == "mellow_ui_parity_eth_call" ? "Mellow UI-parity AERO rewards estimate" : (rewards_report[:strategy_level_estimate] ? "Mellow pro-rata AERO rewards estimate" : "AERO rewards estimate") %></p>
                <p class="mt-2 text-xl font-semibold text-white"><%= rewards_pnl ? format_usd(rewards_pnl) : "Unavailable" %></p>
                <p class="mt-1 break-words text-xs text-gray-500" title="<%= rewards_report[:stop_reason] || rewards_report[:warnings]&.first %>"><%= reward_value_state == "verified_zero" ? "Verified zero from readable reward source." : (reward_value_state == "estimated" ? (rewards_report[:reward_source] == "mellow_ui_parity_eth_call" ? "Read-only Mellow UI-parity estimate. Claiming is not implemented." : "Strategy-level read-only estimate.") : (reward_value_state == "unverified_mismatch" ? "Unverified estimate; excluded from Total PnL." : (rewards_report[:stop_reason].presence || rewards_report[:warnings]&.first.presence || "Claiming is not implemented."))) %></p>
              </div>
              <div class="min-w-0 rounded-xl border border-gray-800 bg-gray-950/60 p-4">
                <p class="text-xs text-gray-500"><%= fees_report[:fee_label].presence || "LP fees estimate" %></p>
                <p class="mt-2 text-xl font-semibold text-white"><%= fees_pnl ? format_usd(fees_pnl) : "Unavailable" %></p>
                <p class="mt-1 break-words text-xs text-gray-500" title="<%= fees_report[:stop_reason] || fees_report[:warnings]&.first %>"><%= fee_value_state == "verified_zero" ? "Verified zero from readable fee source." : (fee_value_state == "estimated" ? "Strategy-level read-only estimate." : (fees_report[:stop_reason].presence || fees_report[:warnings]&.first.presence || "Collecting is not implemented.")) %></p>
              </div>
              <div class="min-w-0 rounded-xl border border-gray-800 bg-gray-950/60 p-4">
                <p class="text-xs text-gray-500">Total PnL Including Unclaimed AERO Rewards Estimate</p>
                <p class="mt-2 text-xl font-semibold <%= (total_pnl_with_rewards || 0) >= 0 ? 'text-green-300' : 'text-red-300' %>"><%= total_pnl_with_rewards ? format_usd(total_pnl_with_rewards) : "Unavailable" %></p>
                <p class="mt-1 break-words text-xs text-gray-500"><%= rewards_pnl ? "Pool + hedge + reward estimate. Unclaimed rewards are not realized until claimed/sold." : "Base only; rewards unavailable." %></p>
              </div>
              <div class="min-w-0 rounded-xl border border-gray-800 bg-gray-950/60 p-4">
                <p class="text-xs text-gray-500">Total PnL Including Rewards + LP Fees Estimate</p>
                <p class="mt-2 text-xl font-semibold <%= (total_pnl_with_rewards_and_fees || 0) >= 0 ? 'text-green-300' : 'text-red-300' %>"><%= total_pnl_with_rewards_and_fees ? format_usd(total_pnl_with_rewards_and_fees) : "Unavailable" %></p>
                <p class="mt-1 break-words text-xs text-gray-500"><%= total_pnl_with_rewards_and_fees ? "Pool + hedge + reward and LP fee estimates." : "Rewards or LP fee estimate unavailable; combined total not shown. Including fees unavailable." %></p>
              </div>
            </div>
            <% if pnl_execution_venue.in?(%w[nado ethereal extended]) %>
              <p class="mt-4 rounded-lg border border-gray-800 bg-gray-950/60 p-3 text-xs text-gray-400">
                <% if hedge_unrealized_available %>
                  <%= HedgeVenues.label(pnl_execution_venue) %> short PnL uses readback entry price minus mark price times short size.
                <% else %>
                  <%= dashboard_status[:venue_hedge_pnl_message].presence || "#{HedgeVenues.label(pnl_execution_venue)} hedge PnL unavailable: readback missing entry price." %>
                <% end %>
              </p>
            <% end %>
            <% if position_valuation.warnings.present? %>
              <ul class="mt-4 list-disc space-y-1 pl-5 text-sm text-yellow-100">
                <% position_valuation.warnings.each do |warning| %>
                  <li><%= warning %></li>
                <% end %>
              </ul>
            <% end %>
            <details class="mt-4 rounded-xl border border-gray-800 bg-gray-950/50 p-4">
              <summary class="cursor-pointer text-sm font-medium text-gray-200">Rewards and Fee Readback Details</summary>
              <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2">
                <div class="min-w-0 rounded-lg border border-gray-800 bg-gray-950 p-4">
                  <h3 class="text-sm font-semibold text-white">AERO Rewards</h3>
                  <p class="mt-1 text-xs text-gray-500">Read-only. Claiming is not implemented. Rewards are not included in Total PnL.</p>
                  <dl class="mt-3 space-y-2 text-sm">
                    <div class="flex justify-between gap-4"><dt class="text-gray-500">Status</dt><dd class="text-right text-white"><%= rewards_report[:status].presence || "unavailable" %></dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-gray-500">Value state</dt><dd class="text-right text-white"><%= reward_value_state %></dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-gray-500">Stop reason</dt><dd class="break-words text-right text-white" title="<%= rewards_report[:stop_reason] %>"><%= rewards_report[:stop_reason].presence || "none" %></dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-gray-500">Gauge status</dt><dd class="text-right text-white"><%= rewards_report[:gauge_status].presence || "unavailable" %></dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-gray-500">Token source</dt><dd class="break-all text-right text-white"><%= rewards_report[:token_source].presence || "unavailable" %></dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-gray-500"><%= rewards_report[:reward_label].presence || "Claimable AERO" %></dt><dd class="text-right text-white"><%= format_venue_eth_amount(rewards_report[:claimable_aero]) %></dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-gray-500"><%= rewards_report[:strategy_level_estimate] ? "Mellow pro-rata AERO USD estimate" : "Claimable AERO USD" %></dt><dd class="text-right text-white"><%= format_venue_usd_amount(rewards_report[:claimable_aero_usd]) %></dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-gray-500">AERO USD price</dt><dd class="text-right text-white"><%= rewards_report[:aero_usd_price].present? ? "$#{format_venue_eth_amount(rewards_report[:aero_usd_price])}" : "unavailable" %></dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-gray-500">AERO USD price source</dt><dd class="text-right text-white"><%= rewards_report[:aero_usd_price_source].presence || "unavailable" %></dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-gray-500">Staked</dt><dd class="text-right text-white"><%= rewards_report.key?(:staked) ? rewards_report[:staked].to_s : "unavailable" %></dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-gray-500">Depositor</dt><dd class="break-all text-right text-white"><%= rewards_report[:depositor_address].presence || "unavailable" %></dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-gray-500">Depositor source</dt><dd class="text-right text-white"><%= rewards_report[:depositor_source].presence || "unavailable" %></dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-gray-500">Gauge</dt><dd class="break-all text-right text-white"><%= rewards_report[:gauge_address].presence || "unavailable" %></dd></div>
                  </dl>
                  <% if rewards_report[:warnings].present? %>
                    <ul class="mt-3 list-disc space-y-1 pl-5 text-xs text-yellow-100">
                      <% rewards_report[:warnings].each do |warning| %><li><%= warning %></li><% end %>
                    </ul>
                  <% end %>
                </div>
                <div class="min-w-0 rounded-lg border border-gray-800 bg-gray-950 p-4">
                  <h3 class="text-sm font-semibold text-white"><%= fees_report[:fee_label].presence || "Aerodrome LP Fees" %></h3>
                  <p class="mt-1 text-xs text-gray-500">Unclaimed fees are not realized PnL until collected.</p>
                  <dl class="mt-3 space-y-2 text-sm">
                    <div class="flex justify-between gap-4"><dt class="text-gray-500">Status</dt><dd class="text-right text-white"><%= fees_report[:status].presence || "unavailable" %></dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-gray-500">Value state</dt><dd class="text-right text-white"><%= fee_value_state %></dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-gray-500">Stop reason</dt><dd class="break-words text-right text-white" title="<%= fees_report[:stop_reason] %>"><%= fees_report[:stop_reason].presence || "none" %></dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-gray-500">Fee source</dt><dd class="break-all text-right text-white"><%= fees_report[:fee_source].presence || "unavailable" %></dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-gray-500">Token ID</dt><dd class="break-all text-right text-white"><%= fees_report[:token_id].presence || @position.external_id %></dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-gray-500"><%= fees_report[:fee0_symbol].presence || @position.asset0 %> fees</dt><dd class="text-right text-white"><%= format_venue_eth_amount(fees_report[:fee0_amount]) %> <%= fees_report[:fee0_symbol] %> / <%= format_venue_usd_amount(fees_report[:fee0_usd]) %></dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-gray-500"><%= fees_report[:fee1_symbol].presence || @position.asset1 %> fees</dt><dd class="text-right text-white"><%= format_venue_eth_amount(fees_report[:fee1_amount]) %> <%= fees_report[:fee1_symbol] %> / <%= format_venue_usd_amount(fees_report[:fee1_usd]) %></dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-gray-500">Total fees</dt><dd class="text-right text-white"><%= format_venue_usd_amount(fees_report[:total_fees_usd]) %></dd></div>
                  </dl>
                  <% if fees_report[:warnings].present? %>
                    <ul class="mt-3 list-disc space-y-1 pl-5 text-xs text-yellow-100">
                      <% fees_report[:warnings].each do |warning| %><li><%= warning %></li><% end %>
                    </ul>
                  <% end %>
                </div>
              </div>
            </details>
          </div>

      <div class="space-y-4">
        <details class="rounded-2xl border border-gray-800 bg-gray-900/80 p-5">
          <summary class="cursor-pointer text-sm font-semibold text-white">Position Details</summary>
          <dl class="mt-4 space-y-2 text-sm">
            <div class="flex justify-between gap-4"><dt class="text-gray-500">DEX</dt><dd class="text-white"><%= dex_display_name(@position) %></dd></div>
            <div class="flex justify-between gap-4"><dt class="text-gray-500">Source</dt><dd class="text-white"><%= @position.source_label %></dd></div>
            <div class="flex justify-between gap-4"><dt class="text-gray-500">Token ID</dt><dd class="text-white"><%= @position.external_id %></dd></div>
            <div class="flex justify-between gap-4"><dt class="text-gray-500">Pool</dt><dd class="break-all text-right text-white"><%= @position.pool_address %></dd></div>
            <div class="flex justify-between gap-4"><dt class="text-gray-500"><%= position_valuation.entry_value_label %></dt><dd class="text-white"><%= valuation_value_display(position_valuation.entry_value_usd) %></dd></div>
            <div class="flex justify-between gap-4"><dt class="text-gray-500"><%= position_valuation.pool_delta_label %></dt><dd class="text-white"><%= pool_unrealized ? format_usd(pool_unrealized) : "Unavailable" %></dd></div>
          </dl>
        </details>

        <% if @position.mellow_autopilot? %>
          <% mellow = @position.mellow_metadata_hash %>
          <details class="rounded-2xl border border-gray-800 bg-gray-900/80 p-5">
            <summary class="cursor-pointer text-sm font-semibold text-white">Mellow Autopilot Accounting</summary>
            <dl class="mt-4 space-y-2 text-sm">
              <div class="flex justify-between gap-4"><dt class="text-gray-500">Observed strategy token ID</dt><dd class="text-white"><%= mellow["strategy_token_id"].presence || @position.external_id %></dd></div>
              <div class="flex justify-between gap-4"><dt class="text-gray-500">Share token</dt><dd class="break-all text-right text-white"><%= mellow["share_token"].presence || "unavailable" %></dd></div>
              <div class="flex justify-between gap-4"><dt class="text-gray-500">User share %</dt><dd class="text-white"><%= format_percent_amount(mellow["user_share_percent"]) %></dd></div>
              <div class="flex justify-between gap-4"><dt class="text-gray-500">User WETH exposure</dt><dd class="text-white"><%= format_venue_eth_amount(mellow["user_weth_exposure"].presence || @position.asset0_amount) %></dd></div>
              <div class="flex justify-between gap-4"><dt class="text-gray-500">User USDC exposure</dt><dd class="text-white"><%= format_token_amount(mellow["user_usdc_exposure"].presence || @position.asset1_amount, decimals: 2) %></dd></div>
              <div class="flex justify-between gap-4"><dt class="text-gray-500">Confidence</dt><dd class="text-white"><%= mellow["last_probe_confidence"].presence || "unavailable" %></dd></div>
            </dl>
          </details>
        <% end %>

        <details class="rounded-2xl border border-gray-800 bg-gray-900/80 p-5">
          <summary class="cursor-pointer text-sm font-semibold text-white">Manual Proposal History</summary>
          <% proposals = @aerodrome_hedge_proposals || [] %>
          <% if proposals.any? %>
            <div class="mt-4 space-y-2">
              <% proposals.each do |proposal| %>
                <% safety = @aerodrome_proposal_safety_results&.fetch(proposal.id, nil) %>
                <% stale_reasons = proposal.stale_reasons(@position) %>
                <div class="rounded-lg border border-gray-800 bg-gray-950/50 p-3 text-sm">
                  <p class="text-white">Proposal #<%= proposal.id %> <span class="text-gray-500">(<%= proposal.status %>)</span></p>
                  <p class="mt-1 text-gray-400"><%= proposal.hedge_side %> <%= proposal.hedge_asset %> <%= format_venue_eth_amount(proposal.suggested_short_amount) %></p>
                  <div class="mt-3 grid grid-cols-1 gap-2 text-xs text-gray-400 sm:grid-cols-2">
                    <p>Manual proposal only</p>
                    <p>No orders / No Hyperliquid</p>
                    <p>Execution disabled</p>
                    <p>Not a live hedge</p>
                    <p>Local record only</p>
                    <p>Review does not place orders</p>
                    <p>Safety status: <span class="font-semibold text-white"><%= safety&.status || "unavailable" %></span></p>
                    <p>Freshness: <span class="font-semibold text-white"><%= proposal.freshness_label(@position) %></span></p>
                    <p>Execution: disabled / manual review only</p>
                    <p>Hyperliquid: not called</p>
                  </div>
                  <% if safety %>
                    <div class="mt-3 rounded-lg border border-gray-800 bg-gray-950 p-3">
                      <p class="text-xs font-semibold text-gray-300">Checked Limits</p>
                      <dl class="mt-2 space-y-1 text-xs">
                        <% safety.checked_limits.each_value do |limit| %>
                          <div class="flex justify-between gap-3"><dt class="text-gray-500"><%= limit[:env_key] %></dt><dd class="text-right text-gray-300"><%= limit[:status] %></dd></div>
                        <% end %>
                      </dl>
                      <% if safety.failures.present? %>
                        <ul class="mt-2 list-disc space-y-1 pl-5 text-xs text-red-200">
                          <% safety.failures.each do |failure| %><li><%= failure %></li><% end %>
                        </ul>
                        <p class="mt-2 text-xs text-red-200">Blocked proposals cannot be marked reviewed</p>
                      <% end %>
                      <% if safety.warnings.present? %>
                        <ul class="mt-2 list-disc space-y-1 pl-5 text-xs text-yellow-200">
                          <% safety.warnings.each do |warning| %><li><%= warning %></li><% end %>
                        </ul>
                      <% end %>
                    </div>
                  <% end %>
                  <p class="mt-2 text-xs text-gray-500">Stale reasons: <%= stale_reasons.any? ? stale_reasons.join(", ") : "None" %></p>
                  <div class="mt-3 flex gap-2">
                    <span class="rounded-lg border border-gray-700 px-2 py-1 text-xs text-gray-300">Mark Reviewed</span>
                    <span class="rounded-lg border border-gray-700 px-2 py-1 text-xs text-gray-300">Reject</span>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="mt-4 text-sm text-gray-500">No manual proposal history.</p>
          <% end %>
        </details>
      </div>
    </section>
  <% else %>
    <section class="grid grid-cols-1 gap-4 md:grid-cols-4">
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-4"><p class="text-xs uppercase tracking-wide text-gray-500"><%= @position.asset0 %></p><p class="mt-2 text-xl font-semibold text-white"><%= asset_value_display(@position.asset0_amount, @position.asset0_price_usd) %></p></div>
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-4"><p class="text-xs uppercase tracking-wide text-gray-500"><%= @position.asset1 %></p><p class="mt-2 text-xl font-semibold text-white"><%= asset_value_display(@position.asset1_amount, @position.asset1_price_usd) %></p></div>
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-4"><p class="text-xs uppercase tracking-wide text-gray-500">Total Pooled Value</p><p class="mt-2 text-xl font-semibold text-white"><%= valuation_value_display(position_valuation.current_value_usd) %></p></div>
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-4"><p class="text-xs uppercase tracking-wide text-gray-500">Hedge</p><p class="mt-2 text-xl font-semibold <%= @position.hedge ? 'text-white' : 'text-gray-500' %>"><%= @position.hedge ? "Configured" : "None" %></p></div>
    </section>
  <% end %>
</div>
