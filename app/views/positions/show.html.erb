                <p class="mt-2 text-xl font-semibold text-white"><%= rewards_pnl ? format_usd(rewards_pnl) : "Unavailable" %></p>
                <p class="mt-1 break-words text-xs text-gray-500" title="<%= rewards_report[:stop_reason] || rewards_report[:warnings]&.first %>"><%= reward_value_state == "verified_zero" ? "Verified zero from readable reward source." : (reward_value_state == "estimated" ? (rewards_report[:reward_source] == "mellow_ui_parity_eth_call" ? "Read-only Mellow UI-parity estimate. Claiming is not implemented." : "Strategy-level read-only estimate.") : (reward_value_state == "unverified_mismatch" ? "Unverified estimate; excluded from Total PnL." : (rewards_report[:stop_reason].presence || rewards_report[:warnings]&.first.presence || "Claiming is not implemented."))) %></p>
              </div>
              <div class="min-w-0 rounded-xl border border-gray-800 bg-gray-950/60 p-4">
                <p class="text-xs text-gray-500"><%= fees_report[:fee_label].presence || "LP fees estimate" %></p>
                <p class="mt-2 text-xl font-semibold text-white"><%= fees_pnl ? format_usd(fees_pnl) : "Unavailable" %></p>
                <p class="mt-1 break-words text-xs text-gray-500" title="<%= fees_report[:stop_reason] || fees_report[:warnings]&.first %>"><%= fee_value_state == "verified_zero" ? "Verified zero from readable fee source." : (fee_value_state == "estimated" ? "Strategy-level read-only estimate." : (fees_report[:stop_reason].presence || fees_report[:warnings]&.first.presence || "Collecting is not implemented.")) %></p>
              </div>
              <div class="min-w-0 rounded-xl border border-gray-800 bg-gray-950/60 p-4">
                <p class="text-xs text-gray-500">Total PnL Including Unclaimed AERO Rewards Estimate</p>
                <p class="mt-2 text-xl font-semibold <%= (total_pnl_with_rewards || 0) >= 0 ? 'text-green-300' : 'text-red-300' %>"><%= total_pnl_with_rewards ? format_usd(total_pnl_with_rewards) : "Unavailable" %></p>
                <p class="mt-1 break-words text-xs text-gray-500"><%= rewards_pnl ? "Pool + hedge + reward estimate. Unclaimed rewards are not realized until claimed/sold." : "Base only; rewards unavailable." %></p>
              </div>
              <div class="min-w-0 rounded-xl border border-gray-800 bg-gray-950/60 p-4">
                <p class="text-xs text-gray-500">Total PnL Including Rewards + LP Fees Estimate</p>
                <p class="mt-2 text-xl font-semibold <%= (total_pnl_with_rewards_and_fees || 0) >= 0 ? 'text-green-300' : 'text-red-300' %>"><%= total_pnl_with_rewards_and_fees ? format_usd(total_pnl_with_rewards_and_fees) : "Unavailable" %></p>
                <p class="mt-1 break-words text-xs text-gray-500"><%= total_pnl_with_rewards_and_fees ? "Pool + hedge + reward and LP fee estimates." : "Rewards or LP fee estimate unavailable; combined total not shown. Including fees unavailable." %></p>
              </div>
              <% end %>
            </div>
            <% if pnl_execution_venue.in?(%w[nado ethereal extended]) %>
              <p class="mt-4 rounded-lg border border-gray-800 bg-gray-950/60 p-3 text-xs text-gray-400">
