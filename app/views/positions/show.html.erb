<% position_valuation = @position_valuation || PositionValuation.current(@position) %>
<% aerodrome = aerodrome_position?(@position) %>
<% production_dashboard = @aerodrome_production_dashboard_status || {} %>
<% auto_status = @aerodrome_auto_rebalance_status || {} %>
<% cached_snapshot = @cached_hedge_dashboard_snapshot || {} %>
<% cached_venue_states = cached_snapshot[:venue_states] || {} %>
<% selected_venue = @selected_hedge_venue || HedgeVenues.normalize(@position.hedge&.execution_venue) %>
<% position_tab = @position_tab.presence || "overview" %>
<% tab_class = ->(*tabs) { tabs.map(&:to_s).include?(position_tab) ? "" : " hidden" } %>
<% selected_adapter = @selected_hedge_venue_adapter || (aerodrome ? HedgeVenues.build(selected_venue) : nil) %>
<% selected_venue_name = selected_adapter&.venue_name || HedgeVenues.label(selected_venue) %>
<% auto_control_status = @auto_control_status || (aerodrome ? AutoRebalanceControl.new(position: @position, venue: selected_venue).status : {}) %>
<% venue_dashboard = @selected_hedge_venue_dashboard || {} %>
<% selected_account_state = venue_dashboard[:account_state] || {} %>
<% selected_read_only_diagnostics = selected_account_state[:read_only_diagnostics] || {} %>
<% dashboard_status = production_dashboard.presence || {} %>
<% selected_snapshot = cached_snapshot[:selected_venue] || {} %>
<% target_eth_short = cached_snapshot[:target_short_eth] || venue_dashboard[:target_hedge_eth] || dashboard_status[:target_hedge_eth] %>
<% current_short_eth = selected_snapshot[:short_size_eth] || venue_dashboard[:current_short_eth] || dashboard_status[:current_short_eth] %>
<% drift_eth = cached_snapshot[:drift_eth] || venue_dashboard[:drift_eth] || dashboard_status[:drift_eth] %>
<% tolerance_eth = cached_snapshot[:tolerance_eth] || venue_dashboard[:tolerance_eth] || auto_status[:tolerance_eth] %>
<% current_venue_position = venue_dashboard[:current_venue_position] || dashboard_status[:current_venue_position] || {} %>
<% margin_mode = selected_snapshot[:margin_mode] || dashboard_status[:margin_mode] || current_venue_position[:margin_mode] %>
<% effective_leverage = selected_snapshot[:effective_leverage] || current_venue_position[:effective_leverage] || dashboard_status[:effective_leverage] %>
<% mark_price = selected_snapshot[:mark_price] || dashboard_status[:mark_price] || current_venue_position[:mark_price] %>
<% current_notional = selected_snapshot[:notional_usd] || dashboard_status[:current_venue_notional_usd] || current_venue_position[:notional_usd] %>
<% entry_price = selected_snapshot[:entry_price] || dashboard_status[:entry_price] || current_venue_position[:entry_price] %>
<% isolated_margin = dashboard_status[:isolated_margin_usd] || current_venue_position[:isolated_margin_usd] %>
<% drift_usd = dashboard_status[:drift_notional_usd] %>
<% inside_tolerance = cached_snapshot[:inside_tolerance] %>
<% rebalance_needed = inside_tolerance.nil? ? nil : !inside_tolerance %>
<% tolerance_label = cached_snapshot[:hedge_status].presence || "Unknown / diagnostics unavailable" %>
<% selected_live_enabled = selected_adapter&.live_enabled? %>
<% selected_live_supported = selected_adapter&.live_supported? %>
<% live_status_label = selected_live_enabled ? "Live Enabled" : (selected_live_supported ? "Live Gated" : "Read-only") %>
<% auto_gate_enabled = if selected_venue == "nado"
  OperationalSettings.enabled?("AERODROME_NADO_AUTO_REBALANCE_ENABLED")
elsif selected_venue == "ethereal"
  OperationalSettings.enabled?("AERODROME_ETHEREAL_AUTO_REBALANCE_ENABLED")
elsif selected_venue == "extended"
  OperationalSettings.enabled?("EXTENDED_AUTO_REBALANCE_ENABLED")
else
  ActiveModel::Type::Boolean.new.cast(ENV.fetch("AERODROME_HEDGE_ENABLED", "false")) && !ActiveModel::Type::Boolean.new.cast(ENV.fetch("AERODROME_HEDGE_PAUSED", "true"))
end %>
<% auto_status_label = auto_gate_enabled ? "Auto On" : "Auto Off" %>
<% auto_operational_label = auto_status_label %>
<% signer_label = cached_snapshot.dig(:signer_status, :label).presence || "Unknown" %>
<% next_action = venue_dashboard[:next_action] || (rebalance_needed ? "rebalance" : "no-op") %>
<% action_preflights = venue_dashboard[:action_live_preflights] || {} %>
<% recommended_action_key = case next_action
when "open" then :open
when "increase short", "reduce short", "rebalance" then :rebalance
when "close" then :close
else :open
end %>
<% active_preflight = action_preflights[recommended_action_key] || venue_dashboard[:live_preflight] || {} %>
<% neutral_preflight_messages = [ "Live preflight is loaded separately." ] %>
<% selected_action_blockers = (active_preflight[:blockers] || []).uniq.reject { |blocker| neutral_preflight_messages.include?(blocker.to_s) } %>
<% selected_action_warnings = ((active_preflight[:warnings] || []) + ((active_preflight[:blockers] || []).uniq & neutral_preflight_messages)).uniq.reject { |warning| selected_action_blockers.include?(warning) } %>
<% open_preview = venue_dashboard[:open_preview] || {} %>
<% migration_full_readiness = venue_dashboard[:migration_full_readiness] || {} %>
<% extended_auto_readiness = venue_dashboard[:auto_readiness] || {} %>
<% extended_readiness_loaded = selected_venue == "extended" && extended_auto_readiness[:status].to_s != "unavailable" %>
<% extended_readiness_has_target_current = extended_readiness_loaded && extended_auto_readiness[:target_short_eth].present? && extended_auto_readiness[:extended_current_short_eth].present? %>
<% readiness_planned_action = extended_auto_readiness[:planned_auto_action].to_s %>
<% readiness_preview_available = extended_readiness_has_target_current && (readiness_planned_action.in?(%w[no_op decrease_short increase_short]) || extended_auto_readiness[:action_suppressed_reason].present?) %>
<% extended_readback_blockers = Array(extended_auto_readiness[:blockers]).grep(/Extended account balance\/collateral unavailable|Extended market metadata unavailable/) %>
<% canonical_extended_readiness = extended_readiness_has_target_current && extended_readback_blockers.blank? %>
<% if canonical_extended_readiness %>
  <% target_eth_short = extended_auto_readiness[:target_short_eth] %>
  <% current_short_eth = extended_auto_readiness[:extended_current_short_eth] %>
  <% drift_eth = extended_auto_readiness[:drift_eth] %>
  <% tolerance_eth = extended_auto_readiness[:tolerance_eth] %>
  <% inside_tolerance = extended_auto_readiness[:within_tolerance] %>
  <% rebalance_needed = inside_tolerance.nil? ? nil : !inside_tolerance %>
  <% tolerance_label = inside_tolerance.nil? ? "Unknown / diagnostics unavailable" : (inside_tolerance ? "In tolerance" : "Out of tolerance") %>
  <% next_action = case extended_auto_readiness[:planned_auto_action].to_s
  when "increase_short", "decrease_short" then "rebalance"
  when "no_op" then "no-op"
  else next_action
  end %>
  <% recommended_action_key = next_action == "rebalance" ? :rebalance : :open %>
  <% active_preflight = action_preflights[recommended_action_key] || venue_dashboard[:live_preflight] || {} %>
<% end %>
<% extended_readiness_planned_action = extended_auto_readiness[:status].to_s == "unavailable" ? nil : extended_auto_readiness[:planned_auto_action].presence %>
<% extended_planned_action = extended_readiness_planned_action || cached_snapshot[:planned_auto_action].presence || (rebalance_needed ? next_action.to_s : "no_op") %>
<% extended_action_label = case extended_planned_action.to_s
when "no_op" then "No-op / inside tolerance"
when "increase_short" then "SELL non-reduce-only / increase short"
when "decrease_short" then "BUY reduce-only / reduce short"
when "blocked" then "Blocked / fresh target required"
else extended_planned_action.to_s.humanize
end %>
<% if extended_auto_readiness[:action_suppressed_reason].present? %>
  <% extended_action_label = "Waiting / suppressed: #{extended_auto_readiness[:action_suppressed_reason]}" %>
<% end %>
<% hedge_accounting = @hedge_venue_accounting || {} %>
<% accounting_components = hedge_accounting[:components] || {} %>
<% snapshot_unrealized_pnl = selected_snapshot[:unrealized_pnl_usd] %>
<% snapshot_realized_pnl = selected_snapshot[:realized_pnl_usd] %>
<% rewards_report = @aerodrome_rewards_report || {} %>
<% fees_report = @aerodrome_fees_report || {} %>
<% production_health = @production_health || {} %>
<% reward_value_state = rewards_report[:value_state].presence || (rewards_report[:claimable_aero_usd].present? ? (rewards_report[:claimable_aero_usd].to_s == "0" ? "verified_zero" : "estimated") : "unavailable") %>
<% fee_value_state = fees_report[:value_state].presence || (fees_report[:total_fees_usd].present? ? (fees_report[:total_fees_usd].to_s == "0" ? "verified_zero" : "estimated") : "unavailable") %>
<% rewards_usable = %w[estimated verified_zero detected].include?(reward_value_state) %>
<% fees_usable = %w[estimated verified_zero detected].include?(fee_value_state) %>
<% mellow_current_resolver_ok = @position.mellow_autopilot? && @position.current_share_token_resolver_ready? %>
<% legacy_mellow_token_id = @position.mellow_metadata_hash["strategy_token_id"].presence || @position.external_id.to_s.delete_prefix("mellow:") %>
<% legacy_rewards_error = [ rewards_report[:stop_reason], fees_report[:stop_reason], *Array(rewards_report[:warnings]), *Array(fees_report[:warnings]) ].compact.find { |message| message.to_s.match?(/erc721|owner|token|nonexistent|not found|missing/i) } %>
<% legacy_rewards_unavailable = @position.mellow_autopilot? && legacy_mellow_token_id.present? && legacy_rewards_error.present? %>
<% hedge_preview = aerodrome ? aerodrome_hedge_preview_for(@position) : nil %>
<% latest_snap = @pnl_snapshots.first %>
<% pool_unrealized = position_valuation.pool_delta_usd %>
<% pnl_execution_venue = HedgeVenues.normalize(dashboard_status[:execution_venue] || @position.hedge&.execution_venue) %>
<% venue_hedge_unrealized_raw = accounting_components.dig(:unrealized_pnl_usd, :value).presence || snapshot_unrealized_pnl.presence || dashboard_status[:venue_hedge_unrealized_pnl_usd].presence %>
<% hedge_unrealized = pnl_execution_venue.in?(%w[nado ethereal extended]) ? (venue_hedge_unrealized_raw ? BigDecimal(venue_hedge_unrealized_raw.to_s) : nil) : (latest_snap&.hedge_unrealized || 0).to_d %>
<% hedge_unrealized_available = !hedge_unrealized.nil? %>
<% hedge_realized = if accounting_components.dig(:realized_pnl_usd, :value).present?
  BigDecimal(accounting_components.dig(:realized_pnl_usd, :value).to_s)
elsif snapshot_realized_pnl.present?
  BigDecimal(snapshot_realized_pnl.to_s)
elsif pnl_execution_venue.in?(%w[nado ethereal extended])
  nil
else
  (latest_snap&.hedge_realized || 0).to_d
end %>
<% hedge_realized_available = !hedge_realized.nil? %>
<% total_unrealized = if pool_unrealized && hedge_unrealized_available
  pool_unrealized + hedge_unrealized
elsif pool_unrealized && !pnl_execution_venue.in?(%w[nado ethereal extended])
  pool_unrealized
elsif hedge_unrealized_available
  hedge_unrealized
end %>
<% total_pnl = total_unrealized ? total_unrealized + (hedge_realized || 0) : nil %>
<% rewards_pnl = reward_value_state == "verified_zero" ? "0" : (rewards_usable ? rewards_report.fetch(:claimable_aero_usd, nil).presence : nil) %>
<% rewards_pnl = BigDecimal(rewards_pnl.to_s) if rewards_pnl %>
<% fees_pnl = fee_value_state == "verified_zero" ? "0" : (fees_usable ? fees_report.fetch(:total_fees_usd, nil).presence : nil) %>
<% fees_pnl = BigDecimal(fees_pnl.to_s) if fees_pnl %>
<% total_pnl_with_rewards = total_pnl && rewards_pnl ? total_pnl + rewards_pnl : nil %>
<% total_pnl_with_rewards_and_fees = total_pnl_with_rewards && fees_pnl ? total_pnl_with_rewards + fees_pnl : nil %>
<% mellow_asset0_value = @position.mellow_autopilot? && position_valuation.current_value_usd && position_valuation.usdc_exposure ? position_valuation.current_value_usd - position_valuation.usdc_exposure : nil %>
<% mellow_asset1_value = @position.mellow_autopilot? ? position_valuation.usdc_exposure : nil %>
<% current_short_label = "Current #{selected_venue_name} ETH short" %>
<% current_position_label = "Current #{selected_venue_name} ETH-PERP position" %>
<% selected_auto_readiness_loaded = extended_auto_readiness[:status] != "unavailable" %>
<% selected_auto_ready = selected_auto_readiness_loaded ? extended_auto_readiness[:continuous_auto_ready] : nil %>
<% snapshot_open_orders_count = selected_snapshot[:open_orders_count] %>
<% extended_isolated_equivalent_confirmed = selected_venue == "extended" && (
  ActiveModel::Type::Boolean.new.cast(ENV.fetch("EXTENDED_ISOLATED_ACCOUNT_CONFIRMED", "false")) ||
  cached_snapshot[:leverage_margin_gate_status].to_s.in?(%w[ok pass passed ready confirmed])
) %>
<% snapshot_margin_label = if margin_mode.present?
  margin_mode.to_s == "isolated" ? "Isolated 1.0x" : margin_mode.to_s.humanize
elsif selected_venue == "extended" && selected_snapshot[:leverage].present? && BigDecimal(selected_snapshot[:leverage].to_s) == 1 && extended_isolated_equivalent_confirmed
  "1x isolated-equivalent"
elsif selected_venue == "extended" && selected_snapshot[:leverage].present? && BigDecimal(selected_snapshot[:leverage].to_s) == 1
  "1x / margin mode not directly exposed"
else
  "Unavailable"
end %>
<% snapshot_margin_detail = if selected_venue == "extended" && margin_mode.blank? && selected_snapshot[:leverage].present? && BigDecimal(selected_snapshot[:leverage].to_s) == 1
  extended_isolated_equivalent_confirmed ? "mode not directly exposed by API; dedicated account confirmed" : "mode not directly exposed by API"
else
  selected_venue == "ethereal" ? "Ethereal cross only" : "Snapshot venue readback"
end %>
<% effective_leverage_display = effective_leverage.present? ? "#{number_with_precision(BigDecimal(effective_leverage.to_s), precision: 3)}x" : nil %>
<% effective_leverage_detail = current_notional.present? ? "Notional #{format_venue_usd_amount(current_notional)}" : "Account value not loaded" %>
<% partial_hedge_pnl = hedge_unrealized_available ? hedge_unrealized + (hedge_realized || 0) : nil %>
<% partial_hedge_pnl_note = hedge_realized_available ? "Known realized + unrealized; fees/funding diagnostics separate" : "Partial, excluding unavailable realized PnL, fees, and funding" %>
<% total_pnl_note = if total_unrealized && !hedge_realized_available
  "Partial total, excluding unavailable realized PnL, fees, and rewards"
elsif total_pnl
  "Excludes rewards and LP fees"
else
  "Diagnostics not loaded"
end %>
<% drift_negative = begin
  drift_eth.present? && BigDecimal(drift_eth.to_s).negative?
rescue ArgumentError
  false
end %>
<% risk_short_cap = RiskSettings.cap_for(venue: selected_venue, kind: :short_eth) %>
<% risk_order_cap = RiskSettings.cap_for(venue: selected_venue, kind: :order_size_eth) %>
<% risk_target_short = target_eth_short.present? ? BigDecimal(target_eth_short.to_s) : nil rescue nil %>
<% risk_current_short = current_short_eth.present? ? BigDecimal(current_short_eth.to_s) : BigDecimal("0") rescue BigDecimal("0") %>
<% risk_drift = drift_eth.present? ? BigDecimal(drift_eth.to_s) : (risk_target_short ? risk_target_short - risk_current_short : nil) rescue nil %>
<% risk_requested_size = case recommended_action_key
when :open then risk_target_short
when :rebalance then risk_drift&.abs
when :close then risk_current_short
end %>
<% risk_expected_after = case recommended_action_key
when :open then risk_target_short
when :rebalance then risk_drift&.positive? ? risk_current_short + risk_drift : risk_current_short
else risk_current_short
end %>
<% risk_cap_blocked = risk_short_cap.value.present? && risk_expected_after.present? && risk_expected_after > risk_short_cap.value %>
<% risk_order_blocked = risk_order_cap.value.present? && risk_requested_size.present? && risk_requested_size > risk_order_cap.value %>
<% random_production = @random_production_runner_status || {} %>
<% random_production_status = random_production[:lock_stale] ? "stale lock" : (random_production[:status].presence || "unknown") %>
<% random_production_running = random_production_status == "running" %>
<% production_truth_venue = HedgeVenues.normalize(random_production[:current_production_venue].presence || @position.hedge&.execution_venue) %>
<% production_truth_venue_name = HedgeVenues.label(production_truth_venue) %>
<% production_active_short = random_production[:active_venue_short_eth].presence || random_production.dig(:direct_venue_shorts, production_truth_venue) || current_short_eth %>
<% production_target_short = random_production[:target_short_eth].presence || target_eth_short %>
<% production_drift_eth = random_production[:drift_eth].presence || drift_eth %>
<% production_tolerance_eth = random_production[:tolerance_eth].presence || tolerance_eth %>
<% production_inside_tolerance = random_production.key?(:inside_tolerance) ? random_production[:inside_tolerance] : inside_tolerance %>
<% production_open_orders_zero = random_production[:open_orders_zero] %>
<% production_route_summary = random_production[:route_proofs_summary] || {} %>
<% production_route_ready = (production_route_summary[:ready] || production_route_summary["ready"]).to_i == 6 && (production_route_summary[:total] || production_route_summary["total"]).to_i == 6 && (production_route_summary[:missing] || production_route_summary["missing"]).to_i.zero? && (production_route_summary[:stale] || production_route_summary["stale"]).to_i.zero? %>
<% production_next_target = random_production[:next_target_venue].presence || begin
  daily_venues = %w[extended ethereal nado]
  daily_venues[(daily_venues.index(production_truth_venue).to_i + 1) % daily_venues.size]
end %>
<% production_next_rotation_at = begin
  Time.zone.parse(random_production[:next_rotation_at].to_s)
rescue ArgumentError, TypeError
  nil
end %>
<% production_last_hold_check_at = begin
  Time.zone.parse(random_production[:last_hold_check].to_s)
rescue ArgumentError, TypeError
  nil
end %>
<% production_status_color = case random_production_status
when "running" then "border-green-800 bg-green-950/50 text-green-100"
when "unsafe_multiple_exposure", "orphan_process_running", "unsafe_gates_left_enabled", "blocked" then "border-red-800 bg-red-950/50 text-red-100"
when "stale lock", "stale_lock", "stale_heartbeat" then "border-yellow-800 bg-yellow-950/50 text-yellow-100"
else "border-gray-700 bg-gray-950 text-gray-300"
end %>
<% production_blockers = Array(random_production[:direct_preflight_blockers]).presence || Array(random_production[:latest_blocker]).compact %>
<% production_optional_diagnostics = Array((random_production[:dashboard_snapshot_diagnostic] || {})[:blockers] || (random_production[:dashboard_snapshot_diagnostic] || {})["blockers"]) %>
<% production_eth_value = ->(value, reason) { value.present? ? "#{format_venue_eth_amount(value)} ETH" : reason } %>
<% production_operator_summary = if random_production_running && production_inside_tolerance == true && production_open_orders_zero == true && production_blockers.blank?
  "Bot is running normally. Current hedge: #{production_truth_venue_name} short #{format_venue_eth_amount(production_active_short)} ETH. Target: #{format_venue_eth_amount(production_target_short)} ETH. Drift: #{format_venue_eth_amount(production_drift_eth)} ETH, inside tolerance. Open orders: zero. Last action: #{random_production[:last_route].presence || 'none recorded'}. Next: hold check every 5 minutes; next migration #{production_next_rotation_at ? "around #{l(production_next_rotation_at, format: :short)}" : 'ETA not loaded yet'}. No action required."
else
  "Production runner state needs review. Status: #{random_production_status}. Current venue: #{production_truth_venue_name}. Open orders: #{production_open_orders_zero.nil? ? 'unknown - production status has not confirmed direct open orders yet' : (production_open_orders_zero ? 'zero' : 'nonzero')}. #{production_blockers.first.presence || 'Check blockers below if the status is not running.'}"
end %>

<div class="space-y-8">
  <% if aerodrome %>
    <section id="production-control-center" class="rounded-2xl border <%= random_production_running ? 'border-green-900 bg-green-950/20' : 'border-gray-800 bg-gray-900/80' %> p-5 shadow-2xl shadow-black/20">
      <div class="flex flex-col gap-4 xl:flex-row xl:items-start xl:justify-between">
        <div class="min-w-0">
          <p class="text-xs uppercase tracking-wide text-gray-500">Production Control Center</p>
          <h1 class="mt-1 text-2xl font-semibold text-white">24/7 Random Rotation: <%= random_production_status.to_s.upcase.tr("_", " ") %></h1>
          <% if random_production_running && production_inside_tolerance == true && production_open_orders_zero == true && production_blockers.blank? %>
            <div class="mt-3 rounded-xl border border-green-900 bg-green-950/40 p-3">
              <p class="text-sm font-semibold text-green-100">Bot is running normally. No action required.</p>
              <p class="mt-1 max-w-5xl text-sm text-green-100/90"><%= production_operator_summary %></p>
            </div>
          <% else %>
            <p class="mt-2 max-w-5xl text-sm text-gray-300"><%= production_operator_summary %></p>
          <% end %>
        </div>
        <span class="shrink-0 rounded-full border px-3 py-1 text-xs font-semibold <%= production_status_color %>"><%= random_production_status %></span>
      </div>

      <div class="mt-5 grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-6">
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-3"><p class="text-xs text-gray-500">Production runner venue</p><p class="mt-1 text-lg font-semibold text-white"><%= production_truth_venue_name %></p></div>
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-3"><p class="text-xs text-gray-500">Active venue short</p><p class="mt-1 text-lg font-semibold text-white"><%= production_eth_value.call(production_active_short, "not loaded yet - cached direct short missing") %></p></div>
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-3"><p class="text-xs text-gray-500">Target short</p><p class="mt-1 text-lg font-semibold text-white"><%= production_eth_value.call(production_target_short, "not loaded yet - heartbeat target missing") %></p></div>
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-3"><p class="text-xs text-gray-500">Drift / tolerance</p><p class="mt-1 text-lg font-semibold text-white"><%= production_drift_eth.present? ? format_venue_eth_amount(production_drift_eth) : "not loaded yet" %> / <%= production_tolerance_eth.present? ? "#{format_venue_eth_amount(production_tolerance_eth)} ETH" : "not loaded yet - target/tolerance missing" %></p></div>
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-3"><p class="text-xs text-gray-500">Inside tolerance</p><p class="<%= production_inside_tolerance == true ? 'text-green-300' : (production_inside_tolerance == false ? 'text-red-300' : 'text-yellow-200') %> mt-1 text-lg font-semibold"><%= production_inside_tolerance.nil? ? "unknown - production status not loaded yet" : (production_inside_tolerance ? "yes" : "no") %></p></div>
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-3"><p class="text-xs text-gray-500">Open orders</p><p class="<%= production_open_orders_zero == true ? 'text-green-300' : (production_open_orders_zero == false ? 'text-red-300' : 'text-yellow-200') %> mt-1 text-lg font-semibold"><%= production_open_orders_zero.nil? ? "unknown - direct readback not cached" : (production_open_orders_zero ? "zero" : "nonzero") %></p></div>
      </div>

      <div class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-6">
        <div><p class="text-xs text-gray-500">Mode</p><p class="text-white"><%= random_production[:mode].presence || "24/7 production" %></p></div>
        <div><p class="text-xs text-gray-500">Policy</p><p class="text-white"><%= random_production[:policy_label].presence || "3 migrations/day · interval 28800s · hold check 300s" %></p></div>
        <div><p class="text-xs text-gray-500">Last route</p><p class="text-white"><%= random_production[:last_route].presence || "not recorded yet - waiting for first cycle event" %></p></div>
        <div><p class="text-xs text-gray-500">Last cycle</p><p class="text-white"><%= random_production[:last_cycle].presence || "not recorded yet - waiting for first cycle event" %></p></div>
        <div><p class="text-xs text-gray-500">Last hold check</p><p class="text-white"><%= production_last_hold_check_at ? "#{l(production_last_hold_check_at, format: :short)} (#{time_ago_in_words(production_last_hold_check_at)} ago)" : "not loaded yet - waiting for heartbeat" %></p></div>
        <div><p class="text-xs text-gray-500">Next rotation ETA</p><p class="text-white"><%= production_next_rotation_at ? "#{l(production_next_rotation_at, format: :short)} (#{distance_of_time_in_words(Time.current, production_next_rotation_at)} from now)" : "not loaded yet - heartbeat lacks start/cycle timing" %></p></div>
