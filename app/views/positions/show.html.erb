<div class="flex items-center justify-between mb-8">
  <div>
    <h1 class="text-3xl font-bold text-white inline-flex items-center gap-2">
      <%= @position.asset0 %>/<%= @position.asset1 %>
      <%= link_to position_path(@position), class: "text-gray-400 hover:text-white transition" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.992 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182M21.015 4.356v4.992" />
        </svg>
      <% end %>
    </h1>
    <p class="text-gray-400 mt-1 flex items-center gap-2">
      <%= dex_display_name(@position) %> &middot;
      <%= chain_display_name(@position) %> &middot;
      <%= @position.mellow_autopilot? ? "Observed token ID" : "Token ID" %> <%= @position.external_id %> &middot;
      <span id="copy-address" class="cursor-pointer hover:text-white transition inline-flex items-center gap-1" title="<%= @position.pool_address %>" onclick="navigator.clipboard.writeText('<%= @position.pool_address %>'); var icon=this.querySelector('.copy-icon'); icon.innerHTML='<path stroke-linecap=\'round\' stroke-linejoin=\'round\' d=\'M4.5 12.75l6 6 9-13.5\' />'; icon.classList.add('text-green-400'); setTimeout(function(){ icon.innerHTML='<path stroke-linecap=\'round\' stroke-linejoin=\'round\' d=\'M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75\' />'; icon.classList.remove('text-green-400'); }, 1500)">
        <%= @position.pool_address.to_s[0..5] %>&hellip;<%= @position.pool_address.to_s[-4..] %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 copy-icon">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
        </svg>
      </span>
    </p>
  </div>
  <div class="flex items-center space-x-3">
    <% if aerodrome_position?(@position) %>
      <div class="text-right">
        <%= button_to "Refresh Read-only Data", sync_now_position_path(@position), method: :post, title: "Updates on-chain LP data only. No orders, no Hyperliquid, no hedge execution.", class: "bg-gray-700 hover:bg-gray-600 text-gray-300 px-4 py-2 rounded-lg text-sm font-medium transition" %>
        <p class="text-gray-500 text-xs mt-2">Updates on-chain LP data only &middot; No orders &middot; No Hyperliquid &middot; No hedge execution</p>
      </div>
      <div class="text-right">
        <% proposal_button_path = @latest_aerodrome_hedge_proposal ? regenerate_position_aerodrome_hedge_proposals_path(@position) : position_aerodrome_hedge_proposals_path(@position) %>
        <% proposal_button_label = @latest_aerodrome_hedge_proposal ? "Regenerate Manual Hedge Proposal" : "Generate Manual Hedge Proposal" %>
        <%= button_to proposal_button_label, proposal_button_path, method: :post, title: "Manual proposal only. No orders. No Hyperliquid. Execution disabled. Not a live hedge.", class: "bg-yellow-900/60 hover:bg-yellow-900 text-yellow-100 border border-yellow-700 px-4 py-2 rounded-lg text-sm font-medium transition" %>
        <p class="text-gray-500 text-xs mt-2">Manual proposal only &middot; No orders &middot; No Hyperliquid &middot; Execution disabled &middot; Not a live hedge</p>
      </div>
      <span class="bg-yellow-900/40 text-yellow-300 border border-yellow-800 px-4 py-2 rounded-lg text-sm font-medium">Monitor-only</span>
    <% elsif @position.hedge %>
      <%= button_to "Sync Now", sync_now_position_path(@position), method: :post, class: "bg-gray-700 hover:bg-gray-600 text-gray-300 px-4 py-2 rounded-lg text-sm font-medium transition" %>
      <%= link_to "View Hedge", hedge_path(@position.hedge), class: "bg-gray-700 hover:bg-gray-600 text-gray-300 px-4 py-2 rounded-lg text-sm font-medium transition" %>
    <% else %>
      <%= button_to "Sync Now", sync_now_position_path(@position), method: :post, class: "bg-gray-700 hover:bg-gray-600 text-gray-300 px-4 py-2 rounded-lg text-sm font-medium transition" %>
      <%= link_to "Create Hedge", new_hedge_path(position_id: @position.id), class: "bg-gray-700 hover:bg-gray-600 text-gray-300 px-4 py-2 rounded-lg text-sm font-medium transition" %>
    <% end %>
  </div>
</div>

<% if aerodrome_position?(@position) %>
  <% position_valuation = @position_valuation || PositionValuation.current(@position) %>
  <% hedge_preview = aerodrome_hedge_preview_for(@position) %>
  <% aerodrome_hedge = @position.hedge %>
  <% weth_amount = @position.asset0.to_s.upcase == "WETH" || @position.asset0.to_s.upcase == "ETH" ? @position.asset0_amount : @position.asset1_amount %>
  <% target_eth_short = aerodrome_hedge && weth_amount ? weth_amount * aerodrome_hedge.target : nil %>
  <% aerodrome_hedge_enabled = ENV["AERODROME_HEDGE_ENABLED"].to_s.downcase == "true" %>
  <% aerodrome_hedge_paused = ENV["AERODROME_HEDGE_PAUSED"].nil? ? true : ENV["AERODROME_HEDGE_PAUSED"].to_s.downcase == "true" %>
  <% aerodrome_live_approved = ENV["AERODROME_LIVE_APPROVED"].to_s.downcase == "true" %>
  <% hyperliquid_testnet = ENV["HYPERLIQUID_TESTNET"].to_s.downcase == "true" %>
  <% aerodrome_pool_delta = position_valuation.pool_delta_usd %>
  <% production_dashboard = @aerodrome_production_dashboard_status || {} %>
  <% hard_ceiling = production_dashboard[:hard_ceiling] || {} %>
  <div class="bg-yellow-950/30 border border-yellow-800 rounded-xl p-5 mb-8">
    <div class="flex flex-wrap gap-2 mb-4">
      <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-yellow-900/50 text-yellow-300 border border-yellow-700">MONITOR ONLY</span>
      <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-gray-800 text-gray-300 border border-gray-700">NO ORDERS</span>
      <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-gray-800 text-gray-300 border border-gray-700">HEDGE DISABLED</span>
      <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-gray-800 text-gray-300 border border-gray-700">READ-ONLY HYPERLIQUID</span>
      <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-gray-800 text-gray-300 border border-gray-700">NOT LIVE HEDGE-READY</span>
    </div>
    <p class="text-yellow-100 font-medium">Aerodrome Slipstream supervised position on <%= chain_display_name(@position) %>.</p>
    <p class="text-yellow-200/80 text-sm mt-1">AERODROME_HEDGE_ENABLED must remain false outside explicit supervised dashboard submits. Dashboard hedge actions are blocked unless explicit live gates and typed confirmation are present. Preview actions are dry-run only. Close uses the separately gated emergency close path.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-5">
      <div class="bg-gray-950/40 border border-gray-800 rounded-lg p-4">
        <p class="text-gray-400 text-xs uppercase tracking-wide">Position Details</p>
        <dl class="mt-3 space-y-2 text-sm">
          <div class="flex justify-between gap-4"><dt class="text-gray-500">DEX</dt><dd class="text-white"><%= dex_display_name(@position) %></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-gray-500">Source</dt><dd class="text-white"><%= @position.source_label %></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-gray-500">Chain</dt><dd class="text-white"><%= chain_display_name(@position) %></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-gray-500"><%= @position.mellow_autopilot? ? "Observed strategy token ID" : "Token ID" %></dt><dd class="text-white"><%= @position.external_id %></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-gray-500">Pool</dt><dd class="text-white text-right break-all"><%= @position.pool_address %></dd></div>
        </dl>
      </div>
      <% if @position.mellow_autopilot? %>
        <% mellow = @position.mellow_metadata_hash %>
        <div class="bg-gray-950/40 border border-gray-800 rounded-lg p-4 md:col-span-2">
          <p class="text-gray-400 text-xs uppercase tracking-wide">Mellow Autopilot Shared Strategy</p>
          <p class="text-yellow-200/80 text-xs mt-2">This is pro-rata exposure derived from shared Autopilot strategy accounting. Do not hedge the full strategy NFT.</p>
          <div class="mt-3 grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
            <div class="flex justify-between gap-4"><span class="text-gray-500">Tx hash</span><span class="text-white text-right break-all"><%= mellow["tx_hash"].presence || "unavailable" %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Submitted wallet</span><span class="text-white text-right break-all"><%= mellow["submitted_wallet"].presence || "unavailable" %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Share token</span><span class="text-white text-right break-all"><%= mellow["share_token"].presence || "unavailable" %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Observed strategy token ID</span><span class="text-white"><%= mellow["strategy_token_id"].presence || @position.external_id %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">User share %</span><span class="text-white"><%= mellow["user_share_percent"].presence || "unavailable" %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Confidence</span><span class="text-white"><%= mellow["last_probe_confidence"].presence || "unavailable" %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Last probe at</span><span class="text-white"><%= mellow["last_probe_at"].presence || "unavailable" %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">User total value USD</span><span class="text-white"><%= optional_usd_display(mellow["user_total_value_usd"]) %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Strategy total WETH</span><span class="text-white"><%= mellow["strategy_total_weth"].presence || "unavailable" %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Strategy total USDC</span><span class="text-white"><%= mellow["strategy_total_usdc"].presence || "unavailable" %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">User WETH exposure</span><span class="text-white"><%= mellow["user_weth_exposure"].presence || @position.asset0_amount %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">User USDC exposure</span><span class="text-white"><%= mellow["user_usdc_exposure"].presence || @position.asset1_amount %></span></div>
          </div>
          <% if !@position.hedge_ready? %>
            <p class="mt-3 text-red-200 text-sm">Mellow pro-rata exposure is not hedge-ready. Refresh read-only data and inspect blockers before using live hedge controls.</p>
          <% end %>
        </div>
      <% end %>
      <div class="bg-gray-950/40 border border-gray-800 rounded-lg p-4">
        <p class="text-gray-400 text-xs uppercase tracking-wide">Hedge Preview</p>
        <% if hedge_preview&.supported %>
          <div class="mt-3 space-y-2 text-sm">
            <p class="text-yellow-300 font-medium">PREVIEW ONLY</p>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Suggested side</span><span class="text-white"><%= hedge_preview.hedge_side %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Suggested asset</span><span class="text-white"><%= hedge_preview.hedge_asset %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Suggested amount</span><span class="text-white"><%= number_with_precision(hedge_preview.suggested_short_amount, precision: 6) %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Suggested notional</span><span class="text-white"><%= format_usd(hedge_preview.suggested_short_notional_usd) %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Execution</span><span class="text-yellow-300">disabled</span></div>
          </div>
        <% else %>
          <p class="mt-3 text-gray-300 font-medium">Hedge preview unavailable</p>
          <p class="text-gray-500 text-sm mt-1"><%= hedge_preview&.reason || "preview data is unavailable" %></p>
        <% end %>
      </div>
      <% if aerodrome_hedge %>
        <div class="bg-gray-950/40 border border-gray-800 rounded-lg p-4 md:col-span-2">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <p class="text-gray-400 text-xs uppercase tracking-wide">Aerodrome Hedge Status</p>
            <p class="text-yellow-200/80 text-xs mt-2">Dashboard status and gated one-shot controls &middot; No background queues &middot; No tmux workflow</p>
            </div>
            <div class="flex flex-wrap gap-2">
              <% unless aerodrome_hedge_enabled %>
                <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-gray-800 text-gray-300 border border-gray-700">disabled</span>
              <% end %>
              <% if aerodrome_hedge_paused %>
                <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-yellow-900/50 text-yellow-300 border border-yellow-700">paused</span>
              <% end %>
              <% if hyperliquid_testnet %>
                <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-blue-950/60 text-blue-200 border border-blue-800">testnet</span>
              <% end %>
              <% unless aerodrome_live_approved %>
                <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-red-950/50 text-red-200 border border-red-800">live-blocked</span>
              <% end %>
            </div>
          </div>
          <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
            <div class="flex justify-between gap-4"><span class="text-gray-500">Hedge configured</span><span class="text-white">yes</span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Active</span><span class="text-white"><%= aerodrome_hedge.active? ? "yes" : "no" %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Target percent</span><span class="text-white"><%= number_to_percentage(aerodrome_hedge.target * 100, precision: 2) %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Tolerance percent</span><span class="text-white"><%= number_to_percentage(aerodrome_hedge.tolerance * 100, precision: 2) %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500"><%= position_valuation.hedge_target_label %></span><span class="text-white"><%= target_eth_short ? number_with_precision(target_eth_short, precision: 6) : "Unavailable" %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Actual ETH short</span><span class="text-yellow-300">readback disabled / not queried</span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">AERODROME_HEDGE_ENABLED</span><span class="text-white"><%= aerodrome_hedge_enabled %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">AERODROME_HEDGE_PAUSED</span><span class="text-white"><%= aerodrome_hedge_paused %><%= " (default)" if ENV["AERODROME_HEDGE_PAUSED"].nil? %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">AERODROME_LIVE_APPROVED</span><span class="text-white"><%= aerodrome_live_approved %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">HYPERLIQUID_TESTNET</span><span class="text-white"><%= hyperliquid_testnet %></span></div>
          </div>
          <div class="mt-4 border-t border-gray-800 pt-4">
            <p class="text-gray-400 text-xs uppercase tracking-wide">Last WETH/ETH Rebalance</p>
            <% if @latest_aerodrome_weth_rebalance %>
              <div class="mt-3 grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
                <div class="flex justify-between gap-4"><span class="text-gray-500">ID</span><span class="text-white"><%= @latest_aerodrome_weth_rebalance.id %></span></div>
                <div class="flex justify-between gap-4"><span class="text-gray-500">Status</span><span class="<%= @latest_aerodrome_weth_rebalance.status == ShortRebalance::STATUS_SUCCESS ? 'text-green-300' : 'text-red-300' %>"><%= @latest_aerodrome_weth_rebalance.status %></span></div>
                <div class="flex justify-between gap-4"><span class="text-gray-500">Old short size</span><span class="text-white"><%= number_with_precision(@latest_aerodrome_weth_rebalance.old_short_size, precision: 6) %></span></div>
                <div class="flex justify-between gap-4"><span class="text-gray-500">New short size</span><span class="text-white"><%= number_with_precision(@latest_aerodrome_weth_rebalance.new_short_size, precision: 6) %></span></div>
                <div class="flex justify-between gap-4"><span class="text-gray-500">Rebalanced at</span><span class="text-white"><%= @latest_aerodrome_weth_rebalance.rebalanced_at.strftime("%m/%d/%Y %H:%M") %></span></div>
                <div class="flex justify-between gap-4"><span class="text-gray-500">Message</span><span class="text-white text-right"><%= @latest_aerodrome_weth_rebalance.message.presence || "-" %></span></div>
              </div>
            <% else %>
              <p class="mt-3 text-gray-500 text-sm">No WETH/ETH rebalance history.</p>
            <% end %>
          </div>
        </div>
      <% end %>
      <div class="bg-gray-950/40 border border-gray-800 rounded-lg p-4 md:col-span-2">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="text-gray-400 text-xs uppercase tracking-wide">Production Hedge Dashboard</p>
            <p class="text-yellow-200/80 text-xs mt-2">Preview first &middot; Live submit requires env gates plus typed confirmation &middot; Close uses emergency close</p>
          </div>
          <% if production_dashboard[:within_caps] %>
            <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-green-950/50 text-green-300 border border-green-800">within caps</span>
          <% else %>
            <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-red-950/50 text-red-200 border border-red-800">blocked</span>
          <% end %>
        </div>
        <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
          <div class="flex justify-between gap-4"><span class="text-gray-500">Configured ETH cap</span><span class="text-white"><%= production_dashboard[:current_configured_hedge_cap_eth].presence || "missing" %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">Hard ETH ceiling</span><span class="text-white"><%= hard_ceiling[:hard_max_short_eth].presence || "missing" %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">Configured notional cap</span><span class="text-white"><%= production_dashboard[:current_configured_hedge_cap_notional_usd].present? ? format_usd(BigDecimal(production_dashboard[:current_configured_hedge_cap_notional_usd])) : "missing" %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">Hard notional ceiling</span><span class="text-white"><%= hard_ceiling[:hard_max_short_notional_usd].present? ? format_usd(BigDecimal(hard_ceiling[:hard_max_short_notional_usd])) : "missing" %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">Emergency close cap</span><span class="text-white"><%= production_dashboard[:configured_emergency_close_max_eth].presence || "missing" %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">Hard emergency ceiling</span><span class="text-white"><%= hard_ceiling[:hard_emergency_close_max_eth].presence || "missing" %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">LP WETH amount</span><span class="text-white"><%= production_dashboard[:current_aerodrome_lp_weth_amount].presence || "unavailable" %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">Target hedge</span><span class="text-white"><%= production_dashboard[:target_hedge_eth].presence || "unavailable" %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">Target notional</span><span class="text-white"><%= production_dashboard[:target_hedge_notional_usd].present? ? format_usd(BigDecimal(production_dashboard[:target_hedge_notional_usd])) : "unavailable" %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">Current ETH short</span><span class="text-white"><%= production_dashboard[:current_short_eth].presence || "unavailable" %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">Current ETH notional</span><span class="text-white"><%= production_dashboard[:current_short_notional_usd].present? ? format_usd(BigDecimal(production_dashboard[:current_short_notional_usd])) : "unavailable" %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">Drift ETH</span><span class="text-white"><%= production_dashboard[:drift_eth].presence || "unavailable" %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">Drift notional</span><span class="text-white"><%= production_dashboard[:drift_notional_usd].present? ? format_usd(BigDecimal(production_dashboard[:drift_notional_usd])) : "unavailable" %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">Current Hyperliquid ETH position</span><span class="text-white text-right"><%= production_dashboard[:current_hyperliquid_eth_position] ? production_dashboard[:current_hyperliquid_eth_position].inspect : "nil / unavailable" %></span></div>
        </div>
        <% if production_dashboard[:blockers].present? %>
          <div class="mt-4 bg-red-950/30 border border-red-900 rounded-lg p-3">
            <p class="text-red-200 text-sm font-semibold">Blockers</p>
            <ul class="mt-2 list-disc list-inside text-red-100/90 text-sm space-y-1">
              <% production_dashboard[:blockers].each do |blocker| %>
                <li><%= blocker %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <% if production_dashboard[:warnings].present? %>
          <div class="mt-4 bg-yellow-950/30 border border-yellow-900 rounded-lg p-3">
            <p class="text-yellow-200 text-sm font-semibold">Warnings</p>
            <ul class="mt-2 list-disc list-inside text-yellow-100/90 text-sm space-y-1">
              <% production_dashboard[:warnings].each do |warning| %>
                <li><%= warning %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="mt-4 border-t border-gray-800 pt-4">
          <p class="text-gray-400 text-xs uppercase tracking-wide">Dashboard Flow</p>
          <% dashboard_actions = production_dashboard[:dashboard_actions] || {} %>
          <% dashboard_confirmation = AerodromeDashboardHedgeAction::CONFIRMATION %>
          <div class="mt-3 grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-white font-medium">Refresh / sync</p>
              <p class="text-gray-400 mt-1"><%= production_dashboard.dig(:action_plan, :refresh_sync) %></p>
            </div>
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-white font-medium">Open / approve hedge</p>
              <p class="text-gray-400 mt-1"><%= production_dashboard.dig(:action_plan, :approve_or_edit_hedge) %></p>
            </div>
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-white font-medium">Rebalance hedge</p>
              <p class="text-gray-400 mt-1"><%= production_dashboard.dig(:action_plan, :open_or_rebalance) %></p>
            </div>
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-white font-medium">Close hedge</p>
              <p class="text-gray-400 mt-1"><%= production_dashboard.dig(:action_plan, :close_hedge) %></p>
            </div>
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3 md:col-span-2">
              <p class="text-white font-medium">Stop / close plan</p>
              <p class="text-gray-400 mt-1"><%= production_dashboard.dig(:action_plan, :stop_close_plan) %></p>
            </div>
          </div>
          <div class="mt-4 bg-gray-950/50 border border-gray-800 rounded-lg p-4">
            <p class="text-white font-medium">Dashboard Hedge Actions</p>
            <p class="text-gray-400 text-xs mt-1">Preview buttons are dry-run. Live buttons submit only one explicit action and remain blocked unless all dashboard live gates are configured.</p>
            <% selected_venue = @selected_hedge_venue || HedgeVenues::DEFAULT %>
            <% selected_adapter = @selected_hedge_venue_adapter || HedgeVenues.build(selected_venue) %>
            <% venue_live_actions_enabled = selected_venue == HedgeVenues::DEFAULT %>
            <div class="mt-4 rounded-lg border border-gray-800 bg-gray-900/60 p-3">
              <%= form_with url: position_path(@position), method: :get, class: "flex flex-col sm:flex-row gap-3 sm:items-end" do |form| %>
                <div class="flex-1">
                  <%= form.label :hedge_venue, "Hedge venue", class: "block text-gray-500 text-xs uppercase tracking-wide" %>
                  <%= form.select :hedge_venue, options_for_select(@hedge_venue_options || HedgeVenues.options, selected_venue), {}, class: "mt-1 w-full bg-gray-950 border border-gray-700 rounded-lg px-3 py-2 text-sm text-white" %>
                </div>
                <%= form.submit "Apply", class: "bg-gray-700 hover:bg-gray-600 text-gray-100 px-3 py-2 rounded-lg text-sm font-medium transition" %>
              <% end %>
              <div class="mt-3 flex flex-wrap gap-2 text-xs">
                <span class="inline-block px-2 py-1 rounded-full border border-gray-700 text-gray-200"><%= selected_adapter.venue_name %></span>
                <span class="inline-block px-2 py-1 rounded-full border border-gray-700 text-gray-200"><%= selected_adapter.mode.humanize %></span>
                <% if selected_adapter.live_supported? && selected_adapter.live_enabled? %>
                  <span class="inline-block px-2 py-1 rounded-full border border-green-800 bg-green-950/40 text-green-200">live enabled</span>
                <% else %>
                  <span class="inline-block px-2 py-1 rounded-full border border-yellow-800 bg-yellow-950/40 text-yellow-200">dry-run/read-only</span>
                <% end %>
              </div>
              <% if selected_adapter.blockers.present? %>
                <p class="mt-2 text-yellow-200 text-xs"><%= selected_adapter.blockers.join("; ") %></p>
              <% end %>
            </div>
            <div class="mt-4 grid grid-cols-1 lg:grid-cols-3 gap-3">
              <% [
                [ :open, hedge_open_preview_position_path(@position), hedge_open_position_path(@position), "Open Hedge", dashboard_confirmation ],
                [ :rebalance, hedge_rebalance_preview_position_path(@position), hedge_rebalance_position_path(@position), "Rebalance Hedge", dashboard_confirmation ],
                [ :close, hedge_close_preview_position_path(@position), hedge_close_position_path(@position), "Close Hedge", AerodromeLiveEmergencyClose::CONFIRMATION ]
              ].each do |key, preview_path, live_path, label, required_phrase| %>
                <% action_state = dashboard_actions[key] || {} %>
                <% action_visible = action_state[:visible] %>
                <% live_enabled = action_state[:live_enabled] %>
                <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
                  <div class="flex items-center justify-between gap-2">
                    <p class="text-white font-medium"><%= label %></p>
                    <% if action_visible %>
                      <span class="text-green-300 text-xs">available</span>
                    <% else %>
                      <span class="text-gray-500 text-xs">not needed</span>
                    <% end %>
                  </div>
                  <div class="mt-3 flex flex-wrap gap-2">
                    <%= button_to "#{label} Preview", preview_path, method: :post, params: { hedge_venue: selected_venue }, disabled: !action_visible, class: "bg-gray-700 hover:bg-gray-600 disabled:bg-gray-900 disabled:text-gray-600 text-gray-100 px-3 py-2 rounded-lg text-xs font-medium transition" %>
                  </div>
                  <div class="mt-3 rounded-lg border border-gray-800 bg-gray-950/60 p-2">
                    <p class="text-gray-500 text-xs">Required phrase</p>
                    <div class="mt-1 flex items-center gap-2">
                      <code id="dashboard-hedge-phrase-<%= key %>" class="flex-1 break-all text-[11px] text-gray-200"><%= required_phrase %></code>
                      <button type="button" class="shrink-0 bg-gray-800 hover:bg-gray-700 text-gray-100 px-2 py-1 rounded text-xs" onclick="navigator.clipboard.writeText(document.getElementById('dashboard-hedge-phrase-<%= key %>').innerText)">Copy</button>
                    </div>
                    <p class="text-gray-500 text-xs mt-2">Paste this exact phrase to enable live submit.</p>
                  </div>
                  <%= form_with url: live_path, method: :post, class: "mt-3" do |form| %>
                    <%= form.hidden_field :hedge_venue, value: selected_venue %>
                    <%= form.text_field :dashboard_hedge_confirmation, placeholder: required_phrase, value: "", autocomplete: "off", disabled: !action_visible || !live_enabled || !venue_live_actions_enabled, class: "w-full bg-gray-950 border border-gray-700 rounded-lg px-2 py-2 text-xs text-white placeholder-gray-600 disabled:text-gray-600 disabled:border-gray-800" %>
                    <%= form.submit "#{label} Live", disabled: !action_visible || !live_enabled || !venue_live_actions_enabled, class: "mt-2 w-full bg-red-900/70 hover:bg-red-800 disabled:bg-gray-900 disabled:text-gray-600 text-red-100 border border-red-700 disabled:border-gray-800 px-3 py-2 rounded-lg text-xs font-semibold transition" %>
                  <% end %>
                  <% unless venue_live_actions_enabled %>
                    <p class="text-yellow-200 text-xs mt-2">Live submit is disabled for <%= selected_adapter.venue_name %>; previews do not create orders.</p>
                  <% end %>
                  <% if action_state[:blockers].present? %>
                    <p class="text-yellow-200 text-xs mt-2"><%= action_state[:blockers].join("; ") %></p>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
      <div class="bg-gray-950/40 border border-gray-800 rounded-lg p-4 md:col-span-2">
        <% auto_status = @aerodrome_auto_rebalance_status || {} %>
        <% auto_hedge = auto_status[:hedge] %>
        <% scheduler = auto_status[:scheduler] || {} %>
        <% auto_state = auto_status[:auto_rebalance_status] || "blocked" %>
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="text-gray-400 text-xs uppercase tracking-wide">Auto-Rebalance Status</p>
            <p class="text-yellow-200/80 text-xs mt-2">Read-only estimate. HedgeSyncJob triggers on drift, not a fixed ETH price.</p>
          </div>
          <span class="inline-block px-2 py-1 rounded-full border text-xs font-semibold <%= auto_rebalance_status_class(auto_state) %>"><%= auto_state == "active" ? "Active" : auto_state.capitalize %></span>
        </div>
        <% if auto_hedge.nil? %>
          <p class="mt-4 text-gray-400 text-sm">No active hedge configured for this position.</p>
        <% else %>
          <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-3 text-sm">
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-gray-500 text-xs uppercase tracking-wide">Position sync</p>
              <p class="text-white font-medium mt-1"><%= scheduler[:position_sync_schedule].presence || "unknown" %></p>
            </div>
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-gray-500 text-xs uppercase tracking-wide">Hedge sync</p>
              <p class="text-white font-medium mt-1"><%= scheduler[:hedge_sync_schedule].presence || "unknown" %></p>
            </div>
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-gray-500 text-xs uppercase tracking-wide">Rebalance needed now</p>
              <p class="<%= auto_status[:rebalance_needed] ? 'text-red-300' : 'text-green-300' %> font-medium mt-1"><%= auto_status[:rebalance_needed] ? "yes" : "no" %></p>
            </div>
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-gray-500 text-xs uppercase tracking-wide">Current target</p>
              <p class="text-white font-medium mt-1"><%= auto_status[:current_target_hedge_eth].presence || "unavailable" %></p>
            </div>
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-gray-500 text-xs uppercase tracking-wide">Current short</p>
              <p class="text-white font-medium mt-1"><%= auto_status[:current_hyperliquid_eth_short].presence || "unavailable" %></p>
              <% if auto_status[:current_hyperliquid_eth_short].present? && BigDecimal(auto_status[:current_hyperliquid_eth_short]).zero? %>
                <p class="text-yellow-200 text-xs mt-1">No current hedge short detected.</p>
              <% end %>
            </div>
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-gray-500 text-xs uppercase tracking-wide">Current drift</p>
              <p class="text-white font-medium mt-1"><%= auto_status[:current_drift_eth].presence || "unavailable" %></p>
            </div>
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-gray-500 text-xs uppercase tracking-wide">Tolerance</p>
              <p class="text-white font-medium mt-1"><%= auto_status[:tolerance_eth].presence || "unavailable" %></p>
            </div>
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-gray-500 text-xs uppercase tracking-wide">Last rebalance</p>
              <p class="text-white font-medium mt-1"><%= auto_status[:last_rebalance_time]&.strftime("%m/%d/%Y %H:%M") || "No rebalance history yet." %></p>
              <% if auto_status[:last_rebalance_status].present? %>
                <p class="text-gray-400 text-xs mt-1"><%= auto_status[:last_rebalance_status] %></p>
              <% end %>
            </div>
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-gray-500 text-xs uppercase tracking-wide">Tolerance state</p>
              <p class="<%= auto_status[:inside_tolerance] ? 'text-green-300' : 'text-red-300' %> font-medium mt-1"><%= auto_status[:inside_tolerance] ? "inside tolerance" : "outside tolerance" %></p>
            </div>
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-gray-500 text-xs uppercase tracking-wide">Approx lower ETH price threshold</p>
              <p class="text-white font-medium mt-1"><%= auto_status[:estimated_lower_eth_price_threshold].present? ? format_usd(BigDecimal(auto_status[:estimated_lower_eth_price_threshold])) : "unavailable" %></p>
            </div>
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-gray-500 text-xs uppercase tracking-wide">Approx upper ETH price threshold</p>
              <p class="text-white font-medium mt-1"><%= auto_status[:estimated_upper_eth_price_threshold].present? ? format_usd(BigDecimal(auto_status[:estimated_upper_eth_price_threshold])) : "unavailable" %></p>
            </div>
            <div class="bg-yellow-950/30 border border-yellow-900 rounded-lg p-3">
              <p class="text-yellow-200 font-medium">Approximate / low confidence</p>
              <p class="text-yellow-100/80 text-xs mt-1">Rebalance triggers when abs(target hedge - current short) exceeds tolerance. Price thresholds are approximate because Slipstream concentrated-liquidity exposure changes non-linearly.</p>
            </div>
          </div>
          <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-gray-400 text-xs uppercase tracking-wide">Auto-Rebalance Gates</p>
              <dl class="mt-2 space-y-1 text-sm">
                <% (auto_status[:env_gates] || {}).each do |key, value| %>
                  <div class="flex justify-between gap-4"><dt class="text-gray-500"><%= key %></dt><dd class="text-white"><%= value.presence || "missing" %></dd></div>
                <% end %>
              </dl>
            </div>
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-gray-400 text-xs uppercase tracking-wide">Blockers / Warnings</p>
              <% if auto_status[:blockers].present? %>
                <ul class="mt-2 list-disc list-inside text-red-200 text-sm space-y-1">
                  <% auto_status[:blockers].each do |blocker| %>
                    <li><%= blocker %></li>
                  <% end %>
                </ul>
              <% end %>
              <% if auto_status[:warnings].present? %>
                <ul class="mt-2 list-disc list-inside text-yellow-200 text-sm space-y-1">
                  <% auto_status[:warnings].each do |warning| %>
                    <li><%= warning %></li>
                  <% end %>
                </ul>
              <% end %>
              <% if auto_status[:blockers].blank? && auto_status[:warnings].blank? %>
                <p class="text-green-300 text-sm mt-2">No auto-rebalance blockers detected by this read-only check.</p>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      <div class="bg-gray-950/40 border border-gray-800 rounded-lg p-4 md:col-span-2">
        <% rebalance_history = @aerodrome_rebalance_history_status || {} %>
        <% history_hedge = rebalance_history[:hedge] %>
        <% history_records = rebalance_history[:records] || [] %>
        <% history_summary = rebalance_history[:summary] || {} %>
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="text-gray-400 text-xs uppercase tracking-wide">Hedge Rebalance History</p>
            <p class="text-yellow-200/80 text-xs mt-2">Read-only history for the latest hedge on this position. No orders, no Hyperliquid calls, no background jobs.</p>
          </div>
          <%= link_to "Refresh", position_path(@position), class: "bg-gray-800 hover:bg-gray-700 text-gray-100 px-3 py-2 rounded-lg text-xs font-medium transition" %>
        </div>
        <% if history_hedge.nil? %>
          <p class="mt-4 text-gray-400 text-sm">No hedge configured for this position.</p>
        <% elsif history_records.empty? %>
          <p class="mt-4 text-gray-400 text-sm">No rebalance history yet.</p>
        <% else %>
          <div class="mt-4 grid grid-cols-1 md:grid-cols-5 gap-3 text-sm">
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-gray-500 text-xs uppercase tracking-wide">Records shown</p>
              <p class="text-white font-medium mt-1"><%= history_summary[:records_shown] %></p>
            </div>
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-gray-500 text-xs uppercase tracking-wide">Last rebalance</p>
              <p class="text-white font-medium mt-1"><%= history_summary[:last_rebalance_at]&.strftime("%m/%d/%Y %H:%M") || "—" %></p>
            </div>
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-gray-500 text-xs uppercase tracking-wide">Last status</p>
              <p class="text-white font-medium mt-1"><%= history_summary[:last_status] || "—" %></p>
            </div>
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-gray-500 text-xs uppercase tracking-wide">Current short</p>
              <p class="text-white font-medium mt-1"><%= history_summary[:current_short_eth].presence || "unavailable" %></p>
            </div>
            <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
              <p class="text-gray-500 text-xs uppercase tracking-wide">Current drift</p>
              <p class="text-white font-medium mt-1"><%= history_summary[:current_drift_eth].presence || "unavailable" %></p>
            </div>
          </div>
          <div class="mt-4 max-h-[28rem] overflow-y-auto rounded-lg border border-gray-800">
            <table class="w-full min-w-[980px] text-sm">
              <thead class="sticky top-0 z-10 bg-gray-950">
                <tr class="border-b border-gray-800 text-left text-gray-400">
                  <th class="px-3 py-3 font-medium">Time</th>
                  <th class="px-3 py-3 font-medium">Asset</th>
                  <th class="px-3 py-3 font-medium">Status</th>
                  <th class="px-3 py-3 font-medium text-right">Old short</th>
                  <th class="px-3 py-3 font-medium text-right">New short</th>
                  <th class="px-3 py-3 font-medium text-right">Delta ETH</th>
                  <th class="px-3 py-3 font-medium text-right">Realized PnL</th>
                  <th class="px-3 py-3 font-medium">Message / error</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-900">
                <% history_records.each do |rebalance| %>
                  <% delta_eth = rebalance.new_short_size && rebalance.old_short_size ? rebalance.new_short_size - rebalance.old_short_size : nil %>
                  <tr class="hover:bg-gray-900/50">
                    <td class="px-3 py-3 text-gray-300 whitespace-nowrap"><%= rebalance.rebalanced_at&.strftime("%m/%d/%Y %H:%M:%S") || "—" %></td>
                    <td class="px-3 py-3 text-white"><%= rebalance.asset %></td>
                    <td class="px-3 py-3">
                      <span class="inline-block px-2 py-1 rounded-full border text-xs font-semibold <%= rebalance_status_class(rebalance.status) %>"><%= rebalance.status %></span>
                    </td>
                    <td class="px-3 py-3 text-right text-gray-300"><%= rebalance.old_short_size ? number_with_precision(rebalance.old_short_size, precision: 6) : "—" %></td>
                    <td class="px-3 py-3 text-right text-white"><%= rebalance.new_short_size ? number_with_precision(rebalance.new_short_size, precision: 6) : "—" %></td>
                    <td class="px-3 py-3 text-right <%= delta_eth && delta_eth.negative? ? 'text-red-300' : 'text-green-300' %>"><%= signed_eth_delta(delta_eth) %></td>
                    <td class="px-3 py-3 text-right <%= (rebalance.realized_pnl || 0) >= 0 ? 'text-green-300' : 'text-red-300' %>"><%= rebalance.realized_pnl ? format_usd(rebalance.realized_pnl) : "—" %></td>
                    <td class="px-3 py-3 text-gray-300 max-w-md"><%= rebalance.message.presence || "—" %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>
      <div class="bg-gray-950/40 border border-gray-800 rounded-lg p-4 md:col-span-2">
        <p class="text-gray-400 text-xs uppercase tracking-wide">PnL Baseline</p>
        <div class="mt-3 grid grid-cols-1 md:grid-cols-3 gap-3 text-sm">
          <div class="flex justify-between gap-4"><span class="text-gray-500"><%= position_valuation.entry_value_label %></span><span class="text-white"><%= valuation_value_display(position_valuation.entry_value_usd) %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500"><%= position_valuation.current_value_label %></span><span class="text-white"><%= valuation_value_display(position_valuation.current_value_usd) %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500"><%= position_valuation.pool_delta_label %></span><span class="<%= (aerodrome_pool_delta || 0) >= 0 ? 'text-green-300' : 'text-red-300' %>"><%= aerodrome_pool_delta ? format_usd(aerodrome_pool_delta) : "Unavailable" %></span></div>
        </div>
        <% if position_valuation.warnings.present? %>
          <p class="text-yellow-200 text-xs mt-3"><%= position_valuation.warnings.join("; ") %></p>
        <% end %>
        <p class="text-gray-500 text-xs mt-3">PnL baseline starts from first Aerodrome snapshot unless manually set.</p>
      </div>
      <div class="bg-gray-950/40 border border-gray-800 rounded-lg p-4 md:col-span-2">
        <% rewards_report = @aerodrome_rewards_report || {} %>
        <p class="text-gray-400 text-xs uppercase tracking-wide">AERO Rewards</p>
        <p class="text-yellow-200/80 text-xs mt-2">Read-only. Claiming is not implemented. Rewards are not included in Total PnL.</p>
        <div class="mt-3 grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
          <div class="flex justify-between gap-4">
            <span class="text-gray-500">Status</span>
            <span class="text-white"><%= rewards_report[:gauge_status] || rewards_report[:status] || "unavailable" %></span>
          </div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">Staked</span><span class="text-white"><%= rewards_report[:staked].nil? ? "unknown" : rewards_report[:staked] %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">Claimable AERO</span><span class="text-white"><%= rewards_report[:claimable_aero].present? ? number_with_precision(BigDecimal(rewards_report[:claimable_aero].to_s), precision: 6) : "unavailable" %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">AERO USD price</span><span class="text-white"><%= rewards_report[:aero_usd_price].present? ? format_usd(BigDecimal(rewards_report[:aero_usd_price].to_s), precision: 6) : "unavailable" %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">AERO USD price source</span><span class="text-white"><%= rewards_report[:aero_usd_price_source].presence || "unavailable" %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">Claimable AERO USD</span><span class="text-white"><%= rewards_report[:claimable_aero_usd].present? ? format_usd(BigDecimal(rewards_report[:claimable_aero_usd].to_s)) : "unavailable" %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">Depositor address</span><span class="text-white text-right break-all"><%= rewards_report[:depositor_address].presence || "unavailable" %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">Depositor source</span><span class="text-white"><%= rewards_report[:depositor_source].presence || "unavailable" %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">Gauge address</span><span class="text-white text-right break-all"><%= rewards_report[:gauge_address].presence || "unavailable" %></span></div>
          <div class="flex justify-between gap-4"><span class="text-gray-500">Token ID</span><span class="text-white"><%= rewards_report[:token_id].presence || @position.external_id %></span></div>
        </div>
        <% if rewards_report[:warnings].present? %>
          <p class="text-yellow-200 text-xs mt-3"><%= rewards_report[:warnings].join("; ") %></p>
        <% end %>
        <p class="text-gray-500 text-xs mt-3">Unclaimed rewards are an estimate and are not realized until claimed/sold. Claiming is not implemented.</p>
      </div>
      <div class="bg-gray-950/40 border border-gray-800 rounded-lg p-4 md:col-span-2">
        <p class="text-gray-400 text-xs uppercase tracking-wide">Latest Manual Hedge Proposal</p>
        <p class="text-yellow-200/80 text-xs mt-2">Manual proposal only &middot; No orders &middot; No Hyperliquid &middot; Execution disabled &middot; Not a live hedge</p>
        <% if @latest_aerodrome_hedge_proposal %>
          <% proposal = @latest_aerodrome_hedge_proposal %>
          <% stale_reasons = proposal.stale_reasons(@position) %>
          <% safety = @aerodrome_proposal_safety_results.fetch(proposal.id) %>
          <div class="mt-3 grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
            <div class="flex justify-between gap-4"><span class="text-gray-500">Proposal ID</span><span class="text-white"><%= proposal.id %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Status</span><span class="text-white"><%= proposal.status %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Safety status</span><span class="<%= safety.blocked ? 'text-red-300' : (safety.warnings.any? ? 'text-yellow-300' : 'text-green-300') %>"><%= safety.status %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Freshness</span><span class="<%= stale_reasons.any? ? 'text-red-300' : 'text-green-300' %>"><%= proposal.freshness_label(@position) %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Stale reason</span><span class="text-white text-right"><%= stale_reasons.any? ? stale_reasons.join(", ") : "None" %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Suggested action</span><span class="text-white"><%= proposal.hedge_side %> <%= proposal.hedge_asset %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Suggested amount</span><span class="text-white"><%= number_with_precision(proposal.suggested_short_amount, precision: 6) %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Suggested notional</span><span class="text-white"><%= format_usd(proposal.suggested_short_notional_usd) %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">WETH price</span><span class="text-white"><%= format_usd(proposal.weth_price_usd) %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">LP value</span><span class="text-white"><%= format_usd(proposal.lp_total_value_usd) %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Execution</span><span class="text-yellow-300"><%= proposal.execution_enabled? ? "enabled" : "disabled / manual review only" %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Hyperliquid</span><span class="text-yellow-300"><%= proposal.hyperliquid_called? ? "called" : "not called" %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Generated</span><span class="text-white"><%= proposal.generated_at.strftime("%m/%d/%Y %H:%M") %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Source</span><span class="text-white text-right"><%= proposal.source %></span></div>
          </div>
          <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
            <div class="<%= safety.blocked ? 'bg-red-950/30 border-red-800' : 'bg-gray-900/50 border-gray-800' %> border rounded-lg p-3">
              <p class="text-gray-400 text-xs uppercase tracking-wide">Checked Limits</p>
              <dl class="mt-2 space-y-1">
                <% safety.checked_limits.each do |key, limit| %>
                  <div class="flex justify-between gap-4">
                    <dt class="text-gray-500"><%= key.to_s.humanize %></dt>
                    <dd class="text-white text-right">
                      actual <%= limit[:actual]&.to_s("F") || "unavailable" %> /
                      limit <%= limit[:configured] ? (limit[:limit]&.to_s("F") || "invalid") : "not configured" %>
                      (<%= limit[:status] %>)
                    </dd>
                  </div>
                <% end %>
              </dl>
            </div>
            <div class="<%= safety.blocked ? 'bg-red-950/30 border-red-800' : 'bg-gray-900/50 border-gray-800' %> border rounded-lg p-3">
              <p class="text-gray-400 text-xs uppercase tracking-wide">Failures / Warnings</p>
              <% if safety.failures.any? %>
                <ul class="mt-2 list-disc list-inside text-red-200 space-y-1">
                  <% safety.failures.each do |failure| %>
                    <li><%= failure %></li>
                  <% end %>
                </ul>
              <% end %>
              <% if safety.warnings.any? %>
                <ul class="mt-2 list-disc list-inside text-yellow-200 space-y-1">
                  <% safety.warnings.each do |warning| %>
                    <li><%= warning %></li>
                  <% end %>
                </ul>
              <% end %>
              <% if safety.failures.empty? && safety.warnings.empty? %>
                <p class="mt-2 text-green-300">All configured proposal safety limits passed.</p>
              <% end %>
            </div>
          </div>
          <p class="text-yellow-200/80 text-sm mt-4">Local record only. Review does not place orders, call Hyperliquid, or create a live hedge.</p>
          <div class="flex flex-wrap gap-3 mt-4">
            <% if proposal.status == "draft" %>
              <% if safety.blocked %>
                <span class="inline-flex items-center px-3 py-2 rounded-lg text-sm font-medium bg-red-950/70 text-red-200 border border-red-800">Blocked proposals cannot be marked reviewed</span>
              <% else %>
                <%= button_to "Mark Reviewed", mark_reviewed_aerodrome_hedge_proposal_path(proposal), method: :post, class: "bg-gray-700 hover:bg-gray-600 text-gray-200 px-3 py-2 rounded-lg text-sm font-medium transition" %>
              <% end %>
              <%= button_to "Reject", reject_aerodrome_hedge_proposal_path(proposal), method: :post, class: "bg-red-950/70 hover:bg-red-950 text-red-200 border border-red-800 px-3 py-2 rounded-lg text-sm font-medium transition" %>
            <% end %>
          </div>
        <% else %>
          <p class="mt-3 text-gray-300 font-medium">No manual hedge proposal generated.</p>
          <p class="text-gray-500 text-sm mt-1">Generate a local proposal for manual review only. Execution remains disabled.</p>
        <% end %>
      </div>
      <div class="bg-gray-950/40 border border-gray-800 rounded-lg p-4 md:col-span-2 overflow-x-auto">
        <p class="text-gray-400 text-xs uppercase tracking-wide">Manual Proposal History</p>
        <p class="text-yellow-200/80 text-xs mt-2">Manual proposal only &middot; No orders &middot; No Hyperliquid &middot; Execution disabled &middot; Not a live hedge</p>
        <% if @aerodrome_hedge_proposals.present? %>
          <table class="w-full mt-4 text-sm">
            <thead>
              <tr class="border-b border-gray-800">
                <th class="text-left text-gray-500 font-medium py-2 pr-3">ID</th>
                <th class="text-left text-gray-500 font-medium py-2 pr-3">Status</th>
                <th class="text-left text-gray-500 font-medium py-2 pr-3">Safety</th>
                <th class="text-left text-gray-500 font-medium py-2 pr-3">Failures / Warnings</th>
                <th class="text-left text-gray-500 font-medium py-2 pr-3">Asset</th>
                <th class="text-left text-gray-500 font-medium py-2 pr-3">Side</th>
                <th class="text-right text-gray-500 font-medium py-2 pr-3">Amount</th>
                <th class="text-right text-gray-500 font-medium py-2 pr-3">Notional</th>
                <th class="text-left text-gray-500 font-medium py-2 pr-3">Generated</th>
                <th class="text-left text-gray-500 font-medium py-2 pr-3">Reviewed</th>
                <th class="text-left text-gray-500 font-medium py-2 pr-3">Execution</th>
                <th class="text-left text-gray-500 font-medium py-2">Hyperliquid</th>
              </tr>
            </thead>
            <tbody>
              <% @aerodrome_hedge_proposals.each do |proposal| %>
                <% stale_reasons = proposal.stale_reasons(@position) %>
                <% safety = @aerodrome_proposal_safety_results.fetch(proposal.id) %>
                <tr class="border-b border-gray-900 <%= safety.blocked ? 'bg-red-950/20' : '' %>">
                  <td class="py-2 pr-3 text-white"><%= proposal.id %></td>
                  <td class="py-2 pr-3 text-white"><%= proposal.status %></td>
                  <td class="py-2 pr-3 <%= safety.blocked ? 'text-red-300' : (safety.warnings.any? ? 'text-yellow-300' : 'text-green-300') %>"><%= safety.status %></td>
                  <td class="py-2 pr-3 text-gray-300"><%= (safety.failures + safety.warnings).presence&.join(", ") || "None" %></td>
                  <td class="py-2 pr-3 text-white"><%= proposal.hedge_asset %></td>
                  <td class="py-2 pr-3 text-white"><%= proposal.hedge_side %></td>
                  <td class="py-2 pr-3 text-right text-white"><%= number_with_precision(proposal.suggested_short_amount, precision: 6) %></td>
                  <td class="py-2 pr-3 text-right text-white"><%= format_usd(proposal.suggested_short_notional_usd) %></td>
                  <td class="py-2 pr-3 text-gray-300"><%= proposal.generated_at.strftime("%m/%d/%Y %H:%M") %></td>
                  <td class="py-2 pr-3 text-gray-300"><%= proposal.reviewed_at ? proposal.reviewed_at.strftime("%m/%d/%Y %H:%M") : "-" %></td>
                  <td class="py-2 pr-3 text-yellow-300"><%= proposal.execution_enabled? ? "enabled" : "disabled" %></td>
                  <td class="py-2 text-yellow-300"><%= proposal.hyperliquid_called? ? "called" : "not called" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="mt-3 text-gray-500 text-sm">No manual proposal history.</p>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<% position_valuation = @position_valuation || PositionValuation.current(@position) %>
<% pool_unrealized = position_valuation.pool_delta_usd %>
<% latest_snap = @pnl_snapshots.first %>
<% hedge_unrealized = (latest_snap&.hedge_unrealized || 0).to_d %>
<% hedge_realized = (latest_snap&.hedge_realized || 0).to_d %>
<% total_unrealized = pool_unrealized ? pool_unrealized + hedge_unrealized : hedge_unrealized %>
<% total_fees = latest_snap&.total_fees_usd || 0 %>
<% aerodrome_fees_pnl = @aerodrome_fees_report&.fetch(:total_fees_usd, nil).presence %>
<% aerodrome_fees_pnl = BigDecimal(aerodrome_fees_pnl.to_s) if aerodrome_fees_pnl %>
<% total_pnl_available = pool_unrealized.present? || !@position.mellow_autopilot? %>
<% total_pnl = total_pnl_available ? total_unrealized + hedge_realized + (aerodrome_position?(@position) ? 0 : total_fees) : nil %>
<% rewards_pnl = @aerodrome_rewards_report&.fetch(:claimable_aero_usd, nil).presence %>
<% rewards_pnl = BigDecimal(rewards_pnl.to_s) if rewards_pnl %>
<% total_pnl_with_rewards = total_pnl && rewards_pnl ? total_pnl + rewards_pnl : nil %>
<% total_pnl_with_rewards_and_fees = total_pnl_with_rewards && aerodrome_fees_pnl ? total_pnl_with_rewards + aerodrome_fees_pnl : nil %>
<% mellow_asset0_value = @position.mellow_autopilot? && position_valuation.current_value_usd && position_valuation.usdc_exposure ? position_valuation.current_value_usd - position_valuation.usdc_exposure : nil %>
<% mellow_asset1_value = @position.mellow_autopilot? ? position_valuation.usdc_exposure : nil %>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-4 space-y-2">
    <p class="text-gray-400 text-xs uppercase tracking-wide"><%= @position.asset0 %></p>
    <p class="text-xl font-bold text-white"><%= @position.mellow_autopilot? ? valuation_value_display(mellow_asset0_value) : asset_value_display(@position.asset0_amount, @position.asset0_price_usd) %></p>
    <p class="text-gray-500 text-sm"><%= amount_display(@position.asset0_amount, precision: 6) %> &middot; <%= price_display(@position.asset0_price_usd) %></p>
  </div>
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-4 space-y-2">
    <p class="text-gray-400 text-xs uppercase tracking-wide"><%= @position.asset1 %></p>
    <p class="text-xl font-bold text-white"><%= @position.mellow_autopilot? ? valuation_value_display(mellow_asset1_value) : asset_value_display(@position.asset1_amount, @position.asset1_price_usd) %></p>
    <p class="text-gray-500 text-sm"><%= amount_display(@position.asset1_amount, precision: 2) %> &middot; <%= price_display(@position.asset1_price_usd) %></p>
  </div>
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-4 space-y-2">
    <p class="text-gray-400 text-xs uppercase tracking-wide"><%= @position.mellow_autopilot? ? "Mellow Pro-Rata Value" : "Total Pooled Value" %></p>
    <p class="text-xl font-bold text-white"><%= valuation_value_display(position_valuation.current_value_usd) %></p>
    <% if position_valuation.entry_value_usd %>
      <p class="text-gray-500 text-sm">Entry: <%= format_usd(position_valuation.entry_value_usd) %></p>
    <% else %>
      <p class="text-gray-500 text-sm"><%= asset_value_display(@position.asset0_amount, @position.asset0_price_usd) %> &middot; <%= asset_value_display(@position.asset1_amount, @position.asset1_price_usd) %></p>
    <% end %>
  </div>
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-4 space-y-2">
    <p class="text-gray-400 text-xs uppercase tracking-wide">Hedge</p>
    <% if @position.hedge %>
      <% hedge_value = position_valuation.current_value_usd ? position_valuation.current_value_usd * @position.hedge.target : nil %>
      <p class="text-xl font-bold <%= @position.hedge.active? ? 'text-white' : 'text-gray-500' %>">
        <%= valuation_value_display(hedge_value) %>
      </p>
      <p class="text-gray-500 text-sm">Target: <%= number_to_percentage(@position.hedge.target * 100, precision: 0) %> &middot; Tolerance: <%= number_to_percentage(@position.hedge.tolerance * 100, precision: 0) %></p>
    <% else %>
      <p class="text-xl font-bold text-gray-500">None</p>
    <% end %>
  </div>
</div>

<h2 class="text-xl font-semibold text-white mb-4">PnL Summary</h2>
<div class="grid grid-cols-3 gap-4 mb-6">
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-5">
    <p class="text-gray-400 text-xs uppercase tracking-wide">Total PnL</p>
    <p class="text-2xl font-bold mt-2 <%= (total_pnl || 0) >= 0 ? 'text-green-400' : 'text-red-400' %>">
      <%= total_pnl ? format_usd(total_pnl) : "Unavailable" %>
    </p>
    <p class="text-gray-500 text-sm mt-1">
      Unrealized: <span class="<%= total_unrealized >= 0 ? 'text-green-400' : 'text-red-400' %>"><%= total_pnl_available ? format_usd(total_unrealized) : "Unavailable" %></span>
      &middot; Realized: <span class="<%= hedge_realized >= 0 ? 'text-green-400' : 'text-red-400' %>"><%= format_usd(hedge_realized) %></span>
      &middot; Fees: <span class="text-green-400"><%= aerodrome_position?(@position) ? "see Aerodrome LP Fees" : format_usd(total_fees) %></span>
    </p>
  </div>
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-5">
    <p class="text-gray-400 text-xs uppercase tracking-wide">Total Unrealized</p>
    <p class="text-2xl font-bold mt-2 <%= total_unrealized >= 0 ? 'text-green-400' : 'text-red-400' %>">
      <%= total_pnl_available ? format_usd(total_unrealized) : "Unavailable" %>
    </p>
    <p class="text-gray-500 text-sm mt-1">
      Pool: <span class="<%= (pool_unrealized || 0) >= 0 ? 'text-green-400' : 'text-red-400' %>"><%= pool_unrealized ? format_usd(pool_unrealized) : "Unavailable" %></span>
      &middot; Hedge: <span class="<%= hedge_unrealized >= 0 ? 'text-green-400' : 'text-red-400' %>"><%= format_usd(hedge_unrealized) %></span>
    </p>
  </div>
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-5">
    <p class="text-gray-400 text-xs uppercase tracking-wide">Realized PnL</p>
    <p class="text-2xl font-bold mt-2 <%= hedge_realized >= 0 ? 'text-green-400' : 'text-red-400' %>">
      <%= format_usd(hedge_realized) %>
    </p>
  </div>
</div>
<% if aerodrome_position?(@position) %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="bg-gray-900 rounded-xl border border-gray-800 p-5">
      <p class="text-gray-400 text-xs uppercase tracking-wide">Total PnL Excluding Rewards / Fees</p>
      <p class="text-2xl font-bold mt-2 <%= (total_pnl || 0) >= 0 ? 'text-green-400' : 'text-red-400' %>"><%= total_pnl ? format_usd(total_pnl) : "Unavailable" %></p>
      <p class="text-gray-500 text-sm mt-1">Pool and hedge only. Unclaimed AERO rewards and LP fee estimates excluded.</p>
    </div>
    <div class="bg-gray-900 rounded-xl border border-gray-800 p-5">
      <p class="text-gray-400 text-xs uppercase tracking-wide">Total PnL Including Unclaimed AERO Rewards Estimate</p>
      <% if total_pnl_with_rewards %>
        <p class="text-2xl font-bold mt-2 <%= total_pnl_with_rewards >= 0 ? 'text-green-400' : 'text-red-400' %>"><%= format_usd(total_pnl_with_rewards) %></p>
        <p class="text-gray-500 text-sm mt-1">Includes unclaimed AERO rewards estimate. Unclaimed rewards are not realized until claimed/sold.</p>
      <% else %>
        <p class="text-2xl font-bold mt-2 text-gray-500">Unavailable</p>
        <p class="text-gray-500 text-sm mt-1">AERO USD unavailable. Rewards are read-only; claiming is not implemented.</p>
      <% end %>
    </div>
    <div class="bg-gray-900 rounded-xl border border-gray-800 p-5">
      <p class="text-gray-400 text-xs uppercase tracking-wide">Total PnL Including Rewards + LP Fees Estimate</p>
      <% if total_pnl_with_rewards_and_fees %>
        <p class="text-2xl font-bold mt-2 <%= total_pnl_with_rewards_and_fees >= 0 ? 'text-green-400' : 'text-red-400' %>"><%= format_usd(total_pnl_with_rewards_and_fees) %></p>
        <p class="text-gray-500 text-sm mt-1">Includes unclaimed AERO rewards and unclaimed LP fees estimates. Neither is realized until claimed/collected.</p>
      <% else %>
        <p class="text-2xl font-bold mt-2 text-gray-500">Unavailable</p>
        <p class="text-gray-500 text-sm mt-1">Including fees unavailable. Fee values are read-only estimates when available.</p>
      <% end %>
    </div>
  </div>
<% end %>
<% if latest_snap %>
  <p class="text-gray-600 text-xs mb-8">As of <%= latest_snap.captured_at.strftime("%m/%d/%Y %H:%M") %></p>
<% end %>

<h2 class="text-xl font-semibold text-white mb-4">LP Fees</h2>
<% if aerodrome_position?(@position) %>
  <% fees_report = @aerodrome_fees_report || {} %>
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-5 mb-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="text-gray-400 text-xs uppercase tracking-wide">Aerodrome LP Fees</p>
        <p class="text-yellow-200/80 text-xs mt-2">Read-only. Collecting fees is not implemented. Fee values are estimates until collected.</p>
      </div>
      <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-gray-800 text-gray-300 border border-gray-700"><%= fees_report[:status].presence || "unavailable" %></span>
    </div>
    <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
      <div class="flex justify-between gap-4"><span class="text-gray-500">Source / method</span><span class="text-white text-right"><%= fees_report[:fee_source].presence || "unavailable" %></span></div>
      <div class="flex justify-between gap-4"><span class="text-gray-500">Token ID</span><span class="text-white"><%= fees_report[:token_id].presence || @position.external_id %></span></div>
      <div class="flex justify-between gap-4"><span class="text-gray-500">Fee0 amount</span><span class="text-white"><%= fees_report[:fee0_amount].present? ? "#{number_with_precision(BigDecimal(fees_report[:fee0_amount].to_s), precision: 6)} #{fees_report[:fee0_symbol]}" : "unavailable" %></span></div>
      <div class="flex justify-between gap-4"><span class="text-gray-500">Fee0 USD</span><span class="text-white"><%= fees_report[:fee0_usd].present? ? format_usd(BigDecimal(fees_report[:fee0_usd].to_s)) : "unavailable" %></span></div>
      <div class="flex justify-between gap-4"><span class="text-gray-500">Fee1 amount</span><span class="text-white"><%= fees_report[:fee1_amount].present? ? "#{number_with_precision(BigDecimal(fees_report[:fee1_amount].to_s), precision: 6)} #{fees_report[:fee1_symbol]}" : "unavailable" %></span></div>
      <div class="flex justify-between gap-4"><span class="text-gray-500">Fee1 USD</span><span class="text-white"><%= fees_report[:fee1_usd].present? ? format_usd(BigDecimal(fees_report[:fee1_usd].to_s)) : "unavailable" %></span></div>
      <div class="flex justify-between gap-4 md:col-span-2"><span class="text-gray-500">Unclaimed fees USD estimate</span><span class="text-white"><%= fees_report[:total_fees_usd].present? ? format_usd(BigDecimal(fees_report[:total_fees_usd].to_s)) : "unavailable" %></span></div>
    </div>
    <% if fees_report[:warnings].present? %>
      <p class="text-yellow-200 text-xs mt-3"><%= fees_report[:warnings].join("; ") %></p>
    <% end %>
    <p class="text-gray-500 text-xs mt-3">Unclaimed fees are not realized PnL until collected. Collecting fees is not implemented.</p>
  </div>
<% else %>
  <div class="grid grid-cols-3 gap-4">
    <div class="bg-gray-900 rounded-xl border border-gray-800 p-5">
      <p class="text-gray-400 text-xs uppercase tracking-wide">Collected</p>
      <p class="text-2xl font-bold mt-2 text-green-400">
        <%= format_usd(latest_snap&.collected_fees_usd || 0) %>
      </p>
    </div>
    <div class="bg-gray-900 rounded-xl border border-gray-800 p-5">
      <p class="text-gray-400 text-xs uppercase tracking-wide">Uncollected</p>
      <p class="text-2xl font-bold mt-2 text-green-400">
        <%= format_usd(latest_snap&.uncollected_fees_usd || 0) %>
      </p>
    </div>
