                  <%= HedgeVenues.label(pnl_execution_venue) %> short PnL uses readback entry price minus mark price times short size.
                <% else %>
                  <%= dashboard_status[:venue_hedge_pnl_message].presence || "#{HedgeVenues.label(pnl_execution_venue)} hedge PnL unavailable: readback missing entry price." %>
                <% end %>
              </p>
            <% end %>
            <% if position_valuation.warnings.present? %>
              <ul class="mt-4 list-disc space-y-1 pl-5 text-sm text-yellow-100">
                <% position_valuation.warnings.each do |warning| %>
                  <li><%= warning %></li>
                <% end %>
              </ul>
            <% end %>
            <% if legacy_rewards_unavailable %>
