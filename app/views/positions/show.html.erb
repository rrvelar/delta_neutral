        </div>
        <p class="text-sm text-gray-400">Missing venue components include a reason and are not treated as zero.</p>
      </div>
      <% accounting_rows = [
        [ "Unrealized hedge PnL", accounting_components.dig(:unrealized_pnl_usd, :value).presence || snapshot_unrealized_pnl, snapshot_unrealized_pnl.present? ? "snapshot" : accounting_components.dig(:unrealized_pnl_usd, :state), snapshot_unrealized_pnl.present? ? "PositionDashboardSnapshot" : accounting_components.dig(:unrealized_pnl_usd, :source) ],
        [ "Realized hedge PnL", accounting_components.dig(:realized_pnl_usd, :value).presence || snapshot_realized_pnl, snapshot_realized_pnl.present? ? "snapshot" : accounting_components.dig(:realized_pnl_usd, :state), snapshot_realized_pnl.present? ? "PositionDashboardSnapshot" : accounting_components.dig(:realized_pnl_usd, :source) ],
        [ "Trading fees", accounting_components.dig(:trading_fees_usd, :value), accounting_components.dig(:trading_fees_usd, :state), accounting_components.dig(:trading_fees_usd, :source) ],
        [ "Funding", accounting_components.dig(:funding_pnl_usd, :value), accounting_components.dig(:funding_pnl_usd, :state), accounting_components.dig(:funding_pnl_usd, :source) ],
        [ "Borrow / interest", accounting_components.dig(:borrow_interest_usd, :value), accounting_components.dig(:borrow_interest_usd, :state), accounting_components.dig(:borrow_interest_usd, :source) ],
        [ "Partial hedge PnL", hedge_accounting[:net_venue_pnl_usd].presence || partial_hedge_pnl, hedge_accounting[:net_venue_pnl_usd].present? ? "available" : (partial_hedge_pnl.present? ? "partial" : "unavailable"), hedge_accounting[:net_venue_pnl_usd].present? ? "realized + unrealized + funding - fees - borrow + rebates" : partial_hedge_pnl_note ]
      ] %>
      <% visible_accounting_rows = accounting_rows.select { |label, value, _state, _source| value.present? || label == "Realized hedge PnL" } %>
      <% compact_missing_accounting = accounting_rows.select { |label, value, _state, _source| value.blank? && ![ "Realized hedge PnL", "Partial hedge PnL" ].include?(label) }.map(&:first) %>
      <% if visible_accounting_rows.none? { |_label, value, _state, _source| value.present? } %>
        <div class="mt-4 rounded-xl border border-gray-800 bg-gray-950/60 p-4">
          <p class="text-sm font-medium text-white">Venue accounting unavailable on initial render</p>
          <p class="mt-1 text-sm text-gray-400">Reason: optional accounting snapshots have not been refreshed for this page render. Next action: run accounting refresh from the diagnostics link. This does not mark the production runner blocked.</p>
        </div>
      <% else %>
        <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-3">
          <% visible_accounting_rows.each do |label, value, state, source| %>
            <div class="min-w-0 rounded-xl border border-gray-800 bg-gray-950/60 p-4">
              <p class="text-xs text-gray-500"><%= label %></p>
              <p class="mt-2 text-lg font-semibold <%= value.present? && BigDecimal(value.to_s) < 0 ? 'text-red-300' : 'text-white' rescue 'text-white' %>"><%= value.present? ? format_venue_usd_amount(value) : "unknown" %></p>
              <p class="mt-1 break-words text-xs text-gray-500"><%= state.presence || "unknown because optional accounting snapshot is missing" %> · <%= source.presence || "venue does not expose this component" %></p>
            </div>
          <% end %>
          <% if compact_missing_accounting.any? %>
            <div class="min-w-0 rounded-xl border border-gray-800 bg-gray-950/60 p-4">
              <p class="text-xs text-gray-500">Fees / funding / borrow</p>
              <p class="mt-2 text-lg font-semibold text-white">Diagnostics not loaded</p>
              <p class="mt-1 break-words text-xs text-gray-500">Reason: <%= compact_missing_accounting.join(", ") %> load from Hedge accounting diagnostics and are not treated as zero. Next action: Run accounting refresh.</p>
            </div>
          <% end %>
        </div>
      <% end %>
      <% fee_rates = hedge_accounting[:fee_rates] || {} %>
      <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-3">
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4">
          <p class="text-xs text-gray-500">Fee tier / rate</p>
          <p class="mt-2 text-sm text-white"><%= fee_rates.present? ? fee_rates.map { |key, value| "#{key.to_s.humanize}: #{value}" }.join(" · ") : "unknown - optional accounting snapshot missing" %></p>
        </div>
        <div class="rounded-xl border border-gray-800 bg-gray-950/60 p-4 md:col-span-2">
          <p class="text-xs text-gray-500">Unavailable components</p>
          <p class="mt-2 break-words text-sm text-white"><%= (hedge_accounting[:unavailable_components] || []).map { |key| key.to_s.humanize }.presence&.join(", ") || "None" %></p>
        </div>
      </div>
    </section>

    <section class="grid grid-cols-1 gap-4 xl:grid-cols-3<%= tab_class.call('accounting', 'settings') %>">
