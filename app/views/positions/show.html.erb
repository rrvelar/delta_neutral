                    <div class="flex justify-between gap-4"><dt class="text-gray-500"><%= fees_report[:fee1_symbol].presence || @position.asset1 %> fees</dt><dd class="text-right text-white"><%= format_venue_eth_amount(fees_report[:fee1_amount]) %> <%= fees_report[:fee1_symbol] %> / <%= format_venue_usd_amount(fees_report[:fee1_usd]) %></dd></div>
