        <div><p class="text-xs text-gray-500">Heartbeat</p><p class="text-white"><%= random_production[:heartbeat_updated_at].presence || "not loaded yet - production heartbeat file missing" %></p></div>
        <div><p class="text-xs text-gray-500">Lock pid</p><p class="text-white"><%= random_production[:lock_pid].presence || "none - runner may be stopped or lock absent" %></p></div>
        <div><p class="text-xs text-gray-500">Blockers</p><p class="<%= production_blockers.present? ? 'text-red-300' : 'text-green-300' %>"><%= production_blockers.first.presence || "none" %></p></div>
        <div><p class="text-xs text-gray-500">User action</p><p class="text-white"><%= production_blockers.present? ? "review blocker" : (random_production_running ? "none required" : "start only after direct status is safe") %></p></div>
