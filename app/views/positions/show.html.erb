                <div class="flex justify-between gap-4"><dt class="text-gray-500">Successful method</dt><dd class="text-right text-white"><%= mellow["successful_method"] %></dd></div>
              <% end %>
              <% if mellow["successful_contract"].present? %>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Successful contract</dt><dd class="break-all text-right text-white"><%= mellow["successful_contract"] %></dd></div>
              <% end %>
              <% if mellow["stale_strategy_token_id"].present? %>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Stale strategy token ID</dt><dd class="text-white"><%= mellow["stale_strategy_token_id"] %></dd></div>
              <% end %>
              <div class="flex justify-between gap-4"><dt class="text-gray-500">Confidence</dt><dd class="text-white"><%= mellow["last_probe_confidence"].presence || "unavailable" %></dd></div>
            </dl>
            <% if mellow["last_probe_blockers"].present? %>
              <ul class="mt-3 list-disc space-y-1 pl-5 text-xs text-yellow-100">
                <% Array(mellow["last_probe_blockers"]).each do |blocker| %><li><%= blocker %></li><% end %>
              </ul>
            <% end %>
            <% exposure_time = Time.zone.parse((mellow["last_current_exposure_at"].presence || mellow["last_probe_at"]).to_s) rescue nil %>
            <% if exposure_time.nil? || exposure_time <= Integer(ENV.fetch("MELLOW_EXPOSURE_STALE_AFTER_SECONDS", "300")).seconds.ago %>
              <p class="mt-3 rounded-lg border border-yellow-700/60 bg-yellow-950/40 p-3 text-xs text-yellow-100">Mellow exposure is stale or unavailable; hedge sizing requires a fresh resolver read.</p>
            <% end %>
          </details>
        <% end %>

        <details class="rounded-2xl border border-gray-800 bg-gray-900/80 p-5">
          <summary class="cursor-pointer text-sm font-semibold text-white">Manual Proposal History</summary>
          <% proposals = @aerodrome_hedge_proposals || [] %>
          <% if proposals.any? %>
            <div class="mt-4 space-y-2">
              <% proposals.each do |proposal| %>
                <% safety = @aerodrome_proposal_safety_results&.fetch(proposal.id, nil) %>
                <% stale_reasons = proposal.stale_reasons(@position) %>
                <div class="rounded-lg border border-gray-800 bg-gray-950/50 p-3 text-sm">
                  <p class="text-white">Proposal #<%= proposal.id %> <span class="text-gray-500">(<%= proposal.status %>)</span></p>
                  <p class="mt-1 text-gray-400"><%= proposal.hedge_side %> <%= proposal.hedge_asset %> <%= format_venue_eth_amount(proposal.suggested_short_amount) %></p>
                  <div class="mt-3 grid grid-cols-1 gap-2 text-xs text-gray-400 sm:grid-cols-2">
                    <p>Manual proposal only</p>
                    <p>No orders / No Hyperliquid</p>
                    <p>Execution disabled</p>
                    <p>Not a live hedge</p>
                    <p>Local record only</p>
                    <p>Review does not place orders</p>
                    <p>Safety status: <span class="font-semibold text-white"><%= safety&.status || "unavailable" %></span></p>
                    <p>Freshness: <span class="font-semibold text-white"><%= proposal.freshness_label(@position) %></span></p>
                    <p>Execution: disabled / manual review only</p>
                    <p>Hyperliquid: not called</p>
                  </div>
                  <% if safety %>
                    <div class="mt-3 rounded-lg border border-gray-800 bg-gray-950 p-3">
                      <p class="text-xs font-semibold text-gray-300">Checked Limits</p>
                      <dl class="mt-2 space-y-1 text-xs">
                        <% safety.checked_limits.each_value do |limit| %>
                          <div class="flex justify-between gap-3"><dt class="text-gray-500"><%= limit[:env_key] %></dt><dd class="text-right text-gray-300"><%= limit[:status] %></dd></div>
                        <% end %>
                      </dl>
                      <% if safety.failures.present? %>
                        <ul class="mt-2 list-disc space-y-1 pl-5 text-xs text-red-200">
                          <% safety.failures.each do |failure| %><li><%= failure %></li><% end %>
                        </ul>
                        <p class="mt-2 text-xs text-red-200">Blocked proposals cannot be marked reviewed</p>
                      <% end %>
                      <% if safety.warnings.present? %>
                        <ul class="mt-2 list-disc space-y-1 pl-5 text-xs text-yellow-200">
                          <% safety.warnings.each do |warning| %><li><%= warning %></li><% end %>
                        </ul>
                      <% end %>
                    </div>
                  <% end %>
                  <p class="mt-2 text-xs text-gray-500">Stale reasons: <%= stale_reasons.any? ? stale_reasons.join(", ") : "None" %></p>
                  <div class="mt-3 flex gap-2">
                    <span class="rounded-lg border border-gray-700 px-2 py-1 text-xs text-gray-300">Mark Reviewed</span>
                    <span class="rounded-lg border border-gray-700 px-2 py-1 text-xs text-gray-300">Reject</span>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="mt-4 text-sm text-gray-500">No manual proposal history.</p>
          <% end %>
        </details>
      </div>
    </section>
  <% else %>
    <section class="grid grid-cols-1 gap-4 md:grid-cols-4">
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-4"><p class="text-xs uppercase tracking-wide text-gray-500"><%= @position.asset0 %></p><p class="mt-2 text-xl font-semibold text-white"><%= asset_value_display(@position.asset0_amount, @position.asset0_price_usd) %></p></div>
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-4"><p class="text-xs uppercase tracking-wide text-gray-500"><%= @position.asset1 %></p><p class="mt-2 text-xl font-semibold text-white"><%= asset_value_display(@position.asset1_amount, @position.asset1_price_usd) %></p></div>
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-4"><p class="text-xs uppercase tracking-wide text-gray-500">Total Pooled Value</p><p class="mt-2 text-xl font-semibold text-white"><%= valuation_value_display(position_valuation.current_value_usd) %></p></div>
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-4"><p class="text-xs uppercase tracking-wide text-gray-500">Hedge</p><p class="mt-2 text-xl font-semibold <%= @position.hedge ? 'text-white' : 'text-gray-500' %>"><%= @position.hedge ? "Configured" : "None" %></p></div>
    </section>
  <% end %>
</div>
