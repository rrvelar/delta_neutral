                      <% fees_report[:warnings].each do |warning| %><li><%= warning %></li><% end %>
                    </ul>
                  <% end %>
                </div>
              </div>
              <% end %>
            </details>
          </div>

      <div id="settings" class="space-y-4<%= tab_class.call('settings') %>">
