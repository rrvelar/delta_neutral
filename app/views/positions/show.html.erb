            <% end %>
            <% if hedge_accounting[:snapshot_refreshed_at].present? %>
              <%= " · " if rewards_report[:snapshot_refreshed_at].present? %>hedge accounting <%= hedge_accounting[:snapshot_stale] ? "stale" : "fresh" %> as of <%= l(hedge_accounting[:snapshot_refreshed_at], format: :short) %>
            <% end %>
