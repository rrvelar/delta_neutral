<div class="flex items-center justify-between mb-8">
  <div>
    <h1 class="text-3xl font-bold text-white inline-flex items-center gap-2">
      <%= @position.asset0 %>/<%= @position.asset1 %>
      <%= link_to position_path(@position), class: "text-gray-400 hover:text-white transition" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.992 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182M21.015 4.356v4.992" />
        </svg>
      <% end %>
    </h1>
    <p class="text-gray-400 mt-1 flex items-center gap-2">
      <%= dex_display_name(@position) %> &middot;
      <%= chain_display_name(@position) %> &middot;
      Token ID <%= @position.external_id %> &middot;
      <span id="copy-address" class="cursor-pointer hover:text-white transition inline-flex items-center gap-1" title="<%= @position.pool_address %>" onclick="navigator.clipboard.writeText('<%= @position.pool_address %>'); var icon=this.querySelector('.copy-icon'); icon.innerHTML='<path stroke-linecap=\'round\' stroke-linejoin=\'round\' d=\'M4.5 12.75l6 6 9-13.5\' />'; icon.classList.add('text-green-400'); setTimeout(function(){ icon.innerHTML='<path stroke-linecap=\'round\' stroke-linejoin=\'round\' d=\'M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75\' />'; icon.classList.remove('text-green-400'); }, 1500)">
        <%= @position.pool_address.to_s[0..5] %>&hellip;<%= @position.pool_address.to_s[-4..] %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 copy-icon">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
        </svg>
      </span>
    </p>
  </div>
  <div class="flex items-center space-x-3">
    <% if aerodrome_position?(@position) %>
      <div class="text-right">
        <%= button_to "Refresh Read-only Data", sync_now_position_path(@position), method: :post, title: "Updates on-chain LP data only. No orders, no Hyperliquid, no hedge execution.", class: "bg-gray-700 hover:bg-gray-600 text-gray-300 px-4 py-2 rounded-lg text-sm font-medium transition" %>
        <p class="text-gray-500 text-xs mt-2">Updates on-chain LP data only &middot; No orders &middot; No Hyperliquid &middot; No hedge execution</p>
      </div>
      <div class="text-right">
        <% proposal_button_path = @latest_aerodrome_hedge_proposal ? regenerate_position_aerodrome_hedge_proposals_path(@position) : position_aerodrome_hedge_proposals_path(@position) %>
        <% proposal_button_label = @latest_aerodrome_hedge_proposal ? "Regenerate Manual Hedge Proposal" : "Generate Manual Hedge Proposal" %>
        <%= button_to proposal_button_label, proposal_button_path, method: :post, title: "Manual proposal only. No orders. No Hyperliquid. Execution disabled. Not a live hedge.", class: "bg-yellow-900/60 hover:bg-yellow-900 text-yellow-100 border border-yellow-700 px-4 py-2 rounded-lg text-sm font-medium transition" %>
        <p class="text-gray-500 text-xs mt-2">Manual proposal only &middot; No orders &middot; No Hyperliquid &middot; Execution disabled &middot; Not a live hedge</p>
      </div>
      <span class="bg-yellow-900/40 text-yellow-300 border border-yellow-800 px-4 py-2 rounded-lg text-sm font-medium">Monitor-only</span>
    <% elsif @position.hedge %>
      <%= button_to "Sync Now", sync_now_position_path(@position), method: :post, class: "bg-gray-700 hover:bg-gray-600 text-gray-300 px-4 py-2 rounded-lg text-sm font-medium transition" %>
      <%= link_to "View Hedge", hedge_path(@position.hedge), class: "bg-gray-700 hover:bg-gray-600 text-gray-300 px-4 py-2 rounded-lg text-sm font-medium transition" %>
    <% else %>
      <%= button_to "Sync Now", sync_now_position_path(@position), method: :post, class: "bg-gray-700 hover:bg-gray-600 text-gray-300 px-4 py-2 rounded-lg text-sm font-medium transition" %>
      <%= link_to "Create Hedge", new_hedge_path(position_id: @position.id), class: "bg-gray-700 hover:bg-gray-600 text-gray-300 px-4 py-2 rounded-lg text-sm font-medium transition" %>
    <% end %>
  </div>
</div>

<% if aerodrome_position?(@position) %>
  <% hedge_preview = aerodrome_hedge_preview_for(@position) %>
  <div class="bg-yellow-950/30 border border-yellow-800 rounded-xl p-5 mb-8">
    <div class="flex flex-wrap gap-2 mb-4">
      <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-yellow-900/50 text-yellow-300 border border-yellow-700">MONITOR ONLY</span>
      <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-gray-800 text-gray-300 border border-gray-700">NO ORDERS</span>
      <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-gray-800 text-gray-300 border border-gray-700">HEDGE DISABLED</span>
      <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-gray-800 text-gray-300 border border-gray-700">HYPERLIQUID NOT CALLED</span>
      <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold bg-gray-800 text-gray-300 border border-gray-700">NOT LIVE HEDGE-READY</span>
    </div>
    <p class="text-yellow-100 font-medium">Aerodrome Slipstream monitor-only position on <%= chain_display_name(@position) %>.</p>
    <p class="text-yellow-200/80 text-sm mt-1">AERODROME_HEDGE_ENABLED must remain false. This page does not place trades, create orders, approve tokens, or call Hyperliquid.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-5">
      <div class="bg-gray-950/40 border border-gray-800 rounded-lg p-4">
        <p class="text-gray-400 text-xs uppercase tracking-wide">Position Details</p>
        <dl class="mt-3 space-y-2 text-sm">
          <div class="flex justify-between gap-4"><dt class="text-gray-500">DEX</dt><dd class="text-white"><%= dex_display_name(@position) %></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-gray-500">Chain</dt><dd class="text-white"><%= chain_display_name(@position) %></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-gray-500">Token ID</dt><dd class="text-white"><%= @position.external_id %></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-gray-500">Pool</dt><dd class="text-white text-right break-all"><%= @position.pool_address %></dd></div>
        </dl>
      </div>
      <div class="bg-gray-950/40 border border-gray-800 rounded-lg p-4">
        <p class="text-gray-400 text-xs uppercase tracking-wide">Hedge Preview</p>
        <% if hedge_preview&.supported %>
          <div class="mt-3 space-y-2 text-sm">
            <p class="text-yellow-300 font-medium">PREVIEW ONLY</p>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Suggested side</span><span class="text-white"><%= hedge_preview.hedge_side %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Suggested asset</span><span class="text-white"><%= hedge_preview.hedge_asset %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Suggested amount</span><span class="text-white"><%= number_with_precision(hedge_preview.suggested_short_amount, precision: 6) %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Suggested notional</span><span class="text-white"><%= format_usd(hedge_preview.suggested_short_notional_usd) %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Execution</span><span class="text-yellow-300">disabled</span></div>
          </div>
        <% else %>
          <p class="mt-3 text-gray-300 font-medium">Hedge preview unavailable</p>
          <p class="text-gray-500 text-sm mt-1"><%= hedge_preview&.reason || "preview data is unavailable" %></p>
        <% end %>
      </div>
      <div class="bg-gray-950/40 border border-gray-800 rounded-lg p-4 md:col-span-2">
        <p class="text-gray-400 text-xs uppercase tracking-wide">Latest Manual Hedge Proposal</p>
        <p class="text-yellow-200/80 text-xs mt-2">Manual proposal only &middot; No orders &middot; No Hyperliquid &middot; Execution disabled &middot; Not a live hedge</p>
        <% if @latest_aerodrome_hedge_proposal %>
          <% proposal = @latest_aerodrome_hedge_proposal %>
          <% stale_reasons = proposal.stale_reasons(@position) %>
          <% safety = @aerodrome_proposal_safety_results.fetch(proposal.id) %>
          <div class="mt-3 grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
            <div class="flex justify-between gap-4"><span class="text-gray-500">Proposal ID</span><span class="text-white"><%= proposal.id %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Status</span><span class="text-white"><%= proposal.status %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Safety status</span><span class="<%= safety.blocked ? 'text-red-300' : (safety.warnings.any? ? 'text-yellow-300' : 'text-green-300') %>"><%= safety.status %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Freshness</span><span class="<%= stale_reasons.any? ? 'text-red-300' : 'text-green-300' %>"><%= proposal.freshness_label(@position) %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Stale reason</span><span class="text-white text-right"><%= stale_reasons.any? ? stale_reasons.join(", ") : "None" %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Suggested action</span><span class="text-white"><%= proposal.hedge_side %> <%= proposal.hedge_asset %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Suggested amount</span><span class="text-white"><%= number_with_precision(proposal.suggested_short_amount, precision: 6) %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Suggested notional</span><span class="text-white"><%= format_usd(proposal.suggested_short_notional_usd) %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">WETH price</span><span class="text-white"><%= format_usd(proposal.weth_price_usd) %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">LP value</span><span class="text-white"><%= format_usd(proposal.lp_total_value_usd) %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Execution</span><span class="text-yellow-300"><%= proposal.execution_enabled? ? "enabled" : "disabled / manual review only" %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Hyperliquid</span><span class="text-yellow-300"><%= proposal.hyperliquid_called? ? "called" : "not called" %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Generated</span><span class="text-white"><%= proposal.generated_at.strftime("%m/%d/%Y %H:%M") %></span></div>
            <div class="flex justify-between gap-4"><span class="text-gray-500">Source</span><span class="text-white text-right"><%= proposal.source %></span></div>
          </div>
          <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
            <div class="<%= safety.blocked ? 'bg-red-950/30 border-red-800' : 'bg-gray-900/50 border-gray-800' %> border rounded-lg p-3">
              <p class="text-gray-400 text-xs uppercase tracking-wide">Checked Limits</p>
              <dl class="mt-2 space-y-1">
                <% safety.checked_limits.each do |key, limit| %>
                  <div class="flex justify-between gap-4">
                    <dt class="text-gray-500"><%= key.to_s.humanize %></dt>
                    <dd class="text-white text-right">
                      actual <%= limit[:actual]&.to_s("F") || "unavailable" %> /
                      limit <%= limit[:configured] ? (limit[:limit]&.to_s("F") || "invalid") : "not configured" %>
                      (<%= limit[:status] %>)
                    </dd>
                  </div>
                <% end %>
              </dl>
            </div>
            <div class="<%= safety.blocked ? 'bg-red-950/30 border-red-800' : 'bg-gray-900/50 border-gray-800' %> border rounded-lg p-3">
              <p class="text-gray-400 text-xs uppercase tracking-wide">Failures / Warnings</p>
              <% if safety.failures.any? %>
                <ul class="mt-2 list-disc list-inside text-red-200 space-y-1">
                  <% safety.failures.each do |failure| %>
                    <li><%= failure %></li>
                  <% end %>
                </ul>
              <% end %>
              <% if safety.warnings.any? %>
                <ul class="mt-2 list-disc list-inside text-yellow-200 space-y-1">
                  <% safety.warnings.each do |warning| %>
                    <li><%= warning %></li>
                  <% end %>
                </ul>
              <% end %>
              <% if safety.failures.empty? && safety.warnings.empty? %>
                <p class="mt-2 text-green-300">All configured proposal safety limits passed.</p>
              <% end %>
            </div>
          </div>
          <p class="text-yellow-200/80 text-sm mt-4">Local record only. Review does not place orders, call Hyperliquid, or create a live hedge.</p>
          <div class="flex flex-wrap gap-3 mt-4">
            <% if proposal.status == "draft" %>
              <% if safety.blocked %>
                <span class="inline-flex items-center px-3 py-2 rounded-lg text-sm font-medium bg-red-950/70 text-red-200 border border-red-800">Blocked proposals cannot be marked reviewed</span>
              <% else %>
                <%= button_to "Mark Reviewed", mark_reviewed_aerodrome_hedge_proposal_path(proposal), method: :post, class: "bg-gray-700 hover:bg-gray-600 text-gray-200 px-3 py-2 rounded-lg text-sm font-medium transition" %>
              <% end %>
              <%= button_to "Reject", reject_aerodrome_hedge_proposal_path(proposal), method: :post, class: "bg-red-950/70 hover:bg-red-950 text-red-200 border border-red-800 px-3 py-2 rounded-lg text-sm font-medium transition" %>
            <% end %>
          </div>
        <% else %>
          <p class="mt-3 text-gray-300 font-medium">No manual hedge proposal generated.</p>
          <p class="text-gray-500 text-sm mt-1">Generate a local proposal for manual review only. Execution remains disabled.</p>
        <% end %>
      </div>
      <div class="bg-gray-950/40 border border-gray-800 rounded-lg p-4 md:col-span-2 overflow-x-auto">
        <p class="text-gray-400 text-xs uppercase tracking-wide">Manual Proposal History</p>
        <p class="text-yellow-200/80 text-xs mt-2">Manual proposal only &middot; No orders &middot; No Hyperliquid &middot; Execution disabled &middot; Not a live hedge</p>
        <% if @aerodrome_hedge_proposals.present? %>
          <table class="w-full mt-4 text-sm">
            <thead>
              <tr class="border-b border-gray-800">
                <th class="text-left text-gray-500 font-medium py-2 pr-3">ID</th>
                <th class="text-left text-gray-500 font-medium py-2 pr-3">Status</th>
                <th class="text-left text-gray-500 font-medium py-2 pr-3">Safety</th>
                <th class="text-left text-gray-500 font-medium py-2 pr-3">Failures / Warnings</th>
                <th class="text-left text-gray-500 font-medium py-2 pr-3">Asset</th>
                <th class="text-left text-gray-500 font-medium py-2 pr-3">Side</th>
                <th class="text-right text-gray-500 font-medium py-2 pr-3">Amount</th>
                <th class="text-right text-gray-500 font-medium py-2 pr-3">Notional</th>
                <th class="text-left text-gray-500 font-medium py-2 pr-3">Generated</th>
                <th class="text-left text-gray-500 font-medium py-2 pr-3">Reviewed</th>
                <th class="text-left text-gray-500 font-medium py-2 pr-3">Execution</th>
                <th class="text-left text-gray-500 font-medium py-2">Hyperliquid</th>
              </tr>
            </thead>
            <tbody>
              <% @aerodrome_hedge_proposals.each do |proposal| %>
                <% stale_reasons = proposal.stale_reasons(@position) %>
                <% safety = @aerodrome_proposal_safety_results.fetch(proposal.id) %>
                <tr class="border-b border-gray-900 <%= safety.blocked ? 'bg-red-950/20' : '' %>">
                  <td class="py-2 pr-3 text-white"><%= proposal.id %></td>
                  <td class="py-2 pr-3 text-white"><%= proposal.status %></td>
                  <td class="py-2 pr-3 <%= safety.blocked ? 'text-red-300' : (safety.warnings.any? ? 'text-yellow-300' : 'text-green-300') %>"><%= safety.status %></td>
                  <td class="py-2 pr-3 text-gray-300"><%= (safety.failures + safety.warnings).presence&.join(", ") || "None" %></td>
                  <td class="py-2 pr-3 text-white"><%= proposal.hedge_asset %></td>
                  <td class="py-2 pr-3 text-white"><%= proposal.hedge_side %></td>
                  <td class="py-2 pr-3 text-right text-white"><%= number_with_precision(proposal.suggested_short_amount, precision: 6) %></td>
                  <td class="py-2 pr-3 text-right text-white"><%= format_usd(proposal.suggested_short_notional_usd) %></td>
                  <td class="py-2 pr-3 text-gray-300"><%= proposal.generated_at.strftime("%m/%d/%Y %H:%M") %></td>
                  <td class="py-2 pr-3 text-gray-300"><%= proposal.reviewed_at ? proposal.reviewed_at.strftime("%m/%d/%Y %H:%M") : "-" %></td>
                  <td class="py-2 pr-3 text-yellow-300"><%= proposal.execution_enabled? ? "enabled" : "disabled" %></td>
                  <td class="py-2 text-yellow-300"><%= proposal.hyperliquid_called? ? "called" : "not called" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="mt-3 text-gray-500 text-sm">No manual proposal history.</p>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<% pool_unrealized = @position.entry_value_usd ? @position.total_value_usd - @position.entry_value_usd : nil %>
<% latest_snap = @pnl_snapshots.first %>
<% hedge_unrealized = (latest_snap&.hedge_unrealized || 0).to_d %>
<% hedge_realized = (latest_snap&.hedge_realized || 0).to_d %>
<% total_unrealized = pool_unrealized ? pool_unrealized + hedge_unrealized : hedge_unrealized %>
<% total_fees = latest_snap&.total_fees_usd || 0 %>
<% total_pnl = total_unrealized + hedge_realized + total_fees %>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-4 space-y-2">
    <p class="text-gray-400 text-xs uppercase tracking-wide"><%= @position.asset0 %></p>
    <p class="text-xl font-bold text-white"><%= asset_value_display(@position.asset0_amount, @position.asset0_price_usd) %></p>
    <p class="text-gray-500 text-sm"><%= amount_display(@position.asset0_amount, precision: 6) %> &middot; <%= price_display(@position.asset0_price_usd) %></p>
  </div>
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-4 space-y-2">
    <p class="text-gray-400 text-xs uppercase tracking-wide"><%= @position.asset1 %></p>
    <p class="text-xl font-bold text-white"><%= asset_value_display(@position.asset1_amount, @position.asset1_price_usd) %></p>
    <p class="text-gray-500 text-sm"><%= amount_display(@position.asset1_amount, precision: 2) %> &middot; <%= price_display(@position.asset1_price_usd) %></p>
  </div>
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-4 space-y-2">
    <p class="text-gray-400 text-xs uppercase tracking-wide">Total Pooled Value</p>
    <p class="text-xl font-bold text-white"><%= format_usd(@position.total_value_usd) %></p>
    <% if @position.entry_value_usd %>
      <p class="text-gray-500 text-sm">Entry: <%= format_usd(@position.entry_value_usd) %></p>
    <% else %>
      <p class="text-gray-500 text-sm"><%= asset_value_display(@position.asset0_amount, @position.asset0_price_usd) %> &middot; <%= asset_value_display(@position.asset1_amount, @position.asset1_price_usd) %></p>
    <% end %>
  </div>
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-4 space-y-2">
    <p class="text-gray-400 text-xs uppercase tracking-wide">Hedge</p>
    <% if @position.hedge %>
      <% hedge_value = @position.total_value_usd * @position.hedge.target %>
      <p class="text-xl font-bold <%= @position.hedge.active? ? 'text-white' : 'text-gray-500' %>">
        <%= format_usd(hedge_value) %>
      </p>
      <p class="text-gray-500 text-sm">Target: <%= number_to_percentage(@position.hedge.target * 100, precision: 0) %> &middot; Tolerance: <%= number_to_percentage(@position.hedge.tolerance * 100, precision: 0) %></p>
    <% else %>
      <p class="text-xl font-bold text-gray-500">None</p>
    <% end %>
  </div>
</div>

<h2 class="text-xl font-semibold text-white mb-4">PnL Summary</h2>
<div class="grid grid-cols-3 gap-4 mb-6">
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-5">
    <p class="text-gray-400 text-xs uppercase tracking-wide">Total PnL</p>
    <p class="text-2xl font-bold mt-2 <%= total_pnl >= 0 ? 'text-green-400' : 'text-red-400' %>">
      <%= format_usd(total_pnl) %>
    </p>
    <p class="text-gray-500 text-sm mt-1">
      Unrealized: <span class="<%= total_unrealized >= 0 ? 'text-green-400' : 'text-red-400' %>"><%= format_usd(total_unrealized) %></span>
      &middot; Realized: <span class="<%= hedge_realized >= 0 ? 'text-green-400' : 'text-red-400' %>"><%= format_usd(hedge_realized) %></span>
      &middot; Fees: <span class="text-green-400"><%= format_usd(total_fees) %></span>
    </p>
  </div>
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-5">
    <p class="text-gray-400 text-xs uppercase tracking-wide">Total Unrealized</p>
    <p class="text-2xl font-bold mt-2 <%= total_unrealized >= 0 ? 'text-green-400' : 'text-red-400' %>">
      <%= format_usd(total_unrealized) %>
    </p>
    <p class="text-gray-500 text-sm mt-1">
      Pool: <span class="<%= (pool_unrealized || 0) >= 0 ? 'text-green-400' : 'text-red-400' %>"><%= format_usd(pool_unrealized || 0) %></span>
      &middot; Hedge: <span class="<%= hedge_unrealized >= 0 ? 'text-green-400' : 'text-red-400' %>"><%= format_usd(hedge_unrealized) %></span>
    </p>
  </div>
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-5">
    <p class="text-gray-400 text-xs uppercase tracking-wide">Realized PnL</p>
    <p class="text-2xl font-bold mt-2 <%= hedge_realized >= 0 ? 'text-green-400' : 'text-red-400' %>">
      <%= format_usd(hedge_realized) %>
    </p>
  </div>
</div>
<% if latest_snap %>
  <p class="text-gray-600 text-xs mb-8">As of <%= latest_snap.captured_at.strftime("%m/%d/%Y %H:%M") %></p>
<% end %>

<h2 class="text-xl font-semibold text-white mb-4">LP Fees</h2>
<div class="grid grid-cols-3 gap-4">
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-5">
    <p class="text-gray-400 text-xs uppercase tracking-wide">Collected</p>
    <p class="text-2xl font-bold mt-2 text-green-400">
      <%= format_usd(latest_snap&.collected_fees_usd || 0) %>
    </p>
  </div>
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-5">
    <p class="text-gray-400 text-xs uppercase tracking-wide">Uncollected</p>
    <p class="text-2xl font-bold mt-2 text-green-400">
      <%= format_usd(latest_snap&.uncollected_fees_usd || 0) %>
    </p>
  </div>
  <div class="bg-gray-900 rounded-xl border border-gray-800 p-5">
    <p class="text-gray-400 text-xs uppercase tracking-wide">Total Fees</p>
    <p class="text-2xl font-bold mt-2 text-green-400">
      <%= format_usd(latest_snap&.total_fees_usd || 0) %>
    </p>
  </div>
</div>
