<% setup ||= {} %>
<% next_route = setup[:next_route] || {} %>
<% plan = setup[:plan] || {} %>
<% counters = setup[:counters] || {} %>
<% setup_progress = setup[:setup_progress] || {} %>
<% random_enablement = setup[:random_enablement] || {} %>
<% reconciliation = setup[:reconciliation] || {} %>
<% missing_proof_route = setup[:next_missing_proof_route] || {} %>
<% reposition_route = setup[:source_reposition_route] || {} %>
<% auto_policy = setup[:auto_policy] || {} %>
<% current_auto_venue = auto_policy[:auto_that_will_be_enabled_with_random] || setup[:current_venue] || position.hedge&.execution_venue %>
<% current_auto_key = OperationalSettings.auto_key_for(current_auto_venue) %>
<% current_auto_enabled = auto_policy[:current_active_auto_venue].to_s == HedgeVenues.normalize(current_auto_venue) %>
<% nado_route = [ next_route[:from_venue], next_route[:to_venue] ].include?("nado") %>
<% status_color = case setup[:status].to_s
                  when RandomRotationSetupWizard::STATES[:random_enabled], RandomRotationSetupWizard::STATES[:ready_for_random] then "border-green-800 bg-green-950/40 text-green-200"
                  when RandomRotationSetupWizard::STATES[:dry_run_proven], RandomRotationSetupWizard::STATES[:source_reposition_required], RandomRotationSetupWizard::STATES[:target_only], RandomRotationSetupWizard::STATES[:full_route], "in_progress" then "border-yellow-800 bg-yellow-950/30 text-yellow-100"
                  else "border-gray-800 bg-gray-950/70 text-gray-200"
                  end %>

<div id="random-rotation-setup" class="mt-4 rounded-xl border border-gray-800 bg-gray-950/70 p-4">
  <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
    <div>
      <p class="text-xs uppercase tracking-wide text-gray-500">Random Rotation Setup</p>
      <h3 class="mt-1 text-lg font-semibold text-white">Dashboard setup wizard</h3>
      <p class="mt-1 text-sm text-gray-300">
        Status: <span class="font-medium text-white"><%= setup[:status_label] || "Unavailable" %></span>
        · Current venue: <span class="font-medium text-white"><%= setup[:current_venue_label] || HedgeVenues.label(position.hedge&.execution_venue) %></span>
      </p>
      <p class="mt-1 text-sm text-gray-400">
        Next required step:
        <span class="text-white"><%= setup[:next_action_label] || "Refresh Random Readiness" %><%= next_route[:from_venue].present? ? " #{HedgeVenues.label(next_route[:from_venue])} -> #{HedgeVenues.label(next_route[:to_venue])}" : "" %></span>
      </p>
      <% if setup_progress[:from_venue].present? %>
        <p class="mt-1 text-sm text-gray-400">
          Route setup progress:
          <span class="text-white"><%= HedgeVenues.label(setup_progress[:from_venue]) %> -> <%= HedgeVenues.label(setup_progress[:to_venue]) %>: <%= setup_progress[:status_label] %></span>
        </p>
      <% end %>
      <p class="mt-1 text-sm text-gray-400">
        Random rotation:
        <span class="text-white"><%= random_enablement[:ready_routes] || 0 %> / <%= random_enablement[:total_routes] || Array(setup[:route_proof_statuses]).size %> routes READY_FOR_RANDOM</span>
      </p>
    </div>
    <span class="rounded-full border px-3 py-1 text-xs <%= status_color %>"><%= setup[:status_label] || "Unavailable" %></span>
  </div>

  <% if setup[:source_reposition_required] %>
    <div class="mt-4 rounded-lg border border-yellow-900 bg-yellow-950/20 p-3">
      <p class="text-xs uppercase tracking-wide text-yellow-200">Next required setup move</p>
      <p class="mt-1 text-sm text-yellow-100">
        <%= HedgeVenues.label(missing_proof_route[:from_venue]) %> -> <%= HedgeVenues.label(missing_proof_route[:to_venue]) %> is <%= missing_proof_route[:status].to_s.downcase.tr("_", " ") %>, but cannot be prepared/run until <%= HedgeVenues.label(missing_proof_route[:from_venue]) %> is current source.
      </p>
      <% if reposition_route.present? %>
        <p class="mt-2 text-sm text-white">Next: move production hedge <%= HedgeVenues.label(reposition_route[:from_venue]) %> -> <%= HedgeVenues.label(reposition_route[:to_venue]) %> using the already READY_FOR_RANDOM route.</p>
      <% else %>
        <p class="mt-2 text-sm text-yellow-100"><%= setup[:source_reposition_reason] %></p>
      <% end %>
    </div>
  <% end %>

  <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4">
    <div class="rounded-lg border border-gray-800 bg-gray-950 p-3">
      <p class="text-xs text-gray-500">Hedge health</p>
      <p class="mt-1 text-white"><%= setup.dig(:hedge_health, :status) || "Unknown" %></p>
      <p class="mt-1 text-xs text-gray-500">Target <%= format_venue_eth_amount(setup.dig(:hedge_health, :target_short_eth)) %> ETH · drift <%= format_venue_eth_amount(setup.dig(:hedge_health, :drift_eth)) %> ETH · tolerance <%= format_venue_eth_amount(setup.dig(:hedge_health, :tolerance_abs_eth)) %> ETH</p>
    </div>
    <div class="rounded-lg border border-gray-800 bg-gray-950 p-3">
      <p class="text-xs text-gray-500">Venue shorts</p>
      <p class="mt-1 text-xs text-gray-300">Extended <%= format_venue_eth_amount(setup.dig(:venue_shorts, "extended") || setup.dig(:venue_shorts, :extended)) %> · Ethereal <%= format_venue_eth_amount(setup.dig(:venue_shorts, "ethereal") || setup.dig(:venue_shorts, :ethereal)) %> · Nado <%= format_venue_eth_amount(setup.dig(:venue_shorts, "nado") || setup.dig(:venue_shorts, :nado)) %> ETH</p>
    </div>
    <div class="rounded-lg border border-gray-800 bg-gray-950 p-3">
      <p class="text-xs text-gray-500">Random enablement</p>
      <p class="mt-1 text-white"><%= random_enablement[:ready_routes] || Array(setup[:completed_route_proofs]).size %> / <%= random_enablement[:total_routes] || Array(setup[:route_proof_statuses]).size %> READY_FOR_RANDOM</p>
      <p class="mt-1 text-xs text-gray-500">Final random rotation stays blocked until every route is ready.</p>
    </div>
    <div class="rounded-lg border border-gray-800 bg-gray-950 p-3">
      <p class="text-xs text-gray-500">Action counters</p>
      <p class="mt-1 text-white"><%= counters[:orders_submitted] || 0 %> orders · <%= counters[:signatures_created] || 0 %> signatures · <%= counters[:cancels_submitted] || 0 %> cancels</p>
      <p class="mt-1 text-xs text-gray-500">Dry-run setup actions must stay zero.</p>
    </div>
  </div>

  <div class="mt-4 rounded-lg border border-gray-800 bg-gray-950 p-3">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <p class="text-xs uppercase tracking-wide text-gray-500">Auto-rebalance policy</p>
        <p class="mt-1 text-sm text-gray-300">When random rotation is enabled, the app keeps auto-rebalance enabled only on the active production venue. During migrations, auto-rebalance is paused or blocked. After each successful migration, auto-rebalance moves to the new venue.</p>
      </div>
      <% if current_auto_key && setup[:next_action] != "enable_random" && setup[:next_action] != "disable_random" %>
        <%= form_with url: auto_rebalance_position_path(position), method: :post, class: "min-w-64 space-y-2" do |form| %>
          <%= form.hidden_field :tab, value: "migration" %>
          <%= form.hidden_field :venue, value: current_auto_venue %>
          <%= form.hidden_field :enabled, value: "true" %>
          <%= form.hidden_field :auto_confirmation, value: OperationalSettings.enable_confirmation_for(current_auto_venue) %>
          <%= form.submit "Enable auto for current venue only", class: "w-full rounded-lg bg-gray-100 px-3 py-2 text-xs font-semibold text-gray-950 hover:bg-white" %>
        <% end %>
      <% end %>
    </div>
    <div class="mt-3 grid grid-cols-1 gap-2 text-xs md:grid-cols-4">
      <div><span class="text-gray-500">Current production venue</span><p class="text-white"><%= auto_policy[:current_production_venue_name] || HedgeVenues.label(current_auto_venue) %></p></div>
      <div><span class="text-gray-500">Current active auto</span><p class="<%= current_auto_enabled ? 'text-green-300' : 'text-gray-300' %>"><%= current_auto_enabled ? "On" : "Off" %></p></div>
      <div><span class="text-gray-500">Auto enabled with random</span><p class="text-white"><%= auto_policy[:auto_that_will_be_enabled_with_random_name] || HedgeVenues.label(current_auto_venue) %></p></div>
      <div><span class="text-gray-500">Other venue autos</span><p class="text-gray-300">Off</p></div>
    </div>
    <% if setup[:stale_pending_continuation_ignored] %>
      <p class="mt-3 text-xs text-green-300">A stale Nado target continuation was ignored because the route is already READY_FOR_RANDOM and current readback is safe.</p>
    <% end %>
  </div>

  <% if next_route[:from_venue].present? %>
    <% if reconciliation.present? %>
      <div class="mt-4 rounded-lg border border-green-900 bg-green-950/20 p-3">
        <p class="text-xs uppercase tracking-wide text-green-300">Migration readback result</p>
        <div class="mt-2 grid grid-cols-1 gap-2 text-xs md:grid-cols-3">
          <div><span class="text-gray-500">Route</span><p class="text-white"><%= HedgeVenues.label(reconciliation[:from_venue]) %> -> <%= HedgeVenues.label(reconciliation[:to_venue]) %></p></div>
          <div><span class="text-gray-500">Target leg</span><p class="text-green-200"><%= reconciliation[:target_holds_expected_short] ? "confirmed" : "pending" %></p></div>
          <div><span class="text-gray-500">Source leg</span><p class="text-green-200"><%= reconciliation[:source_flat_after] ? "confirmed flat" : "pending" %></p></div>
          <div><span class="text-gray-500">Combined hedge</span><p class="text-green-200"><%= reconciliation[:final_inside_tolerance] ? "inside tolerance" : "outside tolerance" %></p></div>
          <div><span class="text-gray-500">Route status</span><p class="text-white"><%= reconciliation[:final_status] %></p></div>
          <div><span class="text-gray-500">Safety counters</span><p class="text-white"><%= reconciliation[:orders_submitted].to_i %> / <%= reconciliation[:signatures_created].to_i %></p></div>
        </div>
      </div>
    <% end %>
    <div class="mt-4 rounded-lg border border-gray-800 bg-gray-950 p-3">
      <div class="grid grid-cols-1 gap-3 text-xs md:grid-cols-3">
        <div><span class="text-gray-500">Route</span><p class="text-white"><%= HedgeVenues.label(next_route[:from_venue]) %> -> <%= HedgeVenues.label(next_route[:to_venue]) %></p></div>
        <div><span class="text-gray-500">Route status</span><p class="text-white"><%= setup_progress[:status] || next_route[:status] %></p><p class="text-gray-500"><%= setup_progress[:status_label] %></p></div>
        <div><span class="text-gray-500">Sequence</span><p class="text-white"><%= (plan[:sequence] || "target_first").to_s.tr("_", " ") %></p></div>
        <div><span class="text-gray-500">Live order possible?</span><p class="<%= setup[:next_action_live] ? 'text-yellow-200' : 'text-green-300' %>"><%= setup[:next_action_live] ? "Yes, only with exact phrase#{nado_route ? ' and Nado live gates' : ''}" : "No" %></p></div>
        <div><span class="text-gray-500">Target venue open first</span><p class="text-white"><%= HedgeVenues.label(next_route[:to_venue]) %> <%= plan.dig(:target_leg, :side).presence || "open" %> <%= format_venue_eth_amount(plan.dig(:target_leg, :size_eth)) %> ETH</p></div>
        <div><span class="text-gray-500">Source venue close second</span><p class="text-white"><%= HedgeVenues.label(next_route[:from_venue]) %> <%= plan.dig(:source_leg, :side).presence || "close" %> <%= format_venue_eth_amount(plan.dig(:source_leg, :size_eth)) %> ETH</p></div>
        <div><span class="text-gray-500">Temporary risk</span><p class="text-white"><%= plan[:temporary_risk_type].presence || "target-first temporary overhedge" %></p></div>
        <div><span class="text-gray-500">Projected final combined</span><p class="text-white"><%= format_venue_eth_amount(plan[:expected_final_combined]) %> ETH</p></div>
        <div><span class="text-gray-500">Projected final venue</span><p class="text-white"><%= HedgeVenues.label(plan[:expected_final_venue] || next_route[:to_venue]) %></p></div>
        <div><span class="text-gray-500">Readback required</span><p class="text-white">Target confirmed, source flat, combined inside tolerance, open orders zero.</p></div>
      </div>
      <% if plan[:blockers].present? && reconciliation.blank? %>
        <p class="mt-3 break-words text-xs text-yellow-200">Plan blocker: <%= Array(plan[:blockers]).first %></p>
      <% end %>
    </div>
  <% end %>

  <div class="mt-4 grid grid-cols-1 gap-3 lg:grid-cols-3">
    <div class="rounded-lg border border-gray-800 bg-gray-950 p-3">
      <p class="text-xs uppercase tracking-wide text-gray-500">Next safe action</p>
      <p class="mt-1 text-sm text-gray-300"><%= setup[:next_action_label] || "Refresh Random Readiness" %></p>
      <% case setup[:next_action] %>
      <% when "prepare_next_route" %>
        <%= button_to "Prepare Next Route", random_rotation_prepare_next_route_position_path(position), method: :post, params: { tab: "migration", from_venue: next_route[:from_venue], to_venue: next_route[:to_venue], migration_sequence: "target_first" }, class: "mt-3 w-full rounded-lg bg-gray-100 px-3 py-2 text-xs font-semibold text-gray-950 hover:bg-white" %>
        <p class="mt-2 text-xs text-gray-500">Runs route proof and rehearsal only. No live orders, signatures, or cancels.</p>
      <% when "rebalance_current_hedge" %>
        <p class="mt-3 rounded-lg border border-yellow-900 bg-yellow-950/20 p-3 text-xs text-yellow-100">Random live setup is blocked until the current production hedge is back inside tolerance. Rebalance the current <%= setup[:current_venue_label] || HedgeVenues.label(position.hedge&.execution_venue) %> hedge, then refresh this panel.</p>
      <% when "run_live_canary" %>
        <%= form_with url: random_rotation_live_canary_position_path(position), method: :post, class: "mt-3 space-y-2" do |form| %>
          <%= form.hidden_field :tab, value: "migration" %>
          <%= form.hidden_field :from_venue, value: next_route[:from_venue] %>
          <%= form.hidden_field :to_venue, value: next_route[:to_venue] %>
          <%= form.hidden_field :migration_sequence, value: "target_first" %>
          <code class="block break-all rounded border border-gray-800 bg-gray-950 p-2 text-[11px] text-gray-300"><%= setup[:required_confirmation_phrase] %></code>
          <% submit_id = "random-rotation-live-canary-submit" %>
          <%= form.text_field :random_rotation_confirmation,
            autocomplete: "off",
            placeholder: setup[:required_confirmation_phrase],
            data: { required_confirmation: setup[:required_confirmation_phrase], live_submit_id: submit_id },
            oninput: "document.getElementById(this.dataset.liveSubmitId).disabled = this.value !== this.dataset.requiredConfirmation",
            class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-2 py-2 text-xs text-white placeholder-gray-600" %>
          <%= form.submit "Run Supervised Live Canary", id: submit_id, disabled: true, onclick: "this.disabled = true; this.form.requestSubmit();", class: "w-full rounded-lg border border-red-800 bg-red-950/70 px-3 py-2 text-xs font-semibold text-red-100 hover:bg-red-900 disabled:border-gray-800 disabled:bg-gray-900 disabled:text-gray-600" %>
          <p class="text-xs text-yellow-200">This opens the target leg first and can temporarily overhedge until the source close readback confirms.</p>
          <% if nado_route %>
            <p class="text-xs text-gray-400">Nado supervised canary gates can be enabled from this dashboard after the exact phrase is entered.</p>
          <% end %>
        <% end %>
      <% when "move_to_required_source_venue" %>
        <%= form_with url: random_rotation_move_to_source_position_path(position), method: :post, class: "mt-3 space-y-2" do |form| %>
          <%= form.hidden_field :tab, value: "migration" %>
          <%= form.hidden_field :from_venue, value: next_route[:from_venue] %>
          <%= form.hidden_field :to_venue, value: next_route[:to_venue] %>
          <%= form.hidden_field :migration_sequence, value: "target_first" %>
          <code class="block break-all rounded border border-gray-800 bg-gray-950 p-2 text-[11px] text-gray-300"><%= setup[:required_confirmation_phrase] %></code>
          <% submit_id = "random-rotation-source-move-submit" %>
          <%= form.text_field :random_rotation_confirmation,
            autocomplete: "off",
            placeholder: setup[:required_confirmation_phrase],
            data: { required_confirmation: setup[:required_confirmation_phrase], live_submit_id: submit_id },
            oninput: "document.getElementById(this.dataset.liveSubmitId).disabled = this.value !== this.dataset.requiredConfirmation",
            class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-2 py-2 text-xs text-white placeholder-gray-600" %>
          <%= form.submit "Move to required source venue", id: submit_id, disabled: true, onclick: "this.disabled = true; this.form.requestSubmit();", class: "w-full rounded-lg border border-red-800 bg-red-950/70 px-3 py-2 text-xs font-semibold text-red-100 hover:bg-red-900 disabled:border-gray-800 disabled:bg-gray-900 disabled:text-gray-600" %>
          <p class="text-xs text-yellow-200">This moves <%= HedgeVenues.label(next_route[:from_venue]) %> -> <%= HedgeVenues.label(next_route[:to_venue]) %> first. It does not prepare a duplicate dry-run proof.</p>
        <% end %>
      <% when "source_reposition_unavailable" %>
        <p class="mt-3 rounded-lg border border-yellow-900 bg-yellow-950/20 p-3 text-xs text-yellow-100"><%= setup[:source_reposition_reason] %></p>
      <% when "continue_source_close" %>
        <%= form_with url: random_rotation_continue_position_path(position), method: :post, class: "mt-3 space-y-2" do |form| %>
          <%= form.hidden_field :tab, value: "migration" %>
          <%= form.hidden_field :from_venue, value: next_route[:from_venue] %>
          <%= form.hidden_field :to_venue, value: next_route[:to_venue] %>
          <code class="block break-all rounded border border-gray-800 bg-gray-950 p-2 text-[11px] text-gray-300"><%= setup[:required_confirmation_phrase] %></code>
          <%= form.text_field :random_rotation_confirmation, autocomplete: "off", placeholder: setup[:required_confirmation_phrase], class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-2 py-2 text-xs text-white placeholder-gray-600" %>
          <%= form.submit "Close source venue and continue migration", class: "w-full rounded-lg border border-red-800 bg-red-950/70 px-3 py-2 text-xs font-semibold text-red-100 hover:bg-red-900" %>
        <% end %>
      <% when "finalize_migration" %>
        <%= form_with url: random_rotation_finalize_position_path(position), method: :post, class: "mt-3 space-y-2" do |form| %>
          <%= form.hidden_field :tab, value: "migration" %>
          <%= form.hidden_field :from_venue, value: next_route[:from_venue] %>
          <%= form.hidden_field :to_venue, value: next_route[:to_venue] %>
          <code class="block break-all rounded border border-gray-800 bg-gray-950 p-2 text-[11px] text-gray-300"><%= setup[:required_confirmation_phrase] %></code>
          <%= form.text_field :random_rotation_confirmation, autocomplete: "off", placeholder: setup[:required_confirmation_phrase], class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-2 py-2 text-xs text-white placeholder-gray-600" %>
          <%= form.submit "Finalize migration to #{HedgeVenues.label(next_route[:to_venue])}", class: "w-full rounded-lg bg-yellow-800 px-3 py-2 text-xs font-semibold text-yellow-50 hover:bg-yellow-700" %>
          <p class="text-xs text-gray-400">Migration completed by readback. Finalization only switches the app production venue and submits no orders.</p>
        <% end %>
      <% when "enable_random" %>
        <%= form_with url: random_rotation_enable_position_path(position), method: :post, class: "mt-3 space-y-2" do |form| %>
          <%= form.hidden_field :tab, value: "migration" %>
          <code class="block break-all rounded border border-gray-800 bg-gray-950 p-2 text-[11px] text-gray-300"><%= setup[:required_confirmation_phrase] %></code>
          <%= form.text_field :random_rotation_confirmation, autocomplete: "off", placeholder: setup[:required_confirmation_phrase], class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-2 py-2 text-xs text-white placeholder-gray-600" %>
          <%= form.submit "Enable Random Rotation", class: "w-full rounded-lg bg-green-800 px-3 py-2 text-xs font-semibold text-green-50 hover:bg-green-700" %>
        <% end %>
      <% when "disable_random" %>
        <%= form_with url: random_rotation_disable_position_path(position), method: :post, class: "mt-3 space-y-2" do |form| %>
          <%= form.hidden_field :tab, value: "migration" %>
          <code class="block break-all rounded border border-gray-800 bg-gray-950 p-2 text-[11px] text-gray-300"><%= setup[:required_confirmation_phrase] %></code>
          <%= form.text_field :random_rotation_confirmation, autocomplete: "off", placeholder: setup[:required_confirmation_phrase], class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-2 py-2 text-xs text-white placeholder-gray-600" %>
          <%= form.submit "Disable Random Rotation", class: "w-full rounded-lg bg-gray-800 px-3 py-2 text-xs font-semibold text-gray-100 hover:bg-gray-700" %>
        <% end %>
      <% end %>
    </div>

    <div class="rounded-lg border border-gray-800 bg-gray-950 p-3">
      <p class="text-xs uppercase tracking-wide text-gray-500">Operational gates</p>
      <div class="mt-2 space-y-1 text-xs">
        <% (setup[:migration_gates] || {}).each do |key, gate| %>
          <p class="flex justify-between gap-2"><span class="text-gray-400"><%= key %></span><span class="<%= gate[:enabled] ? 'text-green-300' : 'text-gray-500' %>"><%= gate[:enabled] ? "on" : "off" %></span></p>
        <% end %>
      </div>
    </div>

    <div class="rounded-lg border border-gray-800 bg-gray-950 p-3">
      <p class="text-xs uppercase tracking-wide text-gray-500">Current setup blockers</p>
      <% setup_blockers = reconciliation.present? ? [] : Array(plan[:blockers]).presence || Array(setup[:blockers]).reject { |blocker| blocker.to_s.in?(Array(random_enablement[:blockers])) } %>
      <% if setup_blockers.present? %>
        <ul class="mt-2 list-disc space-y-1 pl-4 text-xs text-yellow-200">
          <% setup_blockers.first(4).each do |blocker| %><li><%= blocker %></li><% end %>
        </ul>
      <% else %>
        <p class="mt-2 text-xs text-green-300">No setup blockers for the current step.</p>
      <% end %>
      <p class="mt-4 text-xs uppercase tracking-wide text-gray-500">Random enablement blockers</p>
      <% if Array(random_enablement[:blockers]).present? %>
        <ul class="mt-2 list-disc space-y-1 pl-4 text-xs text-gray-400">
          <% Array(random_enablement[:blockers]).first(4).each do |blocker| %><li><%= blocker %></li><% end %>
        </ul>
      <% else %>
        <p class="mt-2 text-xs text-green-300">All routes are READY_FOR_RANDOM.</p>
      <% end %>
      <%= button_to "Refresh route proof registry", random_rotation_refresh_position_path(position), method: :post, params: { tab: "migration" }, class: "mt-3 w-full rounded-lg bg-gray-800 px-3 py-2 text-xs font-medium text-gray-100 hover:bg-gray-700" %>
      <%= form_with url: random_rotation_disable_all_position_path(position), method: :post, class: "mt-2 space-y-2" do |form| %>
        <%= form.hidden_field :tab, value: "migration" %>
        <%= form.text_field :random_rotation_confirmation, autocomplete: "off", placeholder: OperationalSettings::DISABLE_ALL_CONFIRMATION, class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-2 py-2 text-xs text-white placeholder-gray-600" %>
        <%= form.submit "Disable all auto/migration loops", class: "w-full rounded-lg bg-gray-800 px-3 py-2 text-xs font-medium text-gray-100 hover:bg-gray-700" %>
      <% end %>
    </div>
  </div>

  <details class="mt-4 rounded-lg border border-gray-800 bg-gray-950 p-3">
    <summary class="cursor-pointer text-xs font-medium uppercase tracking-wide text-gray-500">Advanced details</summary>
    <div class="mt-3 grid grid-cols-1 gap-2 text-xs md:grid-cols-2">
      <div><span class="text-gray-500">next_missing_proof_route</span><p class="text-white"><%= missing_proof_route[:from_venue].present? ? "#{HedgeVenues.label(missing_proof_route[:from_venue])} -> #{HedgeVenues.label(missing_proof_route[:to_venue])}" : "none" %></p></div>
      <div><span class="text-gray-500">next_executable_route</span><p class="text-white"><%= next_route[:from_venue].present? ? "#{HedgeVenues.label(next_route[:from_venue])} -> #{HedgeVenues.label(next_route[:to_venue])}" : "none" %></p></div>
      <div><span class="text-gray-500">source_reposition_required</span><p class="text-white"><%= setup[:source_reposition_required] ? "true" : "false" %></p></div>
      <div><span class="text-gray-500">source_reposition_route</span><p class="text-white"><%= reposition_route[:from_venue].present? ? "#{HedgeVenues.label(reposition_route[:from_venue])} -> #{HedgeVenues.label(reposition_route[:to_venue])}" : "none" %></p></div>
      <div><span class="text-gray-500">limited_diagnostics</span><p class="text-white"><%= setup[:limited_diagnostics] ? "true" : "false" %></p></div>
      <div><span class="text-gray-500">fallback_used</span><p class="text-white"><%= setup[:fallback_used] ? "true" : "false" %></p></div>
      <div class="md:col-span-2"><span class="text-gray-500">fallback_reason</span><p class="break-words text-white"><%= setup[:fallback_reason].presence || "none" %></p></div>
    </div>
    <div class="mt-3 overflow-x-auto">
      <table class="min-w-full text-left text-xs">
        <thead class="text-gray-500"><tr><th class="py-2 pr-3">Route</th><th class="py-2 pr-3">Status</th><th class="py-2 pr-3">Reason</th><th class="py-2 pr-3">Last proof</th></tr></thead>
        <tbody class="divide-y divide-gray-800 text-gray-300">
          <% Array(setup[:route_proof_statuses]).each do |route| %>
            <tr>
              <td class="py-2 pr-3 text-white"><%= HedgeVenues.label(route[:from_venue]) %> -> <%= HedgeVenues.label(route[:to_venue]) %></td>
              <td class="py-2 pr-3"><%= route[:status] %></td>
              <td class="py-2 pr-3"><%= Array(route[:blockers]).first.presence || route[:route_disabled_reason].presence || "none" %></td>
              <td class="py-2 pr-3"><%= route[:proof_timestamp].presence || "not recorded" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </details>
</div>
