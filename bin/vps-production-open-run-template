#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
if [ ! -f docker-compose.prod.yml ]; then
  echo "ERROR: docker-compose.prod.yml not found. Run this script from /opt/delta_neutral." >&2
  exit 1
fi

cat <<'TEXT'
AERODROME PRODUCTION LIVE RUN TEMPLATE — DO NOT RUN AUTOMATICALLY

This script prints a copy/paste template only.
It does not execute production_live_run.
Operator must fill placeholders, review gates, confirm mainnet ETH state, and paste manually inside tmux.
The web container stays running; this uses a one-off Docker Compose runner.

# DO NOT RUN UNTIL REVIEWED AND FILLED IN MANUALLY
docker compose -f docker-compose.prod.yml run --rm --no-deps \
  -e HYPERLIQUID_TESTNET=false \
  -e AERODROME_LIVE_APPROVED=true \
  -e AERODROME_HEDGE_ENABLED=true \
  -e AERODROME_HEDGE_PAUSED=false \
  -e AERODROME_PRODUCTION_LIVE_ENABLED=true \
  -e AERODROME_PRODUCTION_LIVE_CONFIRM=I_UNDERSTAND_THIS_RUNS_PRODUCTION_LIVE_HEDGE \
  -e AERODROME_PRODUCTION_LIVE_DURATION_SECONDS=<duration_seconds> \
  -e AERODROME_PRODUCTION_LIVE_INTERVAL_SECONDS=<interval_seconds> \
  -e AERODROME_PRODUCTION_LIVE_LEAVE_POSITION_OPEN=<true_or_false> \
  -e AERODROME_PRODUCTION_LIVE_CLOSE_ON_ERROR=true \
  -e AERODROME_PRODUCTION_LIVE_CLOSE_ON_SIGNAL=true \
  -e AERODROME_MAX_LEVERAGE=1 \
  -e AERODROME_MAX_SHORT_ETH=<max_eth_<=_0.02> \
  -e AERODROME_MAX_SHORT_NOTIONAL_USD=<max_notional_<=_50> \
  -e AERODROME_MIN_ORDER_NOTIONAL_USD=10 \
  -e AERODROME_LIVE_EMERGENCY_CLOSE_ENABLED=true \
  -e AERODROME_LIVE_EMERGENCY_CLOSE_CONFIRM=I_UNDERSTAND_THIS_CLOSES_LIVE_ETH_SHORT \
  -e AERODROME_LIVE_EMERGENCY_CLOSE_MAX_ETH=<max_close_eth_>=_max_eth> \
  web bin/rails aerodrome:production_live_run
TEXT
