#!/usr/bin/env bash
set -euo pipefail

cat <<'TEXT'
AERODROME PRODUCTION LIVE RUN TEMPLATE — DO NOT RUN AUTOMATICALLY

This script prints a copy/paste template only.
It does not execute production_live_run.
Operator must fill placeholders, review gates, confirm mainnet ETH state, and paste manually inside tmux.

# DO NOT RUN UNTIL REVIEWED AND FILLED IN MANUALLY
HYPERLIQUID_TESTNET=false \
AERODROME_LIVE_APPROVED=true \
AERODROME_HEDGE_ENABLED=true \
AERODROME_HEDGE_PAUSED=false \
AERODROME_PRODUCTION_LIVE_ENABLED=true \
AERODROME_PRODUCTION_LIVE_CONFIRM=I_UNDERSTAND_THIS_RUNS_PRODUCTION_LIVE_HEDGE \
AERODROME_PRODUCTION_LIVE_DURATION_SECONDS=<duration_seconds> \
AERODROME_PRODUCTION_LIVE_INTERVAL_SECONDS=<interval_seconds> \
AERODROME_PRODUCTION_LIVE_LEAVE_POSITION_OPEN=<true_or_false> \
AERODROME_PRODUCTION_LIVE_CLOSE_ON_ERROR=true \
AERODROME_PRODUCTION_LIVE_CLOSE_ON_SIGNAL=true \
AERODROME_MAX_LEVERAGE=1 \
AERODROME_MAX_SHORT_ETH=<max_eth_<=_0.02> \
AERODROME_MAX_SHORT_NOTIONAL_USD=<max_notional_<=_50> \
AERODROME_MIN_ORDER_NOTIONAL_USD=10 \
AERODROME_LIVE_EMERGENCY_CLOSE_ENABLED=true \
AERODROME_LIVE_EMERGENCY_CLOSE_CONFIRM=I_UNDERSTAND_THIS_CLOSES_LIVE_ETH_SHORT \
AERODROME_LIVE_EMERGENCY_CLOSE_MAX_ETH=<max_close_eth_>=_max_eth> \
bin/rails aerodrome:production_live_run
