#!/usr/bin/env bash
set -uo pipefail

cd "$(dirname "$0")/.."

compose_file="${COMPOSE_FILE:-docker-compose.prod.yml}"
if [ ! -f "$compose_file" ]; then
  echo "ERROR: ${compose_file} not found. Run this script from /opt/delta_neutral or set COMPOSE_FILE." >&2
  exit 1
fi

docker_rails() {
  docker compose -f "$compose_file" exec -T web bin/rails "$@"
}

failures=0

run_step() {
  local title="$1"
  shift
  echo
  echo "== ${title} =="
  if "$@"; then
    return 0
  fi

  failures=$((failures + 1))
  echo "WARN: ${title} exited nonzero; inspect output above."
}

echo "AERODROME VPS PRODUCTION STATUS — READ ONLY"
echo "NO ORDERS"
echo "NO CLOSE"
echo "NO HYPERLIQUID EXECUTION"

run_step "production_supervised_readiness" docker_rails aerodrome:production_supervised_readiness
run_step "production_live_status" docker_rails aerodrome:production_live_status
run_step "approved_open_position" docker_rails aerodrome:approved_open_position
run_step "watchdog_alerts" docker_rails aerodrome:watchdog_alerts
run_step "mainnet ETH readback" docker_rails runner 'require "json"; puts JSON.pretty_generate(mainnet_eth_position: HyperliquidService.new(testnet: false).get_position("ETH"))'

exit "$failures"
