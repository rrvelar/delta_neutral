#!/usr/bin/env bash
set -u

position_id="${1:?position_id required}"
term_wait_seconds="${TERM_WAIT_SECONDS:-10}"
pattern="ruby bin/rails migration:random_production_runner position_id=${position_id}"
pids=()

for cmdline in /proc/[0-9]*/cmdline; do
  [[ -r "$cmdline" ]] || continue
  pid="${cmdline%/cmdline}"
  pid="${pid##*/}"
  [[ "$pid" == "$$" || "$pid" == "$PPID" ]] && continue

  command="$(tr '\0' ' ' < "$cmdline" 2>/dev/null || true)"
  case "$command" in
    *"$pattern"*) pids+=("$pid") ;;
  esac
done

for pid in "${pids[@]}"; do
  kill -TERM "$pid" 2>/dev/null || true
done

if ((${#pids[@]} > 0)); then
  sleep "$term_wait_seconds"
fi

for pid in "${pids[@]}"; do
  if kill -0 "$pid" 2>/dev/null; then
    kill -KILL "$pid" 2>/dev/null || true
  fi
done

exit 0
